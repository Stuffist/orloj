#!/bin/sh
# Lu par le point d'entrée de l'image nginx avant le rendu des modèles (20-envsubst-on-templates.sh) :
# choisit le certificat servi en HTTPS et l'expose au modèle via SSL_CERT et SSL_KEY.
#  - Certificat Let's Encrypt de l'hôte s'il est monté (VPS) ;
#  - sinon certificat auto-signé généré dans le conteneur (poste local : le navigateur avertira).

live="/etc/letsencrypt/live/${DOMAIN}"
if [ -f "$live/fullchain.pem" ] && [ -f "$live/privkey.pem" ]; then
    export SSL_CERT="$live/fullchain.pem"
    export SSL_KEY="$live/privkey.pem"
else
    self=/etc/olomoc-selfsigned
    echo "olomoc: aucun certificat dans $live : certificat auto-signé (usage local uniquement)" >&2
    if [ ! -f "$self/cert.pem" ]; then
        mkdir -p "$self"
        openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
            -keyout "$self/key.pem" -out "$self/cert.pem" \
            -subj "/CN=${DOMAIN}" -addext "subjectAltName=DNS:${DOMAIN},DNS:localhost,IP:127.0.0.1" \
            2>/dev/null
    fi
    export SSL_CERT="$self/cert.pem"
    export SSL_KEY="$self/key.pem"
fi
