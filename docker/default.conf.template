# Service autonome de l'app Blazor WebAssembly (fichiers statiques), en HTTPS sur son propre port.
#  - ${DOMAIN} est remplacé au démarrage du conteneur (modèles /etc/nginx/templates de l'image nginx) ;
#  - __BASE_PATH__ est remplacé à la construction de l'image (ARG BASE_PATH du Dockerfile).
# Certificat : celui de l'hôte (Let's Encrypt, /etc/letsencrypt monté en lecture seule) ou,
# à défaut, un auto-signé pour l'usage local (voir 15-olomoc-cert.envsh).

# Les deux serveurs servent la même app : voir olomoc-app.conf.

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # Let's Encrypt de l'hôte, ou auto-signé en local : choisi par 15-olomoc-cert.envsh.
    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:olomoc_ssl:1m;

    # HTTP envoyé sur le port HTTPS (http://hôte:8443) : renvoi vers https, port public conservé.
    error_page 497 =301 https://$http_host$request_uri;

    include /etc/nginx/olomoc-app.conf;
}

# HTTP interne : healthcheck et diagnostic local (publié sur 127.0.0.1 seulement).
server {
    listen 80;
    server_name _;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    include /etc/nginx/olomoc-app.conf;
}
