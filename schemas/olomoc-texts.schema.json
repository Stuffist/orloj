{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://occicat.com/schemas/olomoc-texts.schema.json",
  "title": "Olomòc — text pack of a language",
  "description": "Card texts in a language (wwwroot/i18n/<language>/cards.json), indexed by the ids and codes of the neutral card catalog. The reference language pack (fr) is complete; the others can be partial: a missing text falls back to fr. The pictograms of the game effects are neutral tokens, rendered with the rulebook's icons.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "ISO 639-1 code of the language, identical to the folder name."
    },
    "ministries": {
      "type": "object",
      "description": "By Ministry code.",
      "additionalProperties": {
        "$ref": "#/$defs/named"
      }
    },
    "factions": {
      "type": "object",
      "description": "By faction code.",
      "additionalProperties": {
        "$ref": "#/$defs/named"
      }
    },
    "cogs": {
      "type": "object",
      "description": "By cog id.",
      "additionalProperties": {
        "$ref": "#/$defs/cog"
      }
    },
    "equipment": {
      "type": "object",
      "description": "By equipment/boon id.",
      "additionalProperties": {
        "$ref": "#/$defs/equipment"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "gameEffect": {
      "type": "string",
      "minLength": 1,
      "description": "Game effect. Pictograms as neutral tokens: {tech} {melee} {ranged} {dodge} {active} {permanent} {action} {darkness} {freq:game:N}, and {stunned} (stunned token). Any other brace is refused.",
      "pattern": "^([^{}]|\\{(tech|melee|ranged|dodge|active|permanent|action|darkness|stunned|freq:(planning|cycle|game):[1-9][0-9]?)\\})*$"
    },
    "named": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "ability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "gameEffect": {
          "$ref": "#/$defs/gameEffect"
        }
      }
    },
    "cog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "instinct": {
          "$ref": "#/$defs/text"
        },
        "abilities": {
          "type": "array",
          "description": "In the order of the abilities of the neutral card catalog.",
          "items": {
            "$ref": "#/$defs/ability"
          }
        }
      }
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "abilities": {
          "type": "array",
          "description": "In the order of the abilities of the neutral card catalog.",
          "items": {
            "$ref": "#/$defs/ability"
          }
        }
      }
    }
  }
}
