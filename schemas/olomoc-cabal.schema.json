{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://occicat.com/schemas/olomoc-cabal.schema.json",
  "title": "Olomòc — cabal export",
  "description": "Cabal exported by the builder: cogs in rank order, with their equipment/boon. Ids and codes refer to the card catalog (olomoc.schema.json, olomoc-factions.schema.json); names are given in the export's language, for human reading.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "language",
    "cogs"
  ],
  "properties": {
    "format": {
      "const": "olomoc-cabal"
    },
    "version": {
      "const": 1,
      "description": "Format version, increased on an incompatible change."
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "Language of the names (ISO 639-1 code)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the cabal, optional."
    },
    "faction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{2,32}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cogs": {
      "type": "array",
      "description": "Recruited cogs, in rank order (3 for a complete cabal).",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/slot"
      }
    }
  },
  "$defs": {
    "idName": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "cog"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "cog": {
          "$ref": "#/$defs/idName"
        },
        "equipment": {
          "$ref": "#/$defs/idName",
          "description": "Equipment/boon of the cog; missing if it is not equipped yet."
        }
      }
    }
  }
}
