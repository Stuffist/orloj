{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://occicat.com/schemas/olomoc-cabal.schema.json",
  "title": "Olomòc — export d'une cabale",
  "description": "Cabale exportée par le constructeur : rouages dans l'ordre des rangs, avec leur équipement/don. Les ids et codes renvoient au référentiel (olomoc.schema.json, olomoc-factions.schema.json) ; les noms sont donnés dans la langue de l'export, pour lecture humaine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "language",
    "cogs"
  ],
  "properties": {
    "format": {
      "const": "olomoc-cabal"
    },
    "version": {
      "const": 1,
      "description": "Version du format, incrémentée en cas de changement incompatible."
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "Langue des noms (code ISO 639-1)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Nom de la cabale, facultatif."
    },
    "faction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{2,32}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cogs": {
      "type": "array",
      "description": "Rouages recrutés, dans l'ordre des rangs (3 pour une cabale complète).",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/slot"
      }
    }
  },
  "$defs": {
    "idName": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "cog"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "cog": {
          "$ref": "#/$defs/idName"
        },
        "equipment": {
          "$ref": "#/$defs/idName",
          "description": "Équipement/don du rouage ; absent s'il n'est pas encore équipé."
        }
      }
    }
  }
}
