@page "/play"
@namespace OlomocListBuilder.Pages
@implements IDisposable
@inject CatalogService Catalog
@inject LocalizationService L
@inject GameStore Games
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (!_ready)
{
    <p class="loading">@(L.Loaded ? L.Ui("app.loading") : "…")</p>
}
else if (Games.Session is not { } game)
{
    <section class="play-empty">
        <p class="empty">@L.Ui("play.none")</p>
        <a class="btn" href="">@L.Ui("play.toBuilder")</a>
    </section>
}
else
{
    var s = game.State;
    <section class="play-bar">
        <div class="play-ident">
            <a class="play-back" href="" title="@L.Ui("play.toBuilder")">←</a>
            <div class="play-names">
                <span class="play-name">@(s.Name ?? L.Ui("play.unnamed"))</span>
                @if (s.Faction is { } f)
                {
                    <span class="play-faction">@L.FactionName(f)</span>
                }
            </div>
        </div>

        <div class="play-counters">
            <div class="counter">
                <span class="counter-label">@L.Ui("play.cycle")</span>
                <span class="counter-value">@Math.Min(s.Cycle, GameSession.Cycles)<small>/@GameSession.Cycles</small></span>
            </div>
            <div class="counter bile @(game.IsLost ? "lost" : null)">
                <span class="counter-label">@L.Ui("play.bile")</span>
                <span class="counter-track">
                    <button class="step" @onclick="() => Act(() => game.AdjustBile(-1))" disabled="@(s.Bile == 0)" aria-label="@L.Ui("play.bile") −">−</button>
                    <TokenTrack Token="darkness" Count="s.Bile" Max="GameSession.MaxBile" />
                    <button class="step" @onclick="() => Act(() => game.AdjustBile(1))" disabled="@(s.Bile >= GameSession.MaxBile)" aria-label="@L.Ui("play.bile") +">+</button>
                </span>
            </div>
        </div>

        <div class="play-commands">
            <button class="btn" @onclick="Undo" disabled="@(!game.CanUndo)" title="@L.Ui("play.undo.title")">↶ @L.Ui("play.undo")</button>
            @if (game.IsOver)
            {
                <span class="play-over @(game.IsLost ? "lost" : null)">@L.Ui(game.IsLost ? "play.lost" : "play.finished")</span>
            }
            else
            {
                <button class="btn primary" @onclick="EndCycle" title="@L.Ui("play.endCycle.title")">
                    @L.Ui(s.Cycle >= GameSession.Cycles ? "play.endGame" : "play.endCycle", s.Cycle)
                </button>
            }
        </div>
    </section>

    <section class="play-cogs">
        @for (var i = 0; i < s.Cogs.Count; i++)
        {
            var slot = i;
            var cs = s.Cogs[slot];
            if (Catalog.CogById(cs.CogId) is not { } cog) continue;
            <PlayCogCard Session="game" Slot="slot" Cog="cog" OnChanged="ChangedAsync" />
        }
    </section>

    <section class="play-footer">
        <button class="btn danger" @onclick="AbandonAsync">@L.Ui("play.abandon")</button>
    </section>

    @if (_toast is not null)
    {
        <div class="toast" role="status" aria-live="polite" @key="_toastId" @onclick="() => _toast = null">@_toast</div>
    }
}

@code {
    private bool _ready;
    // Notification : compte rendu de la dernière action, effacé après quelques secondes ou au toucher.
    private const int ToastMilliseconds = 5000;
    private string? _toast;
    private int _toastId;

    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnLanguageChanged;
        await L.EnsureLoadedAsync();
        await Catalog.EnsureLoadedAsync();
        await Games.EnsureLoadedAsync();
        // Partie sauvegardée avec des cartes disparues du référentiel : inutilisable.
        if (Games.Session is { } g && g.State.Cogs.Any(c => Catalog.CogById(c.CogId) is null))
            await Games.ClearAsync();
        _ready = true;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnLanguageChanged;

    private async Task ChangedAsync(string? message)
    {
        await Games.SaveAsync();
        Toast(message);
    }

    private Task Act(Action action)
    {
        action();
        return ChangedAsync(null);
    }

    private void Toast(string? message)
    {
        var id = ++_toastId;
        _toast = message;
        if (message is null) return;
        _ = Task.Delay(ToastMilliseconds).ContinueWith(_ => InvokeAsync(() =>
        {
            if (_toastId != id) return;
            _toast = null;
            StateHasChanged();
        }));
    }

    private Task Undo() => Act(() => Games.Session!.Undo());

    private async Task EndCycle()
    {
        var game = Games.Session!;
        var cycle = game.State.Cycle;
        var bile = game.EndCycle();
        await ChangedAsync(L.Ui("play.cycleEnded", cycle, bile) +
                           (game.IsLost ? " " + L.Ui("play.lost") : game.IsFinished ? " " + L.Ui("play.finished") : ""));
    }

    private async Task AbandonAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", L.Ui("play.abandon.confirm"))) return;
        await Games.ClearAsync();
        Nav.NavigateTo("");
    }
}
