@page "/"
@namespace OlomocListBuilder.Pages
@implements IDisposable
@inject CatalogService Catalog
@inject LocalizationService L
@inject CabalExporter Exporter
@inject IJSRuntime JS
@inject CabalDraft Draft
@inject GameStore Games
@inject NavigationManager Nav

@if (!Catalog.Loaded || !L.Loaded)
{
    <p class="loading">@(L.Loaded ? L.Ui("app.loading") : "…")</p>
}
else
{
    <section class="filters">
        <div class="field">
            <label>@L.Ui("filter.faction")</label>
            <select value="@_faction" @onchange="OnFactionChanged">
                <option value="">@L.Ui("filter.allFactions")</option>
                @foreach (var f in Catalog.AllFactions)
                {
                    <option value="@f.Code">@L.FactionName(f.Code)</option>
                }
            </select>
        </div>

        <div class="field">
            <label>@L.Ui("filter.ministry")</label>
            <select value="@_ministryFilter" @onchange="e => Set(ref _ministryFilter, e)">
                <option value="">@L.Ui("filter.allMinistries")</option>
                @foreach (var m in Catalog.Catalog.Ministries)
                {
                    <option value="@m.Code">@L.MinistryName(m.Code)</option>
                }
            </select>
        </div>

        <div class="field grow">
            <label>@L.Ui("filter.search")</label>
            <input type="text" placeholder="@L.Ui("search.placeholder")" value="@_search"
                   @oninput="OnSearch" />
            <div class="query-help">
                @foreach (var c in _query.Conditions)
                {
                    <span class="query-chip" title="@L.Ui("search.chipTitle")">
                        <span class="icon stat-icon @c.Icon" aria-hidden="true"></span>
                        @L.StatAbbr(c.Stat) @c.OpLabel @c.Value
                        <button class="chip-remove" @onclick="() => RemoveCondition(c)" title="@L.Ui("common.remove")">✕</button>
                    </span>
                }
                @if (_query.Conditions.Count == 0)
                {
                    <span class="hint">
                        @L.Ui("search.hintStats")
                        @foreach (var stat in Enum.GetValues<StatKind>())
                        {
                            <code>@L.StatAbbr(stat).ToLowerInvariant()</code>
                        }
                        @L.Ui("search.hintFollowedBy")
                        <code>&gt;</code> <code>&lt;</code> <code>&gt;=</code> <code>&lt;=</code> <code>=</code>
                        @L.Ui("search.hintTail")
                    </span>
                }
            </div>
        </div>
    </section>

    <section class="slots">
        @foreach (var rank in new[] { 3, 2, 1 })
        {
            var idx = RankIndex(rank);
            var cog = _cogs[idx];
            <div class="slot">
                <div class="slot-head">
                    <span class="rank-badge">@Stars(rank)</span>
                    <span class="rank-label">@L.Ui("slot.rank", rank)</span>
                    @if (cog is not null)
                    {
                        <button class="clear" @onclick="() => ClearCog(idx)" title="@L.Ui("common.remove")">✕</button>
                    }
                </div>

                @if (cog is null)
                {
                    <div class="picker">
                        @{ var options = Catalog.AvailableCogs(rank, NullIfEmpty(_faction), NullIfEmpty(_ministryFilter), _query); }
                        @if (options.Count == 0)
                        {
                            <p class="empty">@L.Ui("picker.empty")</p>
                        }
                        else
                        {
                            @foreach (var c in options)
                            {
                                var via = NullIfEmpty(_faction) is { } f ? Catalog.RecruitVia(c, f) : null;
                                <button class="cog-option" @onclick="() => SelectCog(idx, c)">
                                    <span class="cog-name">@Text(L.CogName(c))</span>
                                    <span class="cog-title">@Text(L.CogTitle(c))</span>
                                    <span class="cog-min">@string.Join(", ", c.Ministries.Select(m => L.MinistryName(m).Text))</span>
                                    <StatLine Stats="c.Stats" Compact="true" />
                                    @if (via is not null)
                                    {
                                        <span class="cog-via">@L.Ui("picker.recruitVia", L.EquipmentName(via))</span>
                                    }
                                </button>
                            }
                        }
                    </div>
                }
                else
                {
                    var current = _equipment[idx];
                    <div class="cog-card">
                        <div>
                            <div class="cog-name">@Text(L.CogName(cog))</div>
                            <div class="cog-title">@Text(L.CogTitle(cog))</div>
                        </div>
                        <StatLine Stats="cog.Stats" />
                        <div class="life-line">
                            @foreach (var hp in cog.LifeLine)
                            {
                                <span class="pip @hp.ToString().ToLower()" title="@L.Ui($"hp.{hp}")"></span>
                            }
                        </div>
                        <AbilityList Cog="cog" />

                        <div class="equipment-zone">
                            <label>@L.Ui("cog.equipment")</label>
                            @{ var available = Catalog.AvailableEquipment(idx, _cogs, _equipment, NullIfEmpty(_faction)); }
                            <select value="@current?.Id" @onchange="e => SelectEquipment(idx, e)">
                                <option value="">@L.Ui("common.choose")</option>
                                @foreach (var eq in available)
                                {
                                    <option value="@eq.Id">@L.EquipmentName(eq) · @AffiliationLabel(eq)</option>
                                }
                            </select>
                            @if (available.Count == 0)
                            {
                                <p class="empty">@L.Ui("cog.noEquipment")</p>
                            }
                            @if (current is not null)
                            {
                                <AbilityList Equipment="current" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="legality @(_legality.IsLegal ? "ok" : "ko")">
        <h2>@L.Ui(_legality.IsLegal ? "legality.legal" : "legality.illegal")</h2>
        @if (_legality.Issues.Count > 0)
        {
            <ul>
                @foreach (var issue in _legality.Issues)
                {
                    <li>@L.Describe(issue)</li>
                }
            </ul>
        }
    </section>

    <section class="play-launch">
        <h2>@L.Ui("play.launch.title")</h2>
        <p class="play-launch-intro">@L.Ui("play.launch.intro")</p>
        @if (_cogs.Any(c => c is null))
        {
            <p class="empty">@L.Ui("play.launch.incomplete")</p>
        }
        else if (!_legality.IsLegal)
        {
            <p class="export-warning">@L.Ui("play.launch.notLegal")</p>
        }
        <div class="play-launch-actions">
            <button class="btn primary" disabled="@_cogs.Any(c => c is null)" @onclick="StartGameAsync">@L.Ui("play.launch.start")</button>
            @if (Games.Session is { } game)
            {
                <a class="btn" href="play">@L.Ui("play.launch.resume", Math.Min(game.State.Cycle, GameSession.Cycles))</a>
            }
        </div>
    </section>

    <section class="export">
        <h2>@L.Ui("export.title")</h2>
        <div class="export-controls">
            <div class="field grow">
                <label for="cabal-name">@L.Ui("export.name")</label>
                <input id="cabal-name" type="text" maxlength="80" value="@_cabalName"
                       @oninput="e => _cabalName = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="export-modes" role="group" aria-label="@L.Ui("export.format")">
                <button class="@(_exportJson ? null : "active")" aria-pressed="@(!_exportJson)" @onclick="() => _exportJson = false">@L.Ui("export.text")</button>
                <button class="@(_exportJson ? "active" : null)" aria-pressed="@_exportJson" @onclick="() => _exportJson = true">JSON</button>
            </div>
        </div>

        @if (_cogs.All(c => c is null))
        {
            <p class="empty">@L.Ui("export.empty")</p>
        }
        else
        {
            var content = ExportContent();
            @if (!_legality.IsLegal)
            {
                <p class="export-warning">@L.Ui("export.notLegal")</p>
            }
            <textarea class="export-output" readonly rows="@Math.Min(content.Split('\n').Length, 18)"
                      value="@content" aria-label="@L.Ui("export.title")"></textarea>
            <div class="export-actions">
                <button class="btn" @onclick="() => CopyAsync(content)">
                    @L.Ui(_copied == content ? "export.copied" : "export.copy")
                </button>
                <a class="btn" href="@DataUri(content)" download="@CabalExporter.FileName(_cabalName, _exportJson ? "json" : "txt")">
                    @L.Ui("export.download")
                </a>
            </div>
        }
    </section>
}

@code {
    // Composition conservée par CabalDraft : on la retrouve en revenant du mode partie.
    private string _faction { get => Draft.Faction; set => Draft.Faction = value; }
    private string _ministryFilter = "";
    private string _search = "";
    private CogQuery _query = CogQuery.Empty;
    private IReadOnlyDictionary<string, StatKind> _keywords = new Dictionary<string, StatKind>();

    // index 0 => rang 1, index 1 => rang 2, index 2 => rang 3
    private Cog?[] _cogs => Draft.Cogs;
    private Equipment?[] _equipment => Draft.Equipment;
    private LegalityResult _legality = new(false, new[] { new LegalityIssue("start") });

    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnLanguageChanged;
        await L.EnsureLoadedAsync();
        await Catalog.EnsureLoadedAsync();
        await Games.EnsureLoadedAsync();
        _keywords = L.StatKeywords();
        Recompute();
    }

    // Les textes se résolvent au rendu : un changement de langue ne demande qu'un re-rendu.
    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnLanguageChanged;

    private static int RankIndex(int rank) => rank - 1;

    private void OnFactionChanged(ChangeEventArgs e)
    {
        _faction = e.Value?.ToString() ?? "";
        // Un rouage ou un équipement/don peut devenir invalide hors de la nouvelle faction : on purge.
        for (int i = 0; i < 3; i++) { _cogs[i] = null; _equipment[i] = null; }
        Recompute();
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _query = CogQuery.Parse(_search, _keywords);
    }

    private void RemoveCondition(StatCondition c)
    {
        _search = CogQuery.Without(_search, c);
        _query = CogQuery.Parse(_search, _keywords);
    }

    private void Set(ref string field, ChangeEventArgs e)
    {
        field = e.Value?.ToString() ?? "";
        Recompute();
    }

    private void SelectCog(int idx, Cog c)
    {
        _cogs[idx] = c;
        _equipment[idx] = null;             // les Ministères présents changent : on réévalue les équipements/dons
        PruneEquipment();
        Recompute();
    }

    private void ClearCog(int idx)
    {
        _cogs[idx] = null;
        _equipment[idx] = null;
        PruneEquipment();
        Recompute();
    }

    private void SelectEquipment(int idx, ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        _equipment[idx] = string.IsNullOrEmpty(id) ? null : Catalog.Catalog.Equipment.FirstOrDefault(x => x.Id == id);
        PruneEquipment();                   // retirer un Passe-droit peut invalider les autres équipements/dons
        Recompute();
    }

    // Retire les équipements/dons devenus indisponibles après un changement de rouage ou
    // d'équipement/don ; répété jusqu'à stabilité, un retrait pouvant en entraîner un autre.
    private void PruneEquipment()
    {
        bool changed;
        do
        {
            changed = false;
            for (int i = 0; i < 3; i++)
            {
                if (_cogs[i] is null || _equipment[i] is null) continue;
                var ok = Catalog.AvailableEquipment(i, _cogs, _equipment, NullIfEmpty(_faction)).Any(x => x.Id == _equipment[i]!.Id);
                if (!ok) { _equipment[i] = null; changed = true; }
            }
        } while (changed);
    }

    private void Recompute() => _legality = Catalog.CheckLegality(NullIfEmpty(_faction), _cogs, _equipment);

    // ---- Export ----

    private string _cabalName { get => Draft.Name; set => Draft.Name = value; }
    private bool _exportJson;
    private string? _copied;            // dernier contenu copié : le bouton l'indique tant qu'il est à jour

    private string ExportContent() => _exportJson
        ? Exporter.ToJson(_cabalName, NullIfEmpty(_faction), _cogs, _equipment)
        : Exporter.ToText(_cabalName, _cogs, _equipment);

    private string DataUri(string content) =>
        (_exportJson ? "data:application/json;charset=utf-8," : "data:text/plain;charset=utf-8,") + Uri.EscapeDataString(content);

    private async Task CopyAsync(string content)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", content);
            _copied = content;
        }
        catch (JSException)
        {
            // Presse-papiers indisponible (contexte non sécurisé, refus) : le texte reste sélectionnable.
            _copied = null;
        }
    }

    // ---- Mode partie ----

    private async Task StartGameAsync()
    {
        if (Games.Session is not null && !await JS.InvokeAsync<bool>("confirm", L.Ui("play.launch.replace"))) return;
        await Games.StartAsync(GameSession.NewGame(_cabalName, NullIfEmpty(_faction), _cogs, _equipment));
        Nav.NavigateTo("play");
    }

    private static string? NullIfEmpty(string s) => string.IsNullOrWhiteSpace(s) ? null : s;
    private static string Stars(int rank) => new string('★', rank);

    // Texte de carte, stylé s'il se replie sur la langue de référence faute de traduction.
    private RenderFragment Text(Localized text) => @<span class="@(text.IsFallback ? "untranslated" : null)"
                                                          title="@(text.IsFallback ? L.Ui("common.untranslated") : null)">@text.Text</span>;

    // « Don · L'Axe », « Équipement · Ligue Maisel », « Équipement · affilié au rouage »
    private string AffiliationLabel(Equipment e) =>
        L.Ui($"equipment.kind.{e.Kind}") + " · " +
        (e.IsFactionAffiliated ? L.FactionName(e.Faction!).Text :
         e.IsCogAffiliated ? L.Ui("equipment.cogAffiliated") :
         L.MinistryName(e.Ministry!).Text);
}
