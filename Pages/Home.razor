@page "/"
@namespace OlomocListBuilder.Pages
@inject CatalogService Catalog

@if (!Catalog.Loaded)
{
    <p class="loading">Chargement du référentiel…</p>
}
else
{
    <section class="filters">
        <div class="field">
            <label>Faction</label>
            <select value="@_faction" @onchange="OnFactionChanged">
                <option value="">— Toutes —</option>
                @foreach (var f in Catalog.AllFactions)
                {
                    <option value="@f.Code">@f.Name</option>
                }
            </select>
        </div>

        <div class="field">
            <label>Ministère</label>
            <select value="@_ministryFilter" @onchange="e => Set(ref _ministryFilter, e)">
                <option value="">— Tous —</option>
                @foreach (var m in Catalog.Catalog.Ministries)
                {
                    <option value="@m.Code">@m.Name</option>
                }
            </select>
        </div>

        <div class="field grow">
            <label>Recherche</label>
            <input type="text" placeholder="nom ou titre…" value="@_search"
                   @oninput="e => Set(ref _search, e)" />
        </div>
    </section>

    <section class="slots">
        @foreach (var rank in new[] { 3, 2, 1 })
        {
            var idx = RankIndex(rank);
            var cog = _cogs[idx];
            <div class="slot">
                <div class="slot-head">
                    <span class="rank-badge">@Stars(rank)</span>
                    <span class="rank-label">Rang @rank</span>
                    @if (cog is not null)
                    {
                        <button class="clear" @onclick="() => ClearCog(idx)" title="Retirer">✕</button>
                    }
                </div>

                @if (cog is null)
                {
                    <div class="picker">
                        @{ var options = Catalog.AvailableCogs(rank, NullIfEmpty(_faction), NullIfEmpty(_ministryFilter), NullIfEmpty(_search)); }
                        @if (options.Count == 0)
                        {
                            <p class="empty">Aucun rouage ne correspond.</p>
                        }
                        else
                        {
                            @foreach (var c in options)
                            {
                                <button class="cog-option" @onclick="() => SelectCog(idx, c)">
                                    <span class="cog-name">@c.Name</span>
                                    <span class="cog-title">@c.Title</span>
                                    <span class="cog-min">@string.Join(", ", c.Ministries.Select(Catalog.MinistryName))</span>
                                </button>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="cog-card">
                        <div class="cog-card-top">
                            <div>
                                <div class="cog-name">@cog.Name</div>
                                <div class="cog-title">@cog.Title</div>
                            </div>
                            <div class="stats">
                                <span title="Technique">@cog.Stats.Technique</span>
                                <span title="Corps-à-corps">@cog.Stats.Melee</span>
                                <span title="Tir">@cog.Stats.Ranged</span>
                                <span title="Esquive">@cog.Stats.Dodge</span>
                            </div>
                        </div>
                        <div class="health">
                            @foreach (var pip in cog.Health)
                            {
                                <span class="pip @pip.ToString().ToLower()" title="@PipTitle(pip)"></span>
                            }
                        </div>

                        <div class="gear-zone">
                            <label>Équipement / Don</label>
                            @{ var gears = Catalog.AvailableGears(cog, SelectedCogs(), NullIfEmpty(_faction)); }
                            <select value="@_gears[idx]?.Id" @onchange="e => SelectGear(idx, e)">
                                <option value="">— Choisir —</option>
                                @foreach (var g in gears)
                                {
                                    <option value="@g.Id">@g.Name @GearBadge(g)</option>
                                }
                            </select>
                            @if (gears.Count == 0)
                            {
                                <p class="empty">Aucun équipement disponible pour ce rouage.</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="legality @(_legality.IsLegal ? "ok" : "ko")">
        <h2>@(_legality.IsLegal ? "Cabale légale ✓" : "Cabale incomplète ou illégale")</h2>
        @if (_legality.Issues.Count > 0)
        {
            <ul>
                @foreach (var issue in _legality.Issues)
                {
                    <li>@issue</li>
                }
            </ul>
        }
    </section>
}

@code {
    private string _faction = "";
    private string _ministryFilter = "";
    private string _search = "";

    // index 0 => rang 1, index 1 => rang 2, index 2 => rang 3
    private readonly Cog?[] _cogs = new Cog?[3];
    private readonly Gear?[] _gears = new Gear?[3];
    private LegalityResult _legality = new(false, new[] { "Composez votre cabale." });

    protected override async Task OnInitializedAsync()
    {
        await Catalog.EnsureLoadedAsync();
        Recompute();
    }

    private static int RankIndex(int rank) => rank - 1;
    private IEnumerable<Cog> SelectedCogs() => _cogs.Where(c => c is not null).Cast<Cog>();

    private void OnFactionChanged(ChangeEventArgs e)
    {
        _faction = e.Value?.ToString() ?? "";
        // Un rouage/équipement peut devenir invalide hors de la nouvelle faction : on purge.
        for (int i = 0; i < 3; i++) { _cogs[i] = null; _gears[i] = null; }
        Recompute();
    }

    private void Set(ref string field, ChangeEventArgs e)
    {
        field = e.Value?.ToString() ?? "";
        Recompute();
    }

    private void SelectCog(int idx, Cog c)
    {
        _cogs[idx] = c;
        _gears[idx] = null;                 // l'union des ministères change : on réévalue les équipements
        PruneGears();
        Recompute();
    }

    private void ClearCog(int idx)
    {
        _cogs[idx] = null;
        _gears[idx] = null;
        PruneGears();
        Recompute();
    }

    private void SelectGear(int idx, ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        _gears[idx] = string.IsNullOrEmpty(id) ? null : Catalog.Catalog.Gears.FirstOrDefault(g => g.Id == id);
        Recompute();
    }

    // Retire les équipements devenus indisponibles après un changement de rouages.
    private void PruneGears()
    {
        for (int i = 0; i < 3; i++)
        {
            var cog = _cogs[i];
            if (cog is null || _gears[i] is null) continue;
            var ok = Catalog.AvailableGears(cog, SelectedCogs(), NullIfEmpty(_faction)).Any(g => g.Id == _gears[i]!.Id);
            if (!ok) _gears[i] = null;
        }
    }

    private void Recompute() => _legality = Catalog.CheckLegality(NullIfEmpty(_faction), _cogs, _gears);

    private static string? NullIfEmpty(string s) => string.IsNullOrWhiteSpace(s) ? null : s;
    private static string Stars(int rank) => new string('★', rank);
    private static string PipTitle(HealthPip p) => p switch
    {
        HealthPip.A => "Armuré (Protection)",
        HealthPip.T => "Teinté",
        _ => "Normal"
    };
    private string GearBadge(Gear g) =>
        g.IsFactionGear ? "· faction" :
        g.IsNamedGear ? "· nominatif" :
        g.IsMinistryGear ? $"· {Catalog.MinistryName(g.Ministry!)}" : "";
}
