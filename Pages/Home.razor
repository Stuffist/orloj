@page "/"
@namespace OlomocListBuilder.Pages
@inject CatalogService Catalog

@if (!Catalog.Loaded)
{
    <p class="loading">Chargement du référentiel…</p>
}
else
{
    <section class="filters">
        <div class="field">
            <label>Faction</label>
            <select value="@_faction" @onchange="OnFactionChanged">
                <option value="">— Toutes —</option>
                @foreach (var f in Catalog.AllFactions)
                {
                    <option value="@f.Code">@f.Name</option>
                }
            </select>
        </div>

        <div class="field">
            <label>Ministère</label>
            <select value="@_ministryFilter" @onchange="e => Set(ref _ministryFilter, e)">
                <option value="">— Tous —</option>
                @foreach (var m in Catalog.Catalog.Ministries)
                {
                    <option value="@m.Code">@m.Name</option>
                }
            </select>
        </div>

        <div class="field grow">
            <label>Recherche</label>
            <input type="text" placeholder="@SearchPlaceholder" value="@_search"
                   @oninput="OnSearch" />
            <div class="query-help">
                @foreach (var c in _query.Conditions)
                {
                    <span class="query-chip" title="Condition sur la caractéristique">
                        <span class="stat-icon @c.Icon" aria-hidden="true"></span>
                        @c.Abbr @c.OpLabel @c.Value
                        <button class="chip-remove" @onclick="() => RemoveCondition(c)" title="Retirer">✕</button>
                    </span>
                }
                @if (_query.Conditions.Count == 0)
                {
                    <span class="hint">Stats : <code>tec</code> <code>cbt</code> <code>tir</code> <code>esq</code>
                        suivis de <code>&gt;</code> <code>&lt;</code> <code>&gt;=</code> <code>&lt;=</code> <code>=</code> et d'un nombre, cumulables.</span>
                }
            </div>
        </div>
    </section>

    <section class="slots">
        @foreach (var rank in new[] { 3, 2, 1 })
        {
            var idx = RankIndex(rank);
            var cog = _cogs[idx];
            <div class="slot">
                <div class="slot-head">
                    <span class="rank-badge">@Stars(rank)</span>
                    <span class="rank-label">Rang @rank</span>
                    @if (cog is not null)
                    {
                        <button class="clear" @onclick="() => ClearCog(idx)" title="Retirer">✕</button>
                    }
                </div>

                @if (cog is null)
                {
                    <div class="picker">
                        @{ var options = Catalog.AvailableCogs(rank, NullIfEmpty(_faction), NullIfEmpty(_ministryFilter), _query); }
                        @if (options.Count == 0)
                        {
                            <p class="empty">Aucun rouage ne correspond.</p>
                        }
                        else
                        {
                            @foreach (var c in options)
                            {
                                var via = NullIfEmpty(_faction) is { } f ? Catalog.RecruitVia(c, f) : null;
                                <button class="cog-option" @onclick="() => SelectCog(idx, c)">
                                    <span class="cog-name">@c.Name</span>
                                    <span class="cog-title">@c.Title</span>
                                    <span class="cog-min">@string.Join(", ", c.Ministries.Select(Catalog.MinistryName))</span>
                                    <StatLine Stats="c.Stats" Compact="true" />
                                    @if (via is not null)
                                    {
                                        <span class="cog-via">Hors faction · via « @via.Name »</span>
                                    }
                                </button>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="cog-card">
                        <div>
                            <div class="cog-name">@cog.Name</div>
                            <div class="cog-title">@cog.Title</div>
                        </div>
                        <StatLine Stats="cog.Stats" />
                        <div class="life-line">
                            @foreach (var hp in cog.LifeLine)
                            {
                                <span class="pip @hp.ToString().ToLower()" title="@HealthPointLabel(hp)"></span>
                            }
                        </div>

                        <div class="equipment-zone">
                            <label>Équipement/don</label>
                            @{ var available = Catalog.AvailableEquipment(idx, _cogs, _equipment, NullIfEmpty(_faction)); }
                            <select value="@_equipment[idx]?.Id" @onchange="e => SelectEquipment(idx, e)">
                                <option value="">— Choisir —</option>
                                @foreach (var eq in available)
                                {
                                    <option value="@eq.Id">@eq.Name · @AffiliationLabel(eq)</option>
                                }
                            </select>
                            @if (available.Count == 0)
                            {
                                <p class="empty">Aucun équipement/don disponible pour ce rouage.</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="legality @(_legality.IsLegal ? "ok" : "ko")">
        <h2>@(_legality.IsLegal ? "Cabale légale ✓" : "Cabale incomplète ou illégale")</h2>
        @if (_legality.Issues.Count > 0)
        {
            <ul>
                @foreach (var issue in _legality.Issues)
                {
                    <li>@issue</li>
                }
            </ul>
        }
    </section>
}

@code {
    private string _faction = "";
    private string _ministryFilter = "";
    private string _search = "";
    private CogQuery _query = CogQuery.Empty;
    private const string SearchPlaceholder = "nom, titre, ou tir>4 esq<=3…";

    // index 0 => rang 1, index 1 => rang 2, index 2 => rang 3
    private readonly Cog?[] _cogs = new Cog?[3];
    private readonly Equipment?[] _equipment = new Equipment?[3];
    private LegalityResult _legality = new(false, new[] { "Composez votre cabale." });

    protected override async Task OnInitializedAsync()
    {
        await Catalog.EnsureLoadedAsync();
        Recompute();
    }

    private static int RankIndex(int rank) => rank - 1;

    private void OnFactionChanged(ChangeEventArgs e)
    {
        _faction = e.Value?.ToString() ?? "";
        // Un rouage ou un équipement/don peut devenir invalide hors de la nouvelle faction : on purge.
        for (int i = 0; i < 3; i++) { _cogs[i] = null; _equipment[i] = null; }
        Recompute();
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _query = CogQuery.Parse(_search);
    }

    private void RemoveCondition(StatCondition c)
    {
        _search = CogQuery.Without(_search, c);
        _query = CogQuery.Parse(_search);
    }

    private void Set(ref string field, ChangeEventArgs e)
    {
        field = e.Value?.ToString() ?? "";
        Recompute();
    }

    private void SelectCog(int idx, Cog c)
    {
        _cogs[idx] = c;
        _equipment[idx] = null;             // les Ministères présents changent : on réévalue les équipements/dons
        PruneEquipment();
        Recompute();
    }

    private void ClearCog(int idx)
    {
        _cogs[idx] = null;
        _equipment[idx] = null;
        PruneEquipment();
        Recompute();
    }

    private void SelectEquipment(int idx, ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        _equipment[idx] = string.IsNullOrEmpty(id) ? null : Catalog.Catalog.Equipment.FirstOrDefault(x => x.Id == id);
        PruneEquipment();                   // retirer un Passe-droit peut invalider les autres équipements/dons
        Recompute();
    }

    // Retire les équipements/dons devenus indisponibles après un changement de rouage ou
    // d'équipement/don ; répété jusqu'à stabilité, un retrait pouvant en entraîner un autre.
    private void PruneEquipment()
    {
        bool changed;
        do
        {
            changed = false;
            for (int i = 0; i < 3; i++)
            {
                if (_cogs[i] is null || _equipment[i] is null) continue;
                var ok = Catalog.AvailableEquipment(i, _cogs, _equipment, NullIfEmpty(_faction)).Any(x => x.Id == _equipment[i]!.Id);
                if (!ok) { _equipment[i] = null; changed = true; }
            }
        } while (changed);
    }

    private void Recompute() => _legality = Catalog.CheckLegality(NullIfEmpty(_faction), _cogs, _equipment);

    private static string? NullIfEmpty(string s) => string.IsNullOrWhiteSpace(s) ? null : s;
    private static string Stars(int rank) => new string('★', rank);
    private static string HealthPointLabel(HealthPointType hp) => hp switch
    {
        HealthPointType.R => "PV renforcé (Protection)",
        HealthPointType.T => "PV teinté",
        _ => "PV standard"
    };
    // « Don · L'Axe », « Équipement · Ligue Maisel », « Équipement · affilié au rouage »
    private string AffiliationLabel(Equipment e) =>
        (e.Kind == EquipmentKind.BOON ? "Don" : "Équipement") + " · " +
        (e.IsFactionAffiliated ? Catalog.FactionName(e.Faction!) :
         e.IsCogAffiliated ? "affilié au rouage" :
         Catalog.MinistryName(e.Ministry!));
}
