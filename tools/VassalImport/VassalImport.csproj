<Project Sdk="Microsoft.NET.Sdk">

  <!-- Imports the table's assets (boards, terrain, markers, tokens) from Occicat's Vassal module
       (.vmod) into src/Olomoc.Shared/wwwroot: img/table/ and data/olomoc-table.json. Run by hand
       when a new version of the module comes out (the module's path as argument, see the
       README); neither built with the site nor deployed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Olomoc.VassalImport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Olomoc.Shared\Olomoc.Shared.csproj" />
  </ItemGroup>

</Project>
