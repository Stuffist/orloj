@page "/bloc/{Code}"
@implements IDisposable
@inject LocalizationService L
@inject CatalogService Catalog
@inject AccountService Accounts
@inject ZoneApi Api
@inject MyZoneEntries Mine
@inject IJSRuntime JS

@* A zone: its description, its dominance, the entry of a game (anyone, while the zone is open), the
   games recorded (changed or deleted by their author, a manager or an admin) and the statistics. *@

@if (!_ready)
{
    <p class="loading">@(L.Loaded ? L.Ui("app.loading") : "…")</p>
}
else if (_zone is not { } z)
{
    <section class="panel">
        <Problems Items="_problems" />
        <a class="btn" href="bloc/">@L.Ui("zones.home")</a>
    </section>
}
else
{
    <section class="panel tn-head">
        <div class="tn-head-main">
            <h2 class="zn-title">
                @if (z.Logo is { } logo)
                {
                    <ZoneLogo Url="@logo" />
                }
                @z.Name
            </h2>
            <p class="tn-meta">
                <span>@L.Ui($"zones.kind.{z.Kind}")</span>
                @if (L.Period(z.StartDate, z.EndDate) is { Length: > 0 } period)
                {
                    <span> · @period</span>
                }
                <span> · @L.Ui("zones.games", z.Stats.Games)</span>
                <span> · @L.Ui($"zones.mode.{z.Mode}")</span>
            </p>
        </div>
        <div class="tn-head-side">
            <span class="tn-phase @ZoneText.StatusClass(z.Status)">@L.Ui($"zones.status.{z.Status}")</span>
            @if (z.Hidden)
            {
                <span class="tn-role">@L.Ui("zones.hidden")</span>
            }
        </div>
        @if (z.Description.Length > 0)
        {
            <p class="zn-description">@z.Description</p>
        }
        <div class="tn-head-tools">
            <DominanceLine Dominance="z.Dominance" Closed="@(z.Status == ZoneStatus.Closed)" />
        </div>
        <div class="tn-head-tools">
            <a class="btn small" href="bloc/">@L.Ui("zones.home")</a>
            @if (z.CanManage)
            {
                <a class="btn small" href="bloc/@z.Code/manage">@L.Ui("zones.manage")</a>
            }
        </div>
    </section>

    <section class="panel">
        @if (_editing is null && !_entering)
        {
            @if (CanEnter)
            {
                <button class="btn primary" @onclick="StartEntering">@L.Ui("zones.enter")</button>
                @if (z.Status != ZoneStatus.Open)
                {
                    <p class="hint">@L.Ui("zones.enter.asManager")</p>
                }
            }
            else
            {
                <p class="empty">@L.Ui(z.Status == ZoneStatus.Upcoming ? "zones.enter.upcoming" : "zones.enter.closed")</p>
            }
            @if (_notice is { } notice)
            {
                <p class="tn-legal" role="status">✓ @L.Ui(notice)</p>
            }
        }
        else
        {
            <h3>@L.Ui(_editing is null ? "zones.enter" : "zones.edit")</h3>
            <EncounterForm @key="_formKey" Zone="z" Existing="_editing?.Game" Submit="SaveAsync" OnCancel="CloseForm"
                           Format="_nextFormat" Date="_nextDate" Notice="@(_editing is null && _notice is { } n ? L.Ui(n) : null)" />
        }
    </section>

    <nav class="zn-tabs" aria-label="@L.Ui("zones.tabs")">
        <button type="button" class="btn @(_tab == Tab.Games ? "primary" : null)" aria-pressed="@(_tab == Tab.Games ? "true" : "false")"
                @onclick="() => _tab = Tab.Games">@L.Ui("zones.tab.games", _total)</button>
        <button type="button" class="btn @(_tab == Tab.Stats ? "primary" : null)" aria-pressed="@(_tab == Tab.Stats ? "true" : "false")"
                @onclick="() => _tab = Tab.Stats">@L.Ui("zones.tab.stats")</button>
    </nav>

    @if (_tab == Tab.Stats)
    {
        <section class="panel">
            <p class="hint">@L.Ui("zones.stats.method", StatsView.MinGames)</p>
        </section>
        @if (z.Stats.Games == 0)
        {
            <section class="panel"><p class="empty">@L.Ui("zones.noGames")</p></section>
        }
        else
        {
            <StatsSections Stats="z.Stats" Zones="true" />
        }
    }
    else
    {
        <section class="panel">
            <Problems Items="_listProblems" />
            @if (_games.Count == 0)
            {
                <p class="empty">@L.Ui("zones.noGames")</p>
            }
            <ul class="zn-games">
                @foreach (var g in _games)
                {
                    var game = g;
                    <li class="zn-game @(game.Id == _highlighted ? "new" : null)">
                        <div class="zn-game-meta">
                            <span>@ZoneText.Date(game.Game.PlayedOn)</span>
                            <span class="tn-role">@L.Ui($"zones.format.{game.Game.Format}")</span>
                            @if (game.Tournament is { } tournament)
                            {
                                @* Copied from a tournament bound to the zone: changed through the tournament only. *@
                                <span class="tn-role" title="@L.Ui("zones.fromTournament.title")">
                                    @if (game.TournamentName is { } name)
                                    {
                                        @L.Ui("zones.fromTournament") <a href="pairings/t/@tournament">@name</a>
                                    }
                                    else
                                    {
                                        @L.Ui("zones.fromTournament")
                                    }
                                </span>
                            }
                            @if (game.Game.Scenario is { } scenario)
                            {
                                <ScenarioTag Scenario="scenario" />
                            }
                            @if (game.Game.End is { } end)
                            {
                                <span class="hint">@L.Ui($"pairings.end.{end}")</span>
                            }
                            @if (CanEdit(game))
                            {
                                <span class="tn-mine-actions">
                                    <button class="btn small" @onclick="() => Edit(game)">@L.Ui("zones.edit.short")</button>
                                    <button class="btn small danger" @onclick="() => DeleteAsync(game)">@L.Ui("zones.delete")</button>
                                </span>
                            }
                        </div>
                        <div class="zn-game-sides">
                            @Side(game.Game, TableSide.A)
                            <span class="zn-score">@game.Game.A.Vp – @game.Game.B.Vp</span>
                            @Side(game.Game, TableSide.B)
                        </div>
                        @if (game.Game.Comment is { } comment)
                        {
                            <p class="zn-comment">@comment</p>
                        }
                        @* Photo (site setting): shown; added, replaced or removed by whoever can change the game. *@
                        @if (z.Photos)
                        {
                            var url = ZoneApi.PhotoUrl(z.Code, game.Id, _photoVersions.GetValueOrDefault(game.Id));
                            <div class="zn-photo-row">
                                @if (game.Photo)
                                {
                                    <a href="@url" target="_blank" rel="noopener"><img class="zn-photo" src="@url" loading="lazy" alt="@L.Ui("zones.photo.alt")" /></a>
                                }
                                @if (CanEdit(game) && game.Tournament is null)
                                {
                                    <label class="btn small @(_photoBusy == game.Id ? "disabled" : null)">
                                        @L.Ui(game.Photo ? "zones.photo.replace" : "zones.photo.add")
                                        <InputFile accept="image/*" disabled="@(_photoBusy is not null)" OnChange="e => UploadPhotoAsync(game, e)" />
                                    </label>
                                    @if (game.Photo)
                                    {
                                        <button class="btn small danger" disabled="@(_photoBusy is not null)" @onclick="() => DeletePhotoAsync(game)">@L.Ui("zones.photo.remove")</button>
                                    }
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
            @if (_next is not null)
            {
                <button class="btn" disabled="@_loadingMore" @onclick="MoreAsync">@L.Ui("zones.more")</button>
            }
        </section>
    }
}

@code {
    [Parameter] public string Code { get; set; } = "";

    private enum Tab { Games, Stats }

    private bool _ready, _entering, _loadingMore;
    private string? _notice;                 // "saved" message (text key)
    private long? _highlighted;              // game just saved
    private GameFormat _nextFormat = GameFormat.Duel;
    private DateOnly? _nextDate;
    private ZoneView? _zone;
    private IReadOnlyList<Problem>? _problems, _listProblems;
    private List<ZoneGameView> _games = new();
    private long? _next;
    private int _total;
    private ZoneGameView? _editing;
    private int _formKey;
    private Tab _tab = Tab.Games;

    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnChanged;
        await Task.WhenAll(L.EnsureLoadedAsync(), Catalog.EnsureLoadedAsync(), Mine.EnsureLoadedAsync(), Accounts.EnsureLoadedAsync());
        await LoadAsync();
        _ready = true;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnChanged;

    private bool CanEnter => _zone is { } z && (z.Status == ZoneStatus.Open || z.CanManage);

    // Through the account (server), or with this device's token while the zone is open.
    private bool CanEdit(ZoneGameView g) =>
        g.CanEdit || _zone?.Status == ZoneStatus.Open && Mine.TokenOf(Code, g.Id) is not null;

    private async Task LoadAsync()
    {
        var zone = await Api.GetAsync(Code);
        _zone = zone.Value;
        _problems = zone.Problems;
        if (_zone is null) return;
        await Mine.SeenAsync(_zone.Code, _zone.Name);         // in "My zones", even reached by its link (hidden zone)
        var page = await Api.GamesAsync(Code, null);
        _games = page.Value?.Games.ToList() ?? new();
        _next = page.Value?.Next;
        _total = page.Value?.Total ?? 0;
        _listProblems = page.Problems;
    }

    private async Task MoreAsync()
    {
        if (_next is not { } before) return;
        _loadingMore = true;
        var page = await Api.GamesAsync(Code, before);
        _games.AddRange(page.Value?.Games ?? []);
        _next = page.Value?.Next;
        _listProblems = page.Problems;
        _loadingMore = false;
    }

    private void Edit(ZoneGameView g)
    {
        _editing = g;
        _entering = false;
        _notice = null;
        _formKey++;
    }

    private void StartEntering()
    {
        _entering = true;
        _notice = null;
    }

    private void CloseForm()
    {
        _editing = null;
        _entering = false;
        _formKey++;
    }

    // Called by the form as a plain Func (not an EventCallback): Blazor does not redraw the page
    // afterwards, hence StateHasChanged. New game: confirmation, and a fresh form (same format and
    // date) for the next one;
    // change: form closed. Either way the game is highlighted in the list.
    // Photo of a new game (chosen in the form): sent once the game is recorded; refused (too large…),
    // the game stays recorded and the problem shows above the list.
    private async Task<IReadOnlyList<Problem>> SaveAsync(ZoneGame game, byte[]? photo)
    {
        if (_zone is not { } z) return [];
        IReadOnlyList<Problem>? photoProblems = null;
        if (_editing is { } editing)
        {
            var updated = await Api.UpdateGameAsync(z.Code, editing.Id, game, Mine.TokenOf(z.Code, editing.Id));
            if (!updated.Ok) return updated.Problems;
            _highlighted = editing.Id;
            _notice = "zones.edit.saved";
            CloseForm();
        }
        else
        {
            var created = await Api.AddGameAsync(z.Code, game);
            if (created.Value is not { } c) return created.Problems;
            await Mine.RememberAsync(z.Code, z.Name, c.Id, c.EditToken);
            if (photo is not null && z.Photos && !await SendPhotoAsync(z, c.Id, photo, c.EditToken)) photoProblems = _listProblems;
            _highlighted = c.Id;
            _notice = "zones.enter.saved";
            _nextFormat = game.Format;
            _nextDate = game.PlayedOn;
            _formKey++;
        }
        _tab = Tab.Games;
        await LoadAsync();
        if (photoProblems is { Count: > 0 }) _listProblems = photoProblems;
        StateHasChanged();
        return [];
    }

    private long? _photoBusy;                                   // game whose photo is being sent
    private readonly Dictionary<long, long> _photoVersions = new();     // photo sent: read again

    // The browser reduces the image (PhotoMaxSide, JPEG): lighter, without its location and other metadata.
    private async Task UploadPhotoAsync(ZoneGameView g, InputFileChangeEventArgs e)
    {
        if (_zone is not { } z || _photoBusy is not null) return;
        _photoBusy = g.Id;
        try
        {
            var (image, problem) = await ZonePhotoFile.ReadAsync(e.File);
            if (image is null)
            {
                _listProblems = [problem!];
                return;
            }
            if (await SendPhotoAsync(z, g.Id, image, Mine.TokenOf(z.Code, g.Id))) await LoadAsync();
        }
        finally { _photoBusy = null; }
    }

    // Photo sent (chosen in the list, or with the form of a new game): problems shown above the list.
    private async Task<bool> SendPhotoAsync(ZoneView z, long id, byte[] image, string? token)
    {
        var result = await Api.UploadPhotoAsync(z.Code, id, image, ZonePhotoFile.ContentType, token);
        _listProblems = result.Problems;
        if (result.Ok) _photoVersions[id] = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        return result.Ok;
    }

    private async Task DeletePhotoAsync(ZoneGameView g)
    {
        if (_zone is not { } z || !await JS.InvokeAsync<bool>("confirm", L.Ui("zones.photo.remove.confirm"))) return;
        var result = await Api.DeletePhotoAsync(z.Code, g.Id, Mine.TokenOf(z.Code, g.Id));
        _listProblems = result.Problems;
        if (result.Ok) await LoadAsync();
    }

    private async Task DeleteAsync(ZoneGameView g)
    {
        if (_zone is not { } z || !await JS.InvokeAsync<bool>("confirm", L.Ui("zones.delete.confirm"))) return;
        var result = await Api.DeleteGameAsync(z.Code, g.Id, Mine.TokenOf(z.Code, g.Id));
        _listProblems = result.Problems;
        if (!result.Ok) return;
        await Mine.ForgetEntryAsync(z.Code, g.Id);
        if (_editing?.Id == g.Id) CloseForm();
        await LoadAsync();
    }

    // A side: its players (faction, name, rank 3 cog of the cabal), winner highlighted, P1 marked.
    private RenderFragment Side(ZoneGame game, TableSide side) => __builder =>
    {
        var s = side == TableSide.A ? game.A : game.B;
        <div class="zn-game-side @(game.Winner == side ? "won" : null) @(side == TableSide.B ? "right" : null)">
            @foreach (var p in s.Players)
            {
                <div class="zn-game-player">
                    <FactionBadge Code="@p.Faction" />
                    @if (p.Name is { } name)
                    {
                        <span class="tn-player-name">@name</span>
                    }
                    @if (p.Cabal is { } cabal)
                    {
                        <details class="zn-cabal">
                            <summary>@(cabal.Name is { Length: > 0 } n ? n : L.Ui("zones.cabal"))</summary>
                            <CabalSummary Cabal="cabal" />
                        </details>
                    }
                </div>
            }
            @if (game.First == side)
            {
                <span class="tn-first-mark" title="@L.Ui("zones.form.first.title")">@L.Ui("pairings.result.first")</span>
            }
        </div>
    };
}
