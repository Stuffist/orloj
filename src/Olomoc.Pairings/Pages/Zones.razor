@page "/bloc"
@implements IDisposable
@inject LocalizationService L
@inject CatalogService Catalog
@inject AccountService Accounts
@inject ZoneApi Api
@inject MyZoneEntries Mine

@* The Block: the map of the zones, "My zones" (managed, or where this device entered
   games), then the list (open first, then upcoming, then closed, by year), with their dominance. *@

@if (!_ready)
{
    <p class="loading">@(L.Loaded ? L.Ui("app.loading") : "…")</p>
}
else
{
    <section class="panel">
        <h2>@L.Ui("zones.title")</h2>
        <p class="tn-intro">@L.Ui("zones.intro")</p>
        <div class="tn-actions">
            <a class="btn" href="stats/?source=bloc">@L.Ui("zones.stats.all")</a>
            @if (Accounts.Current is { CanEdit: true })
            {
                <a class="btn primary" href="bloc/new">@L.Ui("zones.create")</a>
            }
        </div>
        <Problems Items="_problems" />
    </section>

    <ZoneMap Zones="_zones" />

    @if (Accounts.Current is not { CanEdit: true } && _zones.Any(z => z.CanManage) || Mine.Zones.Count > 0)
    {
        <section class="panel">
            <h2>@L.Ui("zones.mine")</h2>
            <ul class="zn-list">
                @* Managed (for a zone admin, editor or admin: all of them, below), then seen on this device, most recent first. *@
                @if (Accounts.Current is not { CanEdit: true })
                {
                    @foreach (var z in _zones.Where(z => z.CanManage && !Mine.Knows(z.Code)))
                    {
                        @Card(z)
                    }
                }
                @foreach (var m in Mine.Zones)
                {
                    var mine = m;
                    @if (_zones.FirstOrDefault(z => string.Equals(z.Code, mine.Code, StringComparison.OrdinalIgnoreCase)) is { } z)
                    {
                        @Card(z, mine.Code)
                    }
                    else
                    {
                        @* Hidden zone reached by its link (or deleted): only its name. *@
                        <li class="zn-card">
                            <div class="zn-card-head">
                                <a class="tn-mine-name" href="bloc/@mine.Code">@mine.Name</a>
                                <button class="btn small danger tn-mine-actions" @onclick="() => Mine.ForgetZoneAsync(mine.Code)">@L.Ui("pairings.mine.forget")</button>
                            </div>
                        </li>
                    }
                }
            </ul>
        </section>
    }

    @foreach (var (key, zones) in Groups)
    {
        <section class="panel">
            <h2>@key</h2>
            <ul class="zn-list">
                @foreach (var z in zones)
                {
                    @Card(z)
                }
            </ul>
        </section>
    }

    @if (_zones.Count == 0 && _problems is not { Count: > 0 })
    {
        <section class="panel"><p class="empty">@L.Ui("zones.empty")</p></section>
    }
}

@code {
    private bool _ready;
    private List<ZoneSummary> _zones = new();
    private IReadOnlyList<Problem>? _problems;

    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnChanged;
        Accounts.Changed += OnChanged;
        await Task.WhenAll(L.EnsureLoadedAsync(), Catalog.EnsureLoadedAsync(), Mine.EnsureLoadedAsync(), Accounts.EnsureLoadedAsync());
        var result = await Api.ListAsync();
        _zones = result.Value ?? new();
        _problems = result.Problems;
        _ready = true;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.Changed -= OnChanged;
        Accounts.Changed -= OnChanged;
    }

    // Open, upcoming, then closed by year (of the end, or of the start), most recent first.
    private IEnumerable<(string Title, List<ZoneSummary> Zones)> Groups
    {
        get
        {
            var ordered = ZoneText.Ordered(_zones).ToList();       // same order as the map
            var open = ordered.Where(z => z.Status == ZoneStatus.Open).ToList();
            if (open.Count > 0) yield return (L.Ui("zones.group.open"), open);
            var upcoming = ordered.Where(z => z.Status == ZoneStatus.Upcoming).ToList();
            if (upcoming.Count > 0) yield return (L.Ui("zones.group.upcoming"), upcoming);
            foreach (var year in ordered.Where(z => z.Status == ZoneStatus.Closed).GroupBy(z => (z.EndDate ?? z.StartDate)?.Year)
                         .OrderByDescending(g => g.Key ?? 0))
                yield return (year.Key is { } y ? L.Ui("zones.group.closedIn", y) : L.Ui("zones.group.closed"), year.ToList());
        }
    }

    // A zone; "Forget" in "My zones" (<paramref name="forget"/>: its code).
    private RenderFragment Card(ZoneSummary z, string? forget = null) =>
        @<li class="zn-card">
            <div class="zn-card-head">
                @if (z.Logo is { } logo)
                {
                    <ZoneLogo Url="@logo" Class="small" />
                }
                <a class="tn-mine-name" href="bloc/@z.Code">@z.Name</a>
                <span class="tn-phase @ZoneText.StatusClass(z.Status)">@L.Ui($"zones.status.{z.Status}")</span>
                <span class="tn-role">@L.Ui($"zones.kind.{z.Kind}")</span>
                @if (z.Hidden)
                {
                    <span class="tn-role">@L.Ui("zones.hidden")</span>
                }
                <span class="tn-mine-actions">
                    @if (z.CanManage)
                    {
                        <a class="btn small" href="bloc/@z.Code/manage">@L.Ui("zones.manage")</a>
                    }
                    @if (forget is not null)
                    {
                        <button class="btn small danger" @onclick="() => Mine.ForgetZoneAsync(forget)">@L.Ui("pairings.mine.forget")</button>
                    }
                </span>
            </div>
            @if (ZoneText.Condensed(z.Description) is { Length: > 0 } description)
            {
                <p class="zn-card-description" title="@z.Description">@description</p>
            }
            <p class="tn-meta">
                @if (L.Period(z.StartDate, z.EndDate) is { Length: > 0 } period)
                {
                    <span>@period · </span>
                }
                <span>@L.Ui("zones.games", z.Games)</span>
            </p>
            <DominanceLine Dominance="z.Dominance" Closed="@(z.Status == ZoneStatus.Closed)" />
        </li>;
}
