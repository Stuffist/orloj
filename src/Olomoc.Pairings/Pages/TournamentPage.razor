@page "/pairings/t/{Code}"
@inherits TournamentPageBase

@if (!Ready)
{
    <p class="loading">@(L.Loaded ? L.Ui("app.loading") : "…")</p>
}
else if (View is not { } v)
{
    <section class="panel">
        <Problems Items="LoadProblems" />
        <a class="btn" href="pairings/">@L.Ui("pairings.home")</a>
    </section>
}
else
{
    var me = v.Player(v.MyPlayerId);
    <TournamentHeader View="v" Settings="@Settings(v)" Date="@DateLabel(v.Date)">
        <span class="tn-share">
            <code>@PublicLink</code>
            <button class="btn small" @onclick="() => CopyAsync(PublicLink)">@CopyLabel(PublicLink)</button>
        </span>
        @if (v.IsOrganizer)
        {
            <a class="btn small primary" href="pairings/t/@v.Code/admin">@L.Ui("pairings.admin.open")</a>
        }
    </TournamentHeader>

    @if (v.Phase == TournamentPhase.Registration)
    {
        <section class="panel">
            <h3>@L.Ui("pairings.register.title")</h3>
            @if (me is not null && !_editing)
            {
                <p class="tn-intro">@L.Ui("pairings.register.done")</p>
                <div class="tn-player-card">
                    <div><span class="tn-player-name">@me.Name</span> <FactionBadge Code="@me.Faction" /></div>
                    <div class="tn-cabals">
                        @for (var i = 0; i < (me.Cabals?.Count ?? 0); i++)
                        {
                            <CabalSummary Cabal="me.Cabals![i]" Title="@CabalTitle(i, me.Cabals![i])" />
                        }
                    </div>
                </div>
                <div class="tn-actions">
                    <button class="btn" @onclick="() => _editing = true">@L.Ui("pairings.register.edit")</button>
                    <button class="btn danger" @onclick="UnregisterAsync">@L.Ui("pairings.register.withdraw")</button>
                </div>
                <Problems Items="_problems" />
            }
            else
            {
                <p class="tn-intro">@L.Ui("pairings.register.intro", v.CabalsPerPlayer)</p>
                <RegistrationForm CabalCount="v.CabalsPerPlayer" TournamentCode="@v.Code" Existing="@(_editing ? me : null)" Submit="SubmitAsync"
                                  OnCancel="@(_editing ? EventCallback.Factory.Create(this, () => _editing = false) : default)" />
            }
        </section>
    }

    @* Programme : scénarios annoncés par l'organisateur. *@
    @if (v.Scenarios is { Count: > 0 } scenarios && scenarios.Any(s => s is not null))
    {
        <section class="panel">
            <h3>@L.Ui("pairings.scenarios.schedule")</h3>
            <ol class="tn-schedule">
                @for (var n = 1; n <= v.RoundCount; n++)
                {
                    var s = v.ScenarioOf(n);
                    <li class="@(v.LastRound?.Number == n ? "current" : null)">
                        <span class="tn-table-number">@L.Ui("pairings.roundN", n)</span>
                        <span>@(s is null ? L.Ui("pairings.scenarios.tbd") : L.ScenarioName(s))</span>
                        @if (s is not null && L.DecksLabel(s) is { } decks)
                        {
                            <span class="tn-decks">@decks</span>
                        }
                    </li>
                }
            </ol>
        </section>
    }

    @if (v.LastRound is { } round)
    {
        <section class="panel">
            <h3>@L.Ui("pairings.roundOf", round.Number, v.RoundCount)<ScenarioTag Scenario="v.ScenarioOf(round.Number)" /></h3>
            <RoundTables View="v" Round="round" />
            @* Sa table de la ronde en cours, contre un adversaire et sans résultat : partie en ligne. *@
            @if (v.Phase == TournamentPhase.Started && Entry?.PlayerToken is not null && v.MyPlayerId is { } myId
                 && round.Tables.FirstOrDefault(t => t.Involves(myId)) is { IsBye: false, HasResult: false } myTable)
            {
                <div class="tn-actions">
                    <button class="btn primary" type="button" disabled="@_opening" title="@L.Ui("pairings.online.play.title")"
                            @onclick="() => PlayOnlineAsync(round.Number, myTable.Number)">@L.Ui("pairings.online.play")</button>
                </div>
                <Problems Items="_onlineProblems" />
            }
            @if (v.Rounds.Count > 1)
            {
                <details class="tn-history">
                    <summary>@L.Ui("pairings.previousRounds")</summary>
                    @foreach (var previous in v.Rounds.Take(v.Rounds.Count - 1).Reverse())
                    {
                        <h4>@L.Ui("pairings.roundN", previous.Number)<ScenarioTag Scenario="v.ScenarioOf(previous.Number)" /></h4>
                        <RoundTables View="v" Round="previous" />
                    }
                </details>
            }
        </section>
        <section class="panel">
            <h3>@L.Ui("pairings.standings")</h3>
            <StandingsTable View="v" />
        </section>
    }

    <section class="panel">
        <h3>@L.Ui("pairings.players", v.Players.Count)</h3>
        <PlayerList View="v" />
    </section>
}

@code {
    private bool _editing;
    private bool _opening;
    private IReadOnlyList<Problem>? _onlineProblems;

    // Partie en ligne de sa table : ouverte (ou retrouvée) par le serveur, puis rejointe avec son jeton de joueur.
    private async Task PlayOnlineAsync(int round, int table)
    {
        if (Entry?.PlayerToken is not { } token) return;
        _opening = true;
        try
        {
            var result = await Api.OpenOnlineAsync(Code, round, table, token);
            _onlineProblems = result.Problems;
            if (result.Value is { } opened) Nav.NavigateTo($"online/g/{opened.Code}#{token}");
        }
        finally { _opening = false; }
    }

    private string CabalTitle(int i, CabalExport c) =>
        c.Name is { Length: > 0 } name ? $"{L.Ui("pairings.cabalN", i + 1)} — {name}" : L.Ui("pairings.cabalN", i + 1);
    private IReadOnlyList<Problem>? _problems;

    private async Task<IReadOnlyList<Problem>> SubmitAsync(RegistrationRequest request)
    {
        var v = View!;
        if (_editing && v.MyPlayerId is { } id)
        {
            var updated = await Api.UpdateRegistrationAsync(v.Code, id, request, Entry?.OrganizerToken, Entry?.PlayerToken);
            if (!updated.Ok) return updated.Problems;
            _editing = false;
        }
        else
        {
            var registered = await Api.RegisterAsync(v.Code, request);
            if (registered.Value is not { } r) return registered.Problems;
            await Mine.RememberAsync(v.Code, v.Name, playerId: r.PlayerId, playerToken: r.PlayerToken);
        }
        await RefreshAsync();
        StateHasChanged();                  // envoi depuis le formulaire (composant enfant) : la page change
        return Array.Empty<Problem>();
    }

    private async Task UnregisterAsync()
    {
        var v = View!;
        if (v.MyPlayerId is not { } id || !await ConfirmAsync(L.Ui("pairings.register.withdraw.confirm"))) return;
        var result = await Api.UnregisterAsync(v.Code, id, Entry?.OrganizerToken, Entry?.PlayerToken);
        _problems = result.Problems;
        if (!result.Ok) return;
        await Mine.ForgetPlayerAsync(v.Code);
        await RefreshAsync();
    }
}
