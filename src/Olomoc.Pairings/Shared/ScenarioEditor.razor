@* Scenarios of the rounds (organizer), planned in advance: agenda of the official collection, or
   custom scenario to name ("Other"); random draw of the agendas for the rounds not paired yet. *@
@inject LocalizationService L

<ol class="tn-scenarios">
    @for (var i = 0; i < View.RoundCount; i++)
    {
        var index = i;
        var row = _rows[index];
        <li>
            <label for="scenario-@(index + 1)" class="tn-table-number">@L.Ui("pairings.roundN", index + 1)</label>
            <select id="scenario-@(index + 1)" value="@row.Id" disabled="@ReadOnly" @onchange="e => Choose(index, e.Value?.ToString())">
                <option value="">@L.Ui("pairings.scenarios.none")</option>
                @foreach (var id in Agendas.All)
                {
                    <option value="@id">@L.Ui($"agenda.{id}")</option>
                }
                <option value="@Agendas.Other">@L.Ui("agenda.OTHER")</option>
            </select>
            @if (row.Id == Agendas.Other)
            {
                <input type="text" maxlength="@TournamentRules.MaxNameLength" value="@row.Name" disabled="@ReadOnly"
                       placeholder="@L.Ui("pairings.scenarios.otherName")" aria-label="@L.Ui("pairings.scenarios.otherName")"
                       @oninput="e => Rename(index, e.Value?.ToString())" />
            }
            <select class="tn-deck" value="@row.Artifact" disabled="@(ReadOnly || row.Id.Length == 0)" aria-label="@L.Ui("pairings.scenarios.artifact")"
                    title="@L.Ui("pairings.scenarios.artifact")" @onchange="e => SetArtifact(index, e.Value?.ToString())">
                <option value="">@L.Ui("pairings.scenarios.none")</option>
                @foreach (var id in Decks.Artifacts)
                {
                    <option value="@id">@L.Ui($"deck.artifact.{id}")</option>
                }
            </select>
            <select class="tn-deck" value="@row.Ministry" disabled="@(ReadOnly || row.Id.Length == 0)" aria-label="@L.Ui("pairings.scenarios.ministry")"
                    title="@L.Ui("pairings.scenarios.ministry")" @onchange="e => SetMinistry(index, e.Value?.ToString())">
                <option value="">@L.Ui("pairings.scenarios.none")</option>
                @foreach (var id in Decks.Ministries)
                {
                    <option value="@id">@L.Ui($"deck.ministry.{id}")</option>
                }
            </select>
        </li>
    }
</ol>
@if (!ReadOnly)
{
    <div class="tn-actions">
        <button class="btn" disabled="@(_busy || View.Rounds.Count >= View.RoundCount)" title="@L.Ui("pairings.scenarios.draw.title")" @onclick="Draw">
            @L.Ui("pairings.scenarios.draw")
        </button>
        <button class="btn primary" disabled="@(_busy || !_dirty || !Complete)" @onclick="SaveAsync">@L.Ui("pairings.scenarios.save")</button>
        @if (_dirty)
        {
            <span class="hint">@L.Ui("pairings.scenarios.unsaved")</span>
        }
    </div>
}
<Problems Items="_problems" />

@code {
    [Parameter, EditorRequired] public TournamentView View { get; set; } = default!;
    /// <summary>Save: returns the problems (none if accepted).</summary>
    [Parameter, EditorRequired] public Func<IReadOnlyList<Scenario?>, Task<IReadOnlyList<Problem>>> Save { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }

    // Empty strings: nothing chosen.
    private sealed record Row(string Id, string Name, string Artifact = "", string Ministry = "");

    private static Row RowOf(Scenario? s) => s is null ? new Row("", "") : new Row(s.Id, s.Name ?? "", s.Artifact ?? "", s.Ministry ?? "");

    private List<Row> _rows = new();
    private bool _dirty, _busy;
    private IReadOnlyList<Problem>? _problems;

    // Server values taken back as long as nothing is being changed (periodic refresh).
    protected override void OnParametersSet()
    {
        if (_dirty && _rows.Count == View.RoundCount) return;
        _rows = Enumerable.Range(1, View.RoundCount)
            .Select(n => RowOf(View.ScenarioOf(n)))
            .ToList();
    }

    // Custom scenario without a name: cannot be saved yet.
    private bool Complete => _rows.All(r => r.Id != Agendas.Other || r.Name.Trim().Length > 0);

    // No more agenda: no more decks either (they would not be saved).
    private void Choose(int index, string? id) => Edit(index, string.IsNullOrEmpty(id) ? new Row("", "") : _rows[index] with { Id = id });
    private void Rename(int index, string? name) => Edit(index, _rows[index] with { Name = name ?? "" });
    private void SetArtifact(int index, string? id) => Edit(index, _rows[index] with { Artifact = id ?? "" });
    private void SetMinistry(int index, string? id) => Edit(index, _rows[index] with { Ministry = id ?? "" });

    private void Edit(int index, Row row)
    {
        _rows[index] = row;
        _dirty = true;
        _problems = null;
    }

    private void Draw()
    {
        var drawn = Agendas.Draw(Current(), View.RoundCount, View.Rounds.Count, new Random());
        // Custom scenario: name kept (being typed), decks drawn.
        for (var i = View.Rounds.Count; i < View.RoundCount; i++)
            _rows[i] = _rows[i].Id == Agendas.Other ? RowOf(drawn[i]) with { Name = _rows[i].Name } : RowOf(drawn[i]);
        _dirty = true;
        _problems = null;
    }

    private List<Scenario?> Current() => _rows
        .Select(r => r.Id.Length == 0 ? null : new Scenario(r.Id, r.Id == Agendas.Other ? r.Name.Trim() : null,
            r.Artifact.Length == 0 ? null : r.Artifact, r.Ministry.Length == 0 ? null : r.Ministry))
        .ToList();

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            _problems = await Save(Current());
            if (_problems.Count == 0) _dirty = false;
        }
        finally { _busy = false; }
    }
}
