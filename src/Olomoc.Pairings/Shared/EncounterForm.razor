@* Entry (or change) of a game in a zone: duel or 2 v 2 (a Light team against a Darkness team), date,
   for each player a faction, the cabal played and optionally a name (never counted); VP of each
   side; for the statistics, required too: the side that played first, the scenario and its two
   decks, the end of the game (required fields marked with an asterisk). Optional: a comment (a
   notable event), and a photo when the site allows them (new game: sent once it is recorded).
   All the fields shown at once: format and date, scenario and decks, then each side (its VP and
   P1/P2 first; faction list with the logos), the end of the game, the comment and the photo.
   Typing a name suggests account names; an account's name offers its public cabals. *@
@inject LocalizationService L
@inject CatalogService Catalog
@inject CabalLibrary Library
@inject AccountDirectory Directory
@inject IJSRuntime JS
@implements IAsyncDisposable

<form class="tn-form zn-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
    <div class="tn-fields">
        <fieldset class="tn-modes zn-format">
            <legend>@L.Ui("zones.form.format")</legend>
            <label>
                <input type="radio" name="zn-format" checked="@(_format == GameFormat.Duel)" @onchange="() => SetFormat(GameFormat.Duel)" />
                <span>@L.Ui("zones.format.Duel")</span>
            </label>
            <label>
                <input type="radio" name="zn-format" checked="@(_format == GameFormat.Teams)" @onchange="() => SetFormat(GameFormat.Teams)" />
                <span>@L.Ui("zones.format.Teams") — <span class="hint">@L.Ui("zones.format.Teams.help")</span></span>
            </label>
        </fieldset>
        <div class="field">
            <label for="zn-date">@L.Ui("zones.form.date")<span class="req" aria-hidden="true">*</span></label>
            <input id="zn-date" type="date" value="@_date.ToString("yyyy-MM-dd")" min="@Zone.StartDate?.ToString("yyyy-MM-dd")"
                   max="@MaxDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" />
        </div>
    </div>

    @* The scenario and its two decks (required, for the statistics): before the sides. *@
    <div class="tn-fields zn-scenario">
        <div class="field">
            <label for="zn-scenario">@L.Ui("zones.form.scenario")<span class="req" aria-hidden="true">*</span></label>
            <select id="zn-scenario" value="@_scenario" required @onchange="e => Set(ref _scenario, e)">
                <option value="">@L.Ui("common.choose")</option>
                @foreach (var id in Agendas.All)
                {
                    <option value="@id">@L.Ui($"agenda.{id}")</option>
                }
                <option value="@Agendas.Other">@L.Ui("agenda.OTHER")</option>
            </select>
        </div>
        @if (_scenario == Agendas.Other)
        {
            <div class="field grow">
                <label for="zn-scenario-name">@L.Ui("pairings.scenarios.otherName")<span class="req" aria-hidden="true">*</span></label>
                <input id="zn-scenario-name" type="text" maxlength="@TournamentRules.MaxNameLength" value="@_scenarioName" required
                       @oninput="e => _scenarioName = e.Value?.ToString() ?? string.Empty" />
            </div>
        }
        <div class="field">
            <label for="zn-artifact">@L.Ui("pairings.scenarios.artifact")<span class="req" aria-hidden="true">*</span></label>
            <select id="zn-artifact" value="@_artifact" required @onchange="e => Set(ref _artifact, e)">
                <option value="">@L.Ui("common.choose")</option>
                @foreach (var id in Decks.Artifacts)
                {
                    <option value="@id">@L.Ui($"deck.artifact.{id}")</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="zn-ministry">@L.Ui("pairings.scenarios.ministry")<span class="req" aria-hidden="true">*</span></label>
            <select id="zn-ministry" value="@_ministry" required @onchange="e => Set(ref _ministry, e)">
                <option value="">@L.Ui("common.choose")</option>
                @foreach (var id in Decks.Ministries)
                {
                    <option value="@id">@L.Ui($"deck.ministry.{id}")</option>
                }
            </select>
        </div>
    </div>

    <div class="zn-sides">
        @foreach (var side in new[] { TableSide.A, TableSide.B })
        {
            var s = side;
            <fieldset class="zn-side">
                <legend>@L.Ui("zones.form.side", s == TableSide.A ? 1 : 2)</legend>
                @* VP and turn order first: P1 on one side makes the other P2. *@
                <div class="zn-side-result">
                    <div class="field">
                        <label for="zn-vp-@s">@L.Ui("zones.form.vp")<span class="req" aria-hidden="true">*</span></label>
                        <input id="zn-vp-@s" type="number" min="0" max="@TournamentRules.MaxVictoryPoints" inputmode="numeric" required
                               value="@(s == TableSide.A ? _vpA : _vpB)" @oninput="e => SetVp(s, e.Value?.ToString())" />
                    </div>
                    <div class="field zn-order">
                        <span class="zn-order-label" id="zn-order-@s">@L.Ui("zones.form.order")<span class="req" aria-hidden="true">*</span></span>
                        <div class="zn-order-buttons" role="group" aria-labelledby="zn-order-@s">
                            <button type="button" class="tn-first @(_first == s ? "on" : null)" aria-pressed="@(_first == s ? "true" : "false")"
                                    title="@L.Ui("zones.form.first.title")" @onclick="() => SetFirst(s)">@L.Ui("pairings.result.first")</button>
                            <button type="button" class="tn-first @(_first == Other(s) ? "on" : null)" aria-pressed="@(_first == Other(s) ? "true" : "false")"
                                    title="@L.Ui("zones.form.second.title")" @onclick="() => SetFirst(Other(s))">@L.Ui("zones.form.second")</button>
                        </div>
                    </div>
                </div>
                @for (var k = 0; k < PerSide; k++)
                {
                    var index = Slot(s, k);
                    var player = _players[index];
                    <div class="zn-player">
                        <div class="tn-fields">
                            <div class="field">
                                <label for="zn-faction-@index">@L.Ui("filter.faction")<span class="req" aria-hidden="true">*</span></label>
                                @* Logos in front of the factions (open list: where the browser allows it, see .emblem-select). *@
                                <div class="with-emblem">
                                    <Emblem Faction="@player.Faction" />
                                    <select id="zn-faction-@index" class="emblem-select" value="@player.Faction" required
                                            @onchange="e => SetFaction(index, e.Value?.ToString())">
                                        <option value="">@L.Ui("common.choose")</option>
                                        @foreach (var f in FactionsFor(s, index))
                                        {
                                            <option value="@f.Code"><Emblem Faction="@f.Code" />@L.FactionName(f.Code)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="field grow">
                                <label for="zn-name-@index">@L.Ui("zones.form.name")</label>
                                @* Account names suggested as the name is typed (datalist). *@
                                <input id="zn-name-@index" type="text" maxlength="@ZoneRules.MaxNameLength" value="@player.Name"
                                       placeholder="@L.Ui("zones.form.name.placeholder")" autocomplete="off" list="zn-names-@index"
                                       @oninput="e => OnNameInputAsync(index, e.Value?.ToString())" />
                                <datalist id="zn-names-@index">
                                    @foreach (var suggestion in player.Suggestions)
                                    {
                                        <option value="@suggestion"></option>
                                    }
                                </datalist>
                            </div>
                        </div>
                        <CabalPicker Index="index" Faction="@player.Faction" Value="player.Cabal" ValueChanged="c => SetCabal(index, c)"
                                     LibraryVersion="_libraryVersion" Title="@L.Ui("zones.form.cabal", index + 1)" Required="true" />
                        @* The name is an account's: its public cabals (of the faction chosen), one click away. *@
                        @if (player.Account is { } account && player.AccountCabals is { } offered)
                        {
                            var matching = offered.Where(c => player.Faction.Length == 0 || c.Faction?.Code == player.Faction).ToList();
                            <div class="zn-account-cabals">
                                <span class="hint">@L.Ui(matching.Count > 0 ? "zones.form.accountCabals" : "zones.form.accountCabals.none", account)</span>
                                @foreach (var c in matching)
                                {
                                    var cabal = c;
                                    var chosen = player.Cabal is { } current && CabalLibrary.SameCards(current, cabal);
                                    <button type="button" class="btn small @(chosen ? "primary" : null)" aria-pressed="@(chosen ? "true" : "false")"
                                            @onclick="() => SetCabal(index, cabal)">
                                        @if (cabal.Faction is { } f)
                                        {
                                            <Emblem Faction="@f.Code" />
                                        }
                                        @cabal.Name
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </fieldset>
        }
    </div>

    <div class="tn-result-end zn-end" role="group" aria-label="@L.Ui("zones.form.end.title")">
        <span class="tn-result-end-label">@L.Ui("pairings.result.end")<span class="req" aria-hidden="true">*</span></span>
        @foreach (var end in Enum.GetValues<GameEnd>())
        {
            var e = end;
            <button type="button" class="@(_end == e ? "on" : null)" aria-pressed="@(_end == e ? "true" : "false")"
                    @onclick="() => SetEnd(e)">@L.Ui($"pairings.end.{e}")</button>
        }
    </div>
    <div class="zn-comment-row">
        <div class="field grow">
            <label for="zn-comment">@L.Ui("zones.form.comment")</label>
            <textarea id="zn-comment" class="zn-textarea" rows="3" maxlength="@ZoneRules.MaxCommentLength"
                      placeholder="@L.Ui("zones.form.comment.placeholder")" @oninput="e => _comment = e.Value?.ToString() ?? string.Empty">@_comment</textarea>
        </div>
        @* Photo (site setting), new game only: reduced at once by the browser, sent with the game.
           A recorded game's photo is changed from the list. *@
        @if (Zone.Photos && Existing is null)
        {
            <div class="zn-form-photo">
                @if (_photo is not null)
                {
                    <img class="zn-photo" src="@_photoPreview" alt="@L.Ui("zones.photo.alt")" />
                }
                <div class="zn-photo-row">
                    <label class="btn @(_busy ? "disabled" : null)">
                        @L.Ui(_photo is null ? "zones.photo.add" : "zones.photo.replace")
                        <InputFile accept="image/*" disabled="@_busy" OnChange="ChoosePhotoAsync" />
                    </label>
                    @if (_photo is not null)
                    {
                        <button type="button" class="btn small danger" disabled="@_busy" @onclick="RemovePhoto">@L.Ui("zones.photo.remove")</button>
                    }
                </div>
            </div>
        }
    </div>
    <p class="hint">@L.Ui("zones.form.required")</p>

    <Problems Items="_problems" />
    <div class="tn-actions">
        <button class="btn primary" type="submit" disabled="@_busy">@L.Ui(Existing is null ? "zones.form.submit" : "zones.form.save")</button>
        @if (OnCancel.HasDelegate)
        {
            <button class="btn" type="button" @onclick="OnCancel">@L.Ui("pairings.cancel")</button>
        }
        @if (Notice is not null)
        {
            <span class="tn-legal zn-notice" role="status">✓ @Notice</span>
        }
    </div>
</form>

@code {
    [Parameter, EditorRequired] public ZoneView Zone { get; set; } = default!;
    /// <summary>Game being changed (null: new game).</summary>
    [Parameter] public ZoneGame? Existing { get; set; }
    /// <summary>Submit (the game, and the photo chosen for a new one): returns the problems (none if the game is accepted).</summary>
    [Parameter, EditorRequired] public Func<ZoneGame, byte[]?, Task<IReadOnlyList<Problem>>> Submit { get; set; } = default!;
    [Parameter] public EventCallback OnCancel { get; set; }
    /// <summary>New game: format and date proposed (those of the previous one).</summary>
    [Parameter] public GameFormat Format { get; set; }
    [Parameter] public DateOnly? Date { get; set; }
    /// <summary>Message next to the buttons ("Encounter recorded…").</summary>
    [Parameter] public string? Notice { get; set; }

    private sealed class PlayerRow
    {
        public string Faction = "";
        public string Name = "";
        public CabalExport? Cabal;
        // Account names suggested for the name typed; the account it names, and its public cabals.
        public IReadOnlyList<string> Suggestions = [];
        public string? Account;
        public IReadOnlyList<CabalExport>? AccountCabals;
        public int Search;                    // a slower answer to a previous search is ignored
    }

    // Name typed: account names suggested (after a short pause); an account's exact name: its public cabals.
    private async Task OnNameInputAsync(int index, string? value)
    {
        var player = _players[index];
        player.Name = value ?? "";
        var search = ++player.Search;
        await Task.Delay(250);
        if (search != player.Search) return;
        var names = await Directory.SearchAsync(player.Name);
        if (search != player.Search) return;
        player.Suggestions = names;
        player.Account = names.FirstOrDefault(n => string.Equals(n, player.Name.Trim(), StringComparison.OrdinalIgnoreCase));
        player.AccountCabals = player.Account is { } account ? await Directory.PublicCabalsAsync(account) : null;
        if (search != player.Search) return;
        StateHasChanged();
    }

    private GameFormat _format = GameFormat.Duel;
    private DateOnly _date;
    // Players: A1, A2, B1, B2 (A2 and B2 only in 2 v 2).
    private readonly PlayerRow[] _players = Enumerable.Range(0, 4).Select(_ => new PlayerRow()).ToArray();
    private string _vpA = "", _vpB = "";
    private TableSide? _first;
    private GameEnd? _end;
    private string _scenario = "", _scenarioName = "", _artifact = "", _ministry = "", _comment = "";
    private bool _busy;
    private IReadOnlyList<Problem>? _problems;
    // Photo chosen (already reduced), and its preview.
    private byte[]? _photo;
    private string? _photoPreview;

    private async Task ChoosePhotoAsync(InputFileChangeEventArgs e)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var (image, problem) = await ZonePhotoFile.ReadAsync(e.File);
            _problems = problem is null ? null : [problem];
            if (image is null) return;
            _photo = image;
            _photoPreview = $"data:{ZonePhotoFile.ContentType};base64,{Convert.ToBase64String(image)}";
        }
        finally { _busy = false; }
    }

    private void RemovePhoto()
    {
        _photo = null;
        _photoPreview = null;
    }

    private int PerSide => ZoneRules.PlayersPerSide(_format);

    // Number of a player in the problems ("Cabal n") and the fields: A1 = 0, A2 = 1, B1 = 2, B2 = 3 in
    // 2 v 2; A = 0, B = 1 in a duel (the order of ZoneGame.Players).
    private int Slot(TableSide side, int k) => side == TableSide.A ? k : PerSide + k;

    private DateOnly Today => DateOnly.FromDateTime(DateTime.Now);
    private DateOnly MaxDate => Zone.EndDate is { } end && end < Today ? end : Today;

    protected override void OnInitialized()
    {
        _format = Format;
        _date = Date is { } d && d <= MaxDate ? d : MaxDate;
        if (Existing is not { } g) return;
        _format = g.Format;
        _date = g.PlayedOn;
        var players = g.Players.ToList();
        for (var i = 0; i < players.Count && i < 4; i++)
        {
            _players[i].Faction = players[i].Faction;
            _players[i].Name = players[i].Name ?? "";
            _players[i].Cabal = players[i].Cabal;
        }
        _vpA = g.A.Vp.ToString();
        _vpB = g.B.Vp.ToString();
        _first = g.First;
        _end = g.End;
        _comment = g.Comment ?? "";
        if (g.Scenario is { } s)
        {
            _scenario = s.Id;
            _scenarioName = s.Name ?? "";
            _artifact = s.Artifact ?? "";
            _ministry = s.Ministry ?? "";
        }
    }

    // Duel ↔ 2 v 2: the first player of each side keeps their place.
    private void SetFormat(GameFormat format)
    {
        if (format == _format) return;
        var a = _players[0];
        var b = _players[Slot(TableSide.B, 0)];
        _format = format;
        var rows = Enumerable.Range(0, 4).Select(_ => new PlayerRow()).ToArray();
        rows[0] = a;
        rows[Slot(TableSide.B, 0)] = b;
        for (var i = 0; i < 4; i++) _players[i] = rows[i];
        _problems = null;
    }

    // In 2 v 2: the factions of the alignment chosen in the team, opposed to the other team's.
    private IEnumerable<Faction> FactionsFor(TableSide side, int index)
    {
        var all = Catalog.AllFactions.OrderBy(f => L.FactionName(f.Code).Text);
        if (_format != GameFormat.Teams) return all;
        var mate = Catalog.AlignmentOf(_players[side == TableSide.A ? 1 - index : 5 - index].Faction);
        var other = TeamAlignment(side == TableSide.A ? TableSide.B : TableSide.A);
        return all.Where(f => (mate is null || f.Alignment == mate) && (other is null || f.Alignment != other) || f.Code == _players[index].Faction);
    }

    private Alignment? TeamAlignment(TableSide side) =>
        Enumerable.Range(0, PerSide).Select(k => Catalog.AlignmentOf(_players[Slot(side, k)].Faction)).FirstOrDefault(a => a is not null);

    private void SetFaction(int index, string? faction)
    {
        _players[index].Faction = faction ?? "";
        _problems = null;
    }

    private void SetCabal(int index, CabalExport? cabal)
    {
        var player = _players[index];
        player.Cabal = cabal;
        // Cabal chosen first: its faction becomes the player's.
        if (player.Faction.Length == 0 && cabal?.Faction is { } f) player.Faction = f.Code;
        _problems = null;
    }

    private void SetVp(TableSide side, string? value)
    {
        if (side == TableSide.A) _vpA = value ?? "";
        else _vpB = value ?? "";
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d)) _date = d;
    }

    // P1 on one side: the other side is P2 (and the other way round).
    private void SetFirst(TableSide side)
    {
        _first = side;
        _problems = null;
    }

    private static TableSide Other(TableSide side) => side == TableSide.A ? TableSide.B : TableSide.A;

    private void SetEnd(GameEnd end)
    {
        _end = _end == end ? null : end;
        _problems = null;
    }

    private void Set(ref string field, ChangeEventArgs e)
    {
        field = e.Value?.ToString() ?? string.Empty;
        _problems = null;
    }

    private static int? Parse(string s) => int.TryParse(s, out var n) ? n : null;

    private ZoneGame Build()
    {
        ZoneSide Side(TableSide s, string vp) => new(Enumerable.Range(0, PerSide).Select(k => _players[Slot(s, k)])
            .Select(p => new ZonePlayer(p.Faction, p.Name.Trim() is { Length: > 0 } n ? n : null, p.Cabal)).ToList(), Parse(vp) ?? 0);
        var scenario = _scenario.Length == 0 ? null : new Scenario(_scenario, _scenario == Agendas.Other ? _scenarioName.Trim() : null,
            _artifact.Length > 0 ? _artifact : null, _ministry.Length > 0 ? _ministry : null);
        return new ZoneGame(_format, _date, Side(TableSide.A, _vpA), Side(TableSide.B, _vpB), _first, _end, scenario,
            _comment.Trim() is { Length: > 0 } c ? c : null);
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var game = Build();
            // Same checks as the server, before sending (the zone's state is checked by the server):
            // everything missing is listed at once. VP not typed: not taken for 0.
            var (_, problems) = ZoneRules.CheckGame(game, new Zone { StartDate = Zone.StartDate, EndDate = Zone.EndDate }, Catalog, Today, manager: true);
            if (Parse(_vpA) is null || Parse(_vpB) is null)
                problems = [Problem.Of("zoneVictoryPoints", TournamentRules.MaxVictoryPoints.ToString()), .. problems.Where(p => p.Key != "zoneVictoryPoints")];
            _problems = problems.Count > 0 ? problems : await Submit(game, Existing is null ? _photo : null);
        }
        finally { _busy = false; }
    }

    // Back on the tab (after "Compose…" in the builder): "My cabals" read again.
    private int _libraryVersion;
    private DotNetObjectReference<EncounterForm>? _self;
    private int? _visibilityHandler;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        try { _visibilityHandler = await JS.InvokeAsync<int>("olomoc.onVisible", _self, nameof(OnPageVisibleAsync)); }
        catch (JSException) { /* without script: the list is read again at the next load */ }
    }

    [JSInvokable]
    public async Task OnPageVisibleAsync()
    {
        await Library.ReloadAsync();
        _libraryVersion++;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_visibilityHandler is { } id)
        {
            try { await JS.InvokeVoidAsync("olomoc.offVisible", id); }
            catch (Exception e) when (e is JSException or JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
