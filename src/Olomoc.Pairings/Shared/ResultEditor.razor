@* Entry of a table's VP (organizer), and of the cabal played by each player when the tournament
   asks for two (optional, for the statistics). Fixed layout: fields and buttons do not move; the
   state (saved, changed, error) takes a box of constant width. *@
@inject LocalizationService L

<li class="tn-result @(Table.IsBye ? "bye" : null)">
    <span class="tn-table-number">@L.Ui("pairings.tableN", Table.Number)</span>
    <span class="tn-side">
        <span class="tn-player-name">@View.Player(Table.PlayerA)?.Name</span>
        @SwapButton(Table.PlayerA)
        @if (!Table.IsBye && TwoCabals)
        {
            @CabalChoice(Table.PlayerA, _cabalA, i => Toggle(ref _cabalA, i))
        }
        @if (!Table.IsBye)
        {
            @FirstChoice(TableSide.A, Table.PlayerA)
        }
    </span>
    @if (Table.IsBye)
    {
        <span class="tn-score tn-bye">@L.Ui("pairings.bye")</span>
        <span class="tn-side"></span>
        <span class="tn-result-save"></span>
    }
    else
    {
        <span class="tn-score tn-inputs">
            <input type="number" min="0" max="@TournamentRules.MaxVictoryPoints" inputmode="numeric" value="@_a"
                   @oninput="e => Edit(ref _a, e)" disabled="@ReadOnly" aria-label="@L.Ui("pairings.vpOf", View.Player(Table.PlayerA)?.Name ?? "")" />
            <span>–</span>
            <input type="number" min="0" max="@TournamentRules.MaxVictoryPoints" inputmode="numeric" value="@_b"
                   @oninput="e => Edit(ref _b, e)" disabled="@ReadOnly" aria-label="@L.Ui("pairings.vpOf", View.Player(Table.PlayerB!)?.Name ?? "")" />
        </span>
        <span class="tn-side tn-right">
            <span class="tn-player-name">@View.Player(Table.PlayerB!)?.Name</span>
            @SwapButton(Table.PlayerB!)
            @if (TwoCabals)
            {
                @CabalChoice(Table.PlayerB!, _cabalB, i => Toggle(ref _cabalB, i))
            }
            @FirstChoice(TableSide.B, Table.PlayerB!)
        </span>
        <span class="tn-result-save">
            <button class="btn small" disabled="@(!CanSave)" @onclick="SaveAsync" title="@L.Ui("pairings.result.save")">@L.Ui("pairings.result.validate")</button>
            <span class="tn-result-state @StateClass" title="@StateTitle">@StateMark</span>
        </span>
        @* Optional, for the statistics: what ended the game. *@
        <span class="tn-result-end" role="group" aria-label="@L.Ui("pairings.result.end.title")" title="@L.Ui("pairings.result.end.title")">
            <span class="tn-result-end-label">@L.Ui("pairings.result.end")</span>
            @foreach (var end in Enum.GetValues<GameEnd>())
            {
                <button type="button" class="@(_end == end ? "on" : null)" disabled="@ReadOnly" aria-pressed="@(_end == end ? "true" : "false")"
                        @onclick="() => Toggle(ref _end, end)">@L.Ui($"pairings.end.{end}")</button>
            }
        </span>
    }
</li>

@code {
    [Parameter, EditorRequired] public TournamentView View { get; set; } = default!;
    [Parameter, EditorRequired] public int RoundNumber { get; set; }
    [Parameter, EditorRequired] public Table Table { get; set; } = default!;
    /// <summary>Save (round number, table number, result): returns the problems (none if accepted).</summary>
    [Parameter, EditorRequired] public Func<int, int, ResultRequest, Task<IReadOnlyList<Problem>>> Save { get; set; } = default!;
    /// <summary>Tournament finished: results shown, no longer editable.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>
    /// Player swap (current round): ⇄ button on each player of a table without a result;
    /// <see cref="SwapSelected"/> is the player already chosen, the second click picks the other one.
    /// </summary>
    [Parameter] public EventCallback<string> OnSwap { get; set; }
    [Parameter] public string? SwapSelected { get; set; }

    // Table without VP saved (the bye included): its players can be swapped.
    private bool Swappable => OnSwap.HasDelegate && !ReadOnly && (Table.IsBye || (Table.VpA is null && Table.VpB is null));

    private RenderFragment? SwapButton(string playerId)
    {
        if (!Swappable) return null;
        var selected = SwapSelected == playerId;
        // Second player: not at the same table as the first (that would not be a swap).
        var sameTable = SwapSelected is { } s && !selected && Table.Involves(s);
        var title = selected ? L.Ui("pairings.swap.cancel")
            : SwapSelected is { } first ? L.Ui("pairings.swap.with", View.Player(first)?.Name ?? "")
            : L.Ui("pairings.swap.pick");
        return @<button type="button" class="tn-swap @(selected ? "on" : null)" disabled="@sameTable" title="@title" aria-label="@title"
                        aria-pressed="@(selected ? "true" : "false")" @onclick="() => OnSwap.InvokeAsync(playerId)">⇄</button>;
    }

    private string _a = "", _b = "";
    private int? _cabalA, _cabalB;
    private TableSide? _first;
    private GameEnd? _end;

    // P1: one click sets it, a second one removes it (optional).
    private RenderFragment FirstChoice(TableSide side, string playerId) => @<button type="button" class="tn-first @(_first == side ? "on" : null)" disabled="@ReadOnly"
            aria-pressed="@(_first == side ? "true" : "false")" title="@L.Ui("pairings.result.first.title", View.Player(playerId)?.Name ?? "")"
            @onclick="() => Toggle(ref _first, side)">@L.Ui("pairings.result.first")</button>;

    private void Toggle<T>(ref T? field, T value) where T : struct
    {
        field = Nullable.Equals(field, value) ? null : value;
        Changed();
    }
    private bool _dirty, _busy;
    private IReadOnlyList<Problem>? _problems;

    private bool TwoCabals => View.CabalsPerPlayer > 1;

    // Choice of the cabal played: "C1" / "C2", cabal name in the tooltip.
    private RenderFragment CabalChoice(string playerId, int? chosen, Action<int> pick) => @<span class="tn-cabal-choice" role="group" aria-label="@L.Ui("pairings.result.cabalOf", View.Player(playerId)?.Name ?? "")">
        @for (var i = 0; i < View.CabalsPerPlayer; i++)
        {
            var index = i;
            <button type="button" class="@(chosen == index ? "on" : null)" disabled="@ReadOnly" aria-pressed="@(chosen == index ? "true" : "false")"
                    title="@CabalName(playerId, index)" @onclick="() => pick(index)">@L.Ui("pairings.result.cabalShort", index + 1)</button>
        }
    </span>;

    private string CabalName(string playerId, int index) =>
        View.Player(playerId)?.Cabals is { } cabals && index < cabals.Count && cabals[index].Name is { Length: > 0 } name
            ? name : L.Ui("pairings.cabalN", index + 1);

    // Server values taken back as long as no entry is in progress (periodic refresh).
    protected override void OnParametersSet()
    {
        if (_dirty) return;
        _a = Table.VpA?.ToString() ?? "";
        _b = Table.VpB?.ToString() ?? "";
        _cabalA = Table.CabalA;
        _cabalB = Table.CabalB;
        _first = Table.First;
        _end = Table.End;
    }

    private void Edit(ref string field, ChangeEventArgs e)
    {
        field = e.Value?.ToString() ?? "";
        Changed();
    }

    private void Changed()
    {
        _dirty = _a != (Table.VpA?.ToString() ?? "") || _b != (Table.VpB?.ToString() ?? "")
                 || (TwoCabals && (_cabalA != Table.CabalA || _cabalB != Table.CabalB))
                 || _first != Table.First || _end != Table.End;
        _problems = null;
    }

    private static int? Parse(string s) => int.TryParse(s, out var n) ? n : null;

    // Two values (or none, to clear), different from what is saved.
    private bool CanSave => !ReadOnly && _dirty && !_busy && (_a.Length == 0) == (_b.Length == 0)
                            && (_a.Length == 0 || (Parse(_a) is >= 0 and <= TournamentRules.MaxVictoryPoints
                                                   && Parse(_b) is >= 0 and <= TournamentRules.MaxVictoryPoints));

    private async Task SaveAsync()
    {
        if (!CanSave) return;
        _busy = true;
        try
        {
            _problems = await Save(RoundNumber, Table.Number, new ResultRequest(Parse(_a), Parse(_b), _cabalA, _cabalB, _first, _end));
            if (_problems.Count == 0) _dirty = false;
        }
        finally { _busy = false; }
    }

    private string StateClass => _problems is { Count: > 0 } ? "error" : _dirty ? "dirty" : Table.HasResult ? "saved" : "";
    private string StateMark => _problems is { Count: > 0 } ? "!" : _dirty ? "•" : Table.HasResult ? "✓" : "";
    private string? StateTitle => _problems is { Count: > 0 } p ? string.Join(" ", p.Select(L.Describe))
                                  : _dirty ? L.Ui("pairings.result.unsaved") : Table.HasResult ? L.Ui("pairings.result.saved") : null;
}
