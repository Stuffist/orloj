@* Statistics panels, for the tournaments, a zone or all the zones: factions played, cog choices per
   faction, wins per alignment, per faction and per rank 3 cog; where they are recorded: P1 wins, game
   endings, scenarios and decks played. *@
@inject LocalizationService L
@inject CatalogService Catalog

<section class="panel">
    <h3>@L.Ui("pairings.stats.factions")</h3>
    @foreach (var f in Stats.Factions)
    {
        <PercentBar Percent="f.Percent" Detail="@L.Ui(Zones ? "zones.stats.participations" : "pairings.stats.players", f.Count)">
            <FactionBadge Code="@f.Key" />
        </PercentBar>
    }
</section>

<section class="panel">
    <h3>@L.Ui(Zones ? "zones.stats.picks" : "pairings.stats.picks")</h3>
    @if (Stats.Picks.Count == 0)
    {
        <p class="empty">@L.Ui("pairings.stats.notNoted")</p>
    }
    else
    {
        <div class="field">
            <label for="stats-faction">@L.Ui("filter.faction")</label>
            <select id="stats-faction" value="@PicksFaction" @onchange="e => _faction = e.Value?.ToString()">
                @foreach (var p in Stats.Picks)
                {
                    <option value="@p.Faction">@L.FactionName(p.Faction) (@L.Ui("pairings.stats.cabals", p.Cabals))</option>
                }
            </select>
        </div>
        @if (Stats.Picks.FirstOrDefault(p => p.Faction == PicksFaction) is { } picks)
        {
            @foreach (var rank in new[] { 3, 2, 1 })
            {
                var cogs = picks.Cogs.Where(c => Catalog.CogById(c.Key)?.Rank == rank).ToList();
                if (cogs.Count == 0) continue;
                <h4>@L.Ui("slot.rank", rank)</h4>
                @foreach (var c in cogs)
                {
                    <PercentBar Percent="c.Percent" Detail="@($"{c.Count} / {c.Total}")">@CogName(c.Key)</PercentBar>
                }
            }
        }
    }
</section>

<section class="panel">
    <h3>@L.Ui("pairings.stats.alignmentWins")</h3>
    @if (Stats.AlignmentWins.Count == 0)
    {
        <p class="empty">@L.Ui("pairings.stats.alignmentEmpty")</p>
    }
    @foreach (var w in Stats.AlignmentWins)
    {
        <PercentBar Percent="w.Percent" Detail="@Record(w)" Muted="@(w.Games < StatsView.MinGames)" Title="@LowSample(w)">
            <span class="tn-alignment @w.Key.ToLowerInvariant()">@L.Ui($"pairings.alignment.{w.Key}")</span>
        </PercentBar>
    }
</section>

<section class="panel">
    <h3>@L.Ui("pairings.stats.factionWins")</h3>
    @foreach (var w in Stats.FactionWins)
    {
        <PercentBar Percent="w.Percent" Detail="@Record(w)" Muted="@(w.Games < StatsView.MinGames)" Title="@LowSample(w)">
            <FactionBadge Code="@w.Key" />
        </PercentBar>
    }
</section>

<section class="panel">
    <h3>@L.Ui("pairings.stats.rank3Wins")</h3>
    @if (Stats.Rank3Wins.Count == 0)
    {
        <p class="empty">@L.Ui("pairings.stats.rank3Empty")</p>
    }
    @foreach (var w in Stats.Rank3Wins)
    {
        <PercentBar Percent="w.Percent" Detail="@Record(w)" Muted="@(w.Games < StatsView.MinGames)" Title="@LowSample(w)">@CogName(w.Key)</PercentBar>
    }
</section>

@* Recorded when entering results (optional): P1, end of the game, scenario, decks. *@
<section class="panel">
    <h3>@L.Ui("pairings.stats.first")</h3>
    @if (Stats.FirstPlayer.Games == 0)
    {
        <p class="empty">@L.Ui("pairings.stats.notNoted")</p>
    }
    else
    {
        var w = Stats.FirstPlayer;
        <PercentBar Percent="w.Percent" Detail="@Record(w)" Muted="@(w.Games < StatsView.MinGames)" Title="@LowSample(w)">@L.Ui("pairings.stats.firstWins")</PercentBar>
    }
</section>

<section class="panel">
    <h3>@L.Ui("pairings.stats.ends")</h3>
    @if (Stats.Ends.Count == 0)
    {
        <p class="empty">@L.Ui("pairings.stats.notNoted")</p>
    }
    @foreach (var e in Stats.Ends)
    {
        <PercentBar Percent="e.Percent" Detail="@($"{e.Count} / {e.Total}")">@L.Ui($"pairings.end.{e.Key}")</PercentBar>
    }
</section>

<section class="panel">
    <h3>@L.Ui("pairings.stats.scenarios")</h3>
    @if (Stats.Scenarios.Count == 0)
    {
        <p class="empty">@L.Ui("pairings.stats.notNoted")</p>
    }
    @foreach (var sc in Stats.Scenarios)
    {
        <PercentBar Percent="sc.Percent" Detail="@ScenarioDetail(sc)">@L.Ui($"agenda.{sc.Key}")</PercentBar>
    }
</section>

@foreach (var (title, prefix, decks) in new[] { ("pairings.stats.artifacts", "deck.artifact", Stats.Artifacts), ("pairings.stats.ministries", "deck.ministry", Stats.Ministries) })
{
    <section class="panel">
        <h3>@L.Ui(title)</h3>
        @if (decks.Count == 0)
        {
            <p class="empty">@L.Ui("pairings.stats.notNoted")</p>
        }
        @foreach (var d in decks)
        {
            <PercentBar Percent="d.Percent" Detail="@ScenarioDetail(d)">@L.Ui($"{prefix}.{d.Key}")</PercentBar>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public StatsView Stats { get; set; } = default!;
    /// <summary>Games of zones: factions counted on the participations, cogs on the cabals played.</summary>
    [Parameter] public bool Zones { get; set; }

    private string? _faction;

    // Faction chosen for the cogs: the most played by default.
    private string? PicksFaction => _faction is { } f && Stats.Picks.Any(p => p.Faction == f) ? f : Stats.Picks.FirstOrDefault()?.Faction;

    private string CogName(string id) => Catalog.CogById(id) is { } cog ? L.CogName(cog).Text : id;

    // "5 W · 1 D · 2 L — 8 games"
    private string Record(WinRate w) => L.Ui("pairings.stats.record", w.Wins, w.Draws, w.Losses, w.Games);

    // "12 games · P1 wins 58% (7 games recorded)"
    private string ScenarioDetail(ScenarioStat sc) => sc.First.Games == 0
        ? L.Ui("pairings.stats.games", sc.Games)
        : L.Ui("pairings.stats.scenarioFirst", sc.Games, Math.Round(sc.First.Percent), sc.First.Games);

    private string? LowSample(WinRate w) => w.Games < StatsView.MinGames ? L.Ui("pairings.stats.lowSample", StatsView.MinGames) : null;
}
