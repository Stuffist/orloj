@* Dominance of a zone: "Dominated by the Light — leading: Rubin Network", "Closed under Darkness,
   dominated by The Others", a tie, not enough games yet (win rate), or nothing yet. *@
@inject LocalizationService L

<p class="zn-dominance @(Dominance.Alignment?.ToString().ToLowerInvariant())">
    @if (Dominance.Alignment is { } alignment)
    {
        <span class="tn-alignment @alignment.ToString().ToLowerInvariant()">@L.Ui($"pairings.alignment.{alignment}")</span>
        <span>@L.Ui(Closed ? "zones.dominance.closedUnder" : "zones.dominance.dominatedBy", L.Ui($"zones.alignment.{alignment}"))</span>
        @if (Dominance.Faction is { } faction)
        {
            <span class="zn-dominance-faction">@L.Ui(Closed ? "zones.dominance.faction.closed" : "zones.dominance.faction")</span>
            <FactionBadge Code="@faction" />
        }
    }
    else if (Dominance.Tie)
    {
        <span>@L.Ui(Closed ? "zones.dominance.tie.closed" : "zones.dominance.tie")</span>
    }
    else if (Dominance.NeedsMoreGames)
    {
        <span class="empty">@L.Ui(Closed ? "zones.dominance.needsGames.closed" : "zones.dominance.needsGames", Dominance.Games, StatsView.MinGames)</span>
    }
    else if (Dominance.Games > 0)
    {
        @* Light against Darkness games, but nobody ahead (draws, no VP scored). *@
        <span class="empty">@L.Ui(Closed ? "zones.dominance.none.closed" : "zones.dominance.noWinner")</span>
    }
    else
    {
        <span class="empty">@L.Ui(Closed ? "zones.dominance.none.closed" : "zones.dominance.none")</span>
    }
</p>

@code {
    [Parameter, EditorRequired] public Dominance Dominance { get; set; } = default!;
    [Parameter] public bool Closed { get; set; }
}
