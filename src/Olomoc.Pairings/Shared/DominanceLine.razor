@* Dominance of a zone: "Dominated by Rubin Network", "Closed, dominated by The Others", a tie, not
   enough games yet (win rate), or nothing yet. *@
@inject LocalizationService L

<p class="zn-dominance">
    @if (Dominance.Faction is { } faction)
    {
        <span>@L.Ui(Closed ? "zones.dominance.closedUnder" : "zones.dominance.dominatedBy")</span>
        <FactionBadge Code="@faction" />
    }
    else if (Dominance.Tie)
    {
        <span>@L.Ui(Closed ? "zones.dominance.tie.closed" : "zones.dominance.tie")</span>
    }
    else if (Dominance.NeedsMoreGames)
    {
        <span class="empty">@L.Ui(Closed ? "zones.dominance.needsGames.closed" : "zones.dominance.needsGames", Dominance.MostPlayed, StatsView.MinGames)</span>
    }
    else if (Dominance.Games > 0)
    {
        @* Games, but nobody ahead (draws, no VP scored). *@
        <span class="empty">@L.Ui(Closed ? "zones.dominance.none.closed" : "zones.dominance.noWinner")</span>
    }
    else
    {
        <span class="empty">@L.Ui(Closed ? "zones.dominance.none.closed" : "zones.dominance.none")</span>
    }
</p>

@code {
    [Parameter, EditorRequired] public Dominance Dominance { get; set; } = default!;
    [Parameter] public bool Closed { get; set; }
}
