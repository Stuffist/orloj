<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Olomoc.Pairings</RootNamespace>
    <!-- Servi par Olomoc.Server sous /pairings/ (voir le <base href> de wwwroot/index.html). -->
    <StaticWebAssetBasePath>pairings</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.8" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Olomoc.Shared\Olomoc.Shared.csproj" />
  </ItemGroup>

</Project>
