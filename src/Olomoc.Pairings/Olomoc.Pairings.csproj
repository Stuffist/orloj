<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Tournois (appariements, classements, statistiques) : pages sous /pairings/…, réunies
       avec le constructeur dans l'app Olomoc.Web. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Olomoc.Pairings</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Olomoc.Shared\Olomoc.Shared.csproj" />
  </ItemGroup>

</Project>
