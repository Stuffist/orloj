<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Tournaments (pairings, standings, statistics): pages under /pairings/…, brought together
       with the builder in the Olomoc.Web app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Olomoc.Pairings</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Olomoc.Shared\Olomoc.Shared.csproj" />
  </ItemGroup>

</Project>
