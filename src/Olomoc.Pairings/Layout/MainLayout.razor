@namespace Olomoc.Pairings.Layout
@inherits LayoutComponentBase
@implements IDisposable
@inject LocalizationService L

<PageTitle>@(L.Loaded ? L.Ui("pairings.title") : "Olomòc")</PageTitle>

<div class="app-shell">
    <header class="app-header">
        <a class="mark" href="" title="@(L.Loaded ? L.Ui("pairings.home") : null)"></a>
        <div class="app-titles">
            @if (L.Loaded)
            {
                <h1>@L.Ui("pairings.title")</h1>
                <p class="subtitle">@L.Ui("pairings.subtitle")</p>
            }
            else
            {
                <h1>Olomòc</h1>
            }
        </div>
        <HeaderTools Current="pairings" />
    </header>
    <main>@Body</main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnChanged;
        await L.EnsureLoadedAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnChanged;
}
