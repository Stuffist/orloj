@* Guided setup (rulebook p.31). Initiative: each player rolls 5 D6 (rolled by the server), success
   on 5+, the most successes becomes P1, tie: roll again. Agenda: P1 chooses it or draws it at
   random from the official collection (draw to confirm, or to redraw). *@
@inject LocalizationService L

<section class="panel">
    @if (_held is { } held)
    {
        @* Complete roll, kept on screen for 2 s: the server has already designated P1 (or asked to roll again). *@
        <h2>@L.Ui("online.initiative.title")</h2>
        <ul class="online-dice-rows">
            @for (var i = 0; i < View.Seats.Count; i++)
            {
                <li>
                    <span class="online-seat-name">@View.Seats[i].Name</span>
                    @if (held.Dice[i] is { } dice)
                    {
                        <span class="online-dice">
                            @foreach (var d in dice)
                            {
                                <span class="online-die @(d >= OnlineRules.Success ? "hit" : null)">@d</span>
                            }
                        </span>
                        <span class="online-successes">@L.Ui("online.initiative.successes", OnlineRules.Successes(dice))</span>
                    }
                </li>
            }
        </ul>
        <p class="@(held.First is null ? "export-warning" : "online-verdict")">
            @(held.First is { } first ? L.Ui("online.first", View.Seats[first].Name) : L.Ui("online.initiative.tie"))
        </p>
    }
    else if (View.Step == OnlineStep.Initiative)
    {
        <h2>@L.Ui("online.initiative.title")</h2>
        <p class="hint">@L.Ui("online.initiative.help", OnlineRules.InitiativeDice, OnlineRules.Success)</p>
        @if (View.Log.LastOrDefault()?.Key == "initiativeTie")
        {
            <p class="export-warning">@L.Ui("online.initiative.tie")</p>
        }
        <ul class="online-dice-rows">
            @for (var i = 0; i < View.Seats.Count; i++)
            {
                var seat = View.Seats[i];
                <li>
                    <span class="online-seat-name">@seat.Name</span>
                    @if (seat.Initiative is { } dice)
                    {
                        <span class="online-dice">
                            @foreach (var d in dice)
                            {
                                <span class="online-die @(d >= OnlineRules.Success ? "hit" : null)">@d</span>
                            }
                        </span>
                        <span class="online-successes">@L.Ui("online.initiative.successes", OnlineRules.Successes(dice))</span>
                    }
                    else if (View.Me == i)
                    {
                        <button class="btn primary" type="button" @onclick="() => Send(new(OnlineCommandType.RollInitiative))">@L.Ui("online.initiative.roll")</button>
                    }
                    else
                    {
                        <span class="hint">@L.Ui("online.initiative.waiting")</span>
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <h2>@L.Ui("online.agenda.title")</h2>
        <p>@L.Ui("online.first", View.Seats[View.First!.Value].Name)</p>
        @if (View.Me == View.First)
        {
            <div class="online-inline">
                @* Random draw: suggests an agenda in the list, to confirm or redraw (nothing is sent
                   before "Confirm"). *@
                <select aria-label="@L.Ui("online.agenda.title")" value="@_agenda" @onchange="e => (_agenda, _drawn) = (e.Value?.ToString() ?? Agendas.All[0], false)">
                    @foreach (var id in Agendas.All)
                    {
                        <option value="@id">@L.Ui($"agenda.{id}")</option>
                    }
                </select>
                <button class="btn primary" type="button" @onclick="() => Send(new(OnlineCommandType.ChooseAgenda, _agenda))">@L.Ui(_drawn ? "online.agenda.confirm" : "online.agenda.choose")</button>
                <button class="btn" type="button" @onclick="Draw">@L.Ui(_drawn ? "online.agenda.redraw" : "online.agenda.draw")</button>
            </div>
            @if (_drawn)
            {
                <p class="online-verdict">@L.Ui("online.agenda.drawn", L.Ui($"agenda.{_agenda}"))</p>
            }
        }
        else
        {
            <p class="hint">@L.Ui("online.agenda.waiting", View.Seats[View.First!.Value].Name)</p>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public OnlineView View { get; set; } = default!;
    [Parameter, EditorRequired] public Func<OnlineCommand, Task> Send { get; set; } = default!;

    private string _agenda = Agendas.All[0];
    private bool _drawn;

    // Random agenda from the official collection, other than the one suggested: to confirm or redraw.
    private void Draw()
    {
        var others = Agendas.All.Where(id => id != _agenda).ToList();
        (_agenda, _drawn) = (others[Random.Shared.Next(others.Count)], true);
    }

    // ---- Roll result, kept for 2 s ----
    // On the second roll, the server designates P1 (next step) or clears the dice (tie): without a
    // pause, the result would disappear at once. The complete roll is read back from the log
    // (each seat's "initiative", then "first" or "initiativeTie") and shown for 2 s, only when it
    // is seen arriving (not when the page loads).
    private const int HoldMilliseconds = 2000;

    private sealed record InitiativeRound(IReadOnlyList<int>?[] Dice, int? First);

    private DateTimeOffset? _lastRound;     // end of the last complete roll already seen
    private bool _started;
    private InitiativeRound? _held;
    private int _holdId;

    protected override void OnParametersSet()
    {
        var log = View.Log;
        var end = -1;
        for (var i = log.Count - 1; i >= 0 && end < 0; i--)
            if (log[i].Key is "first" or "initiativeTie") end = i;
        var at = end >= 0 ? log[end].At : (DateTimeOffset?)null;
        if (!_started)
        {
            (_started, _lastRound) = (true, at);
            return;
        }
        if (at is null || at == _lastRound) return;
        _lastRound = at;

        // The rolls of this round: "initiative" entries right before the end, one per seat.
        var dice = new IReadOnlyList<int>?[View.Seats.Count];
        for (var i = end - 1; i >= 0 && log[i].Key == "initiative"; i--)
            if (log[i].Seat is { } seat && seat < dice.Length && dice[seat] is null && log[i].Args is { Count: > 0 } args)
                dice[seat] = args[0].Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(int.Parse).ToList();
        _held = new InitiativeRound(dice, log[end].Key == "first" ? log[end].Seat : null);
        var id = ++_holdId;
        _ = Task.Delay(HoldMilliseconds).ContinueWith(_ => InvokeAsync(() =>
        {
            if (_holdId != id) return;
            _held = null;
            StateHasChanged();
        }));
    }
}
