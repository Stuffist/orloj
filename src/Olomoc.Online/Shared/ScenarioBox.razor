@inject LocalizationService L

@* The scenario of an online game, in the game's header (next to its code): the Artifact and Ministry
   decks (chosen or drawn by P1; drawn with a scenario drawn), a note on its setup, and « Placer +
   distribuer » (P1, once both decks are chosen): its elements put on the mat (AgendaSetups: positions
   of the Recueil des agendas; a choice where the agenda leaves one), the ministries dealt, the Artefact
   shuffled. Then the decks no longer change. *@

@if (View.Agenda is { } agenda)
{
    var setup = AgendaSetups.Of(agenda.Id);
    // Before the setup: what « Placer + distribuer » puts on the mat.
    var variant = setup is { Variants.Count: > 0 } && !Started ? Variant(setup) : null;
    <div class="online-scenario">

        <div class="online-inline offblock-decks">
            <label>
                <span>@L.Ui("online.offblock.artifact")</span>
                <select disabled="@(!CanChooseDecks || agenda.Id == OnlineRules.Visits)" title="@(agenda.Id == OnlineRules.Visits ? L.Ui("online.offblock.decks.visits") : DecksTitle)" value="@(agenda.Artifact ?? "")" @onchange="e => SetDecksAsync(e.Value?.ToString(), agenda.Ministry)">
                    <option value="">—</option>
                    @foreach (var id in Decks.Artifacts)
                    {
                        <option value="@id">@L.Ui($"deck.artifact.{id}")</option>
                    }
                </select>
            </label>
            <label>
                <span>@L.Ui("online.offblock.ministry")</span>
                <select disabled="@(!CanChooseDecks)" title="@DecksTitle" value="@(agenda.Ministry ?? "")" @onchange="e => SetDecksAsync(agenda.Artifact, e.Value?.ToString())">
                    <option value="">—</option>
                    @foreach (var id in Decks.Ministries)
                    {
                        <option value="@id">@L.Ui($"deck.ministry.{id}")</option>
                    }
                </select>
            </label>
            @if (CanChooseDecks && (agenda.Artifact is null || agenda.Ministry is null))
            {
                <button class="btn small" type="button" @onclick="DrawDecksAsync">🎲 @L.Ui("online.offblock.drawDecks")</button>
            }
            else if (CanChooseDecks)
            {
                @if (variant is not null && setup!.Variants.Count > 1)
                {
                    <select aria-label="@L.Ui("online.offblock.variant")" value="@variant.Id" @onchange="e => _variant = e.Value?.ToString()">
                        @foreach (var v in setup.Variants)
                        {
                            <option value="@v.Id">@L.Ui($"online.agenda.variant.{v.Id}")</option>
                        }
                    </select>
                }
                <button class="btn small primary" type="button" title="@L.Ui("online.offblock.setUp.title")"
                        @onclick="() => Send(new(OnlineCommandType.SetUp, variant?.Id))">📍 @L.Ui("online.offblock.setUp")</button>
            }
        </div>

        <p class="hint">@L.Ui($"online.agenda.note.{agenda.Id}")</p>
        @if (variant is not null)
        {
            <p class="hint">@Elements(variant)</p>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public OnlineView View { get; set; } = default!;
    [Parameter, EditorRequired] public Func<OnlineCommand, Task> Send { get; set; } = default!;

    private string? _variant;

    // From the initiative to the end of the game, for the players.
    private bool CanAct => View.Me is not null && View.Step is OnlineStep.Initiative or OnlineStep.Agenda or OnlineStep.Cycle;

    // The game set up (ministries dealt): its decks no longer change.
    private bool Started => View.Decks?.Fallen is not null;

    // The decks of the scenario: chosen by P1, until the game is set up.
    private bool CanChooseDecks => CanAct && View.Me is { } me && View.First == me && !Started;

    private string DecksTitle => L.Ui(Started ? "online.offblock.decks.locked" : "online.offblock.decks.first");

    private AgendaVariant Variant(AgendaSetup setup) => setup.Variants.FirstOrDefault(v => v.Id == _variant) ?? setup.Variants[0];

    // "3 × Secret, 4 × Zone de Fiel": what "Placer" puts down.
    private string Elements(AgendaVariant variant) => string.Join(", ", variant.Elements
        .GroupBy(e => e.Kind).Select(g => $"{g.Count()} × {L.Ui($"online.agenda.element.{g.Key}")}"));

    private Task SetDecksAsync(string? artifact, string? ministry) =>
        Send(new(OnlineCommandType.SetDecks, Decks: [Empty(artifact), Empty(ministry)]));

    private Task DrawDecksAsync() => Send(new(OnlineCommandType.SetDecks, Flag: true));

    private static string? Empty(string? id) => string.IsNullOrEmpty(id) ? null : id;
}
