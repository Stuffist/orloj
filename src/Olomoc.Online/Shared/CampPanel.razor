@* Un camp de la partie : joueur, faction, Fiel, points de victoire, puis ses rouages (fiches du
   mode partie) ; la traque, commune aux deux joueurs, est dans l'en-tête de la partie.
   Editable : le camp du joueur, dont chaque modification part au serveur (OnChanged) ; sinon
   lecture seule (adversaire, spectateur). *@
@inject LocalizationService L
@inject CatalogService Catalog

@{ var s = Session.State; }
<section class="online-camp @(Editable ? "mine" : null)">
    <div class="play-bar">
        <div class="play-ident">
            <div class="play-names">
                <span class="play-name">
                    <span class="online-presence @(Seat.Connected ? "on" : null)" title="@L.Ui(Seat.Connected ? "online.connected" : "online.disconnected")"></span>
                    @Seat.Name
                    @if (IsFirst)
                    {
                        <span class="tn-first-mark" title="@L.Ui("pairings.result.first.played")">@L.Ui("pairings.result.first")</span>
                    }
                </span>
                <span class="play-faction camp-line">
                    @if (s.Faction is { } f)
                    {
                        <span class="emblem-name"><Emblem Faction="@f" />@L.FactionName(f)</span>
                    }
                    @if (s.Name is { } n)
                    {
                        <span class="camp-cabal">@n</span>
                    }
                </span>
            </div>
        </div>

        <div class="play-counters">
            <div class="counter bile @(s.Bile >= GameSession.MaxBile ? "lost" : null)">
                <span class="counter-label">@L.Ui("play.bile")</span>
                <span class="counter-track">
                    @if (Editable) { <button class="step" @onclick="() => Act(() => Session.AdjustBile(-1))" disabled="@(s.Bile == 0)" aria-label="@L.Ui("play.bile") −">−</button> }
                    <TokenTrack Token="darkness" Count="s.Bile" Max="GameSession.MaxBile" />
                    @if (Editable) { <button class="step" @onclick="() => Act(() => Session.AdjustBile(1))" disabled="@(s.Bile >= GameSession.MaxBile)" aria-label="@L.Ui("play.bile") +">+</button> }
                </span>
            </div>
            <div class="counter vp" title="@L.Ui("play.vp.title")">
                <span class="counter-label">@L.Ui("play.vp")</span>
                <span class="counter-track">
                    @if (Editable) { <button class="step" @onclick="() => Act(() => Session.AdjustVictoryPoints(-1))" disabled="@(s.VictoryPoints == 0)" aria-label="@L.Ui("play.vp") −">−</button> }
                    <span class="counter-value vp-value">@s.VictoryPoints</span>
                    @if (Editable) { <button class="step" @onclick="() => Act(() => Session.AdjustVictoryPoints(1))" disabled="@(s.VictoryPoints >= OnlineRules.MaxVictoryPoints)" aria-label="@L.Ui("play.vp") +">+</button> }
                </span>
            </div>
        </div>
    </div>

    <div class="play-cogs">
        @for (var i = 0; i < s.Cogs.Count; i++)
        {
            var slot = i;
            if (Catalog.CogById(s.Cogs[slot].CogId) is not { } cog) continue;
            <PlayCogCard Session="Session" Slot="slot" Cog="cog" ReadOnly="!Editable" OnChanged="OnChanged" />
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public SeatView Seat { get; set; } = default!;
    [Parameter, EditorRequired] public GameSession Session { get; set; } = default!;
    [Parameter] public bool Editable { get; set; }
    [Parameter] public bool IsFirst { get; set; }
    /// <summary>Après chaque modification du camp (éditable), avec son compte rendu éventuel.</summary>
    [Parameter] public EventCallback<string?> OnChanged { get; set; }

    private Task Act(Action action)
    {
        action();
        return OnChanged.InvokeAsync(null);
    }
}
