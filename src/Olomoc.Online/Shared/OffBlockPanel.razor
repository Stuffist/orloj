@inject LocalizationService L

@* "Hors Bloc": what a game puts beside the Block. Scenario: the agenda chosen at the setup (P1),
   the Artifact and Ministry decks of the game, and its elements put on the mat with "Placer"
   (AgendaSetups: positions of the Recueil des agendas; a choice where the agenda leaves one). In
   the game page, and alone in its detached window. *@

<section class="panel offblock-panel">
    <div class="online-camps-head">
        <h2>@L.Ui("online.offblock.title")</h2>
        @HeadContent
    </div>

    <div class="offblock-section">
        <h3>@L.Ui("online.offblock.scenario")</h3>
        @if (View.Agenda is not { } agenda)
        {
            <p class="hint">@L.Ui("online.offblock.noAgenda")</p>
        }
        else
        {
            var setup = AgendaSetups.Of(agenda.Id);
            <p class="offblock-agenda"><ScenarioTag Scenario="agenda" /></p>

            <div class="online-inline offblock-decks">
                <label>
                    <span>@L.Ui("online.offblock.artifact")</span>
                    <select disabled="@(!CanAct)" value="@(agenda.Artifact ?? "")" @onchange="e => SetDecksAsync(e.Value?.ToString(), agenda.Ministry)">
                        <option value="">—</option>
                        @foreach (var id in Decks.Artifacts)
                        {
                            <option value="@id">@L.Ui($"deck.artifact.{id}")</option>
                        }
                    </select>
                </label>
                <label>
                    <span>@L.Ui("online.offblock.ministry")</span>
                    <select disabled="@(!CanAct)" value="@(agenda.Ministry ?? "")" @onchange="e => SetDecksAsync(agenda.Artifact, e.Value?.ToString())">
                        <option value="">—</option>
                        @foreach (var id in Decks.Ministries)
                        {
                            <option value="@id">@L.Ui($"deck.ministry.{id}")</option>
                        }
                    </select>
                </label>
                @if (CanAct)
                {
                    <button class="btn small" type="button" @onclick="DrawDecksAsync">🎲 @L.Ui("online.offblock.drawDecks")</button>
                }
            </div>

            <p class="hint">@L.Ui($"online.agenda.note.{agenda.Id}")</p>

            @if (setup is { Variants.Count: > 0 })
            {
                var variant = Variant(setup);
                <div class="online-inline offblock-place">
                    @if (setup.Variants.Count > 1)
                    {
                        <select aria-label="@L.Ui("online.offblock.variant")" value="@variant.Id" @onchange="e => _variant = e.Value?.ToString()">
                            @foreach (var v in setup.Variants)
                            {
                                <option value="@v.Id">@L.Ui($"online.agenda.variant.{v.Id}")</option>
                            }
                        </select>
                    }
                    @if (CanAct)
                    {
                        <button class="btn small primary" type="button" title="@L.Ui("online.offblock.place.title")"
                                @onclick="() => Send(new(OnlineCommandType.PlaceAgenda, variant.Id))">📍 @L.Ui("online.offblock.place")</button>
                    }
                </div>
                <p class="hint">@Elements(variant)</p>
            }
        }
    </div>

    @* Ministries (rulebook p.31): dealt to both players, a secret hand each; the fallen one face up. *@
    <div class="offblock-section">
        <h3>@L.Ui("online.offblock.ministries")</h3>
        @if (View.Agenda?.Ministry is null)
        {
            <p class="hint">@L.Ui("online.offblock.chooseDecks")</p>
        }
        else if (View.Decks is not { Fallen: { } fallen } decks)
        {
            @if (CanAct)
            {
                <button class="btn small primary" type="button" @onclick="() => Send(new(OnlineCommandType.DealMinistries))">🂠 @L.Ui("online.offblock.deal")</button>
            }
            <p class="hint">@L.Ui("online.offblock.deal.help")</p>
        }
        else
        {
            <div class="offblock-cards">
                @if (View.Me is not null)
                {
                    <div class="offblock-group">
                        <span class="online-label">@L.Ui("online.offblock.myHand")</span>
                        <div class="offblock-row">
                            @foreach (var id in decks.MyHand)
                            {
                                @Ministry(id)
                            }
                        </div>
                    </div>
                }
                <div class="offblock-group">
                    <span class="online-label">@L.Ui("online.offblock.fallen")</span>
                    <div class="offblock-row">@Ministry(fallen)</div>
                </div>
            </div>
            <p class="hint">
                @string.Join(" · ", View.Seats.Select((s, i) => L.Ui("online.offblock.handOf", s.Name, decks.HandSizes.ElementAtOrDefault(i))))
                @if (CanAct)
                {
                    <button class="btn small" type="button" @onclick="() => Send(new(OnlineCommandType.DealMinistries, Flag: true))">@L.Ui("online.offblock.dealAgain")</button>
                }
            </p>
        }
    </div>

    @* Artefact (p.27): its pile, "Mécanisme" (its top card, the priority it gives), its discard; the
       hostiles' profiles; Indra's cards for her player. *@
    <div class="offblock-section">
        <h3>@L.Ui("online.offblock.artifactTitle")</h3>
        @if (View.Agenda?.Artifact is null)
        {
            <p class="hint">@L.Ui("online.offblock.chooseDecks")</p>
        }
        else
        {
            var decks = View.Decks;
            var drawn = CardDecks.Artifact(decks?.Drawn);
            <div class="online-inline offblock-artifact-tools">
                <span class="hint">@L.Ui("online.offblock.pile", decks?.ArtifactDeck is null ? 12 : decks.PileSize, decks?.Discard.Count ?? 0)</span>
                @if (CanAct)
                {
                    <button class="btn small primary" type="button" title="@L.Ui("online.offblock.mechanism.title")"
                            @onclick="() => Send(new(OnlineCommandType.Mechanism))">⚙ @L.Ui("online.offblock.mechanism")</button>
                    <button class="btn small" type="button" @onclick="() => Send(new(OnlineCommandType.ReshuffleArtifact))">⟳ @L.Ui("online.offblock.reshuffle")</button>
                }
            </div>
            <div class="offblock-cards">
                @if (drawn is not null)
                {
                    <div class="offblock-group">
                        <span class="online-label">@L.Ui("online.offblock.drawn", decks!.Mechanisms)</span>
                        @Artifact(drawn, large: true)
                        <span class="offblock-priority">@(drawn.Priority is { } p ? L.Ui("online.offblock.priority", PlayerName(p)) : L.Ui("online.offblock.priority.unknown"))</span>
                    </div>
                }
                @foreach (var hostile in CardDecks.HostilesOf(View.Agenda.Artifact, View.Agenda.Id))
                {
                    var h = hostile;
                    var back = _backs.Contains(h.Id);
                    <div class="offblock-group">
                        <span class="online-label">@L.Ui("online.offblock.hostile", h.Name)</span>
                        <button class="offblock-hostile" type="button" title="@L.Ui("online.offblock.hostile.flip")" @onclick="() => Flip(h.Id)">
                            <img src="@Src(back ? CardDecks.Back(h) : CardDecks.Front(h))" alt="@h.Name" />
                        </button>
                    </div>
                }
            </div>
            @if (decks is { Discard.Count: > 0 })
            {
                <details class="offblock-discard">
                    <summary>@L.Ui("online.offblock.discard", decks.Discard.Count)</summary>
                    <div class="offblock-row">
                        @foreach (var id in decks.Discard)
                        {
                            if (CardDecks.Artifact(id) is { } card) { @Artifact(card, large: false) }
                        }
                    </div>
                </details>
            }
            @if (IndraMine)
            {
                <div class="offblock-group offblock-indra">
                    <span class="online-label">@L.Ui("online.offblock.indra")</span>
                    @if (decks?.IndraSeat is null)
                    {
                        <button class="btn small" type="button" title="@L.Ui("online.offblock.indra.take.title")"
                                @onclick="() => Send(new(OnlineCommandType.IndraTake))">@L.Ui("online.offblock.indra.take")</button>
                    }
                    else
                    {
                        <div class="offblock-row">
                            @foreach (var id in decks.MyIndra)
                            {
                                if (CardDecks.Artifact(id) is not { } card) continue;
                                var cid = id;
                                <div class="offblock-indra-card">
                                    @Artifact(card, large: false)
                                    <button class="btn small" type="button" disabled="@(decks.Drawn is null)" title="@L.Ui("online.offblock.indra.swap.title")"
                                            @onclick="() => Send(new(OnlineCommandType.IndraSwap, cid))">@L.Ui("online.offblock.indra.swap")</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (decks?.IndraSeat is { } indra)
            {
                <p class="hint">@L.Ui("online.offblock.indra.other", View.Seats[indra].Name, decks.IndraCount)</p>
            }
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public OnlineView View { get; set; } = default!;
    [Parameter, EditorRequired] public Func<OnlineCommand, Task> Send { get; set; } = default!;
    /// <summary>More buttons in the header (detach, bring back).</summary>
    [Parameter] public RenderFragment? HeadContent { get; set; }

    private string? _variant;

    // From the initiative to the end of the game, for the players.
    private bool CanAct => View.Me is not null && View.Step is OnlineStep.Initiative or OnlineStep.Agenda or OnlineStep.Cycle;

    private AgendaVariant Variant(AgendaSetup setup) => setup.Variants.FirstOrDefault(v => v.Id == _variant) ?? setup.Variants[0];

    // "3 × Secret, 4 × Zone de Fiel": what "Placer" puts down.
    private string Elements(AgendaVariant variant) => string.Join(", ", variant.Elements
        .GroupBy(e => e.Kind).Select(g => $"{g.Count()} × {L.Ui($"online.agenda.element.{g.Key}")}"));

    private Task SetDecksAsync(string? artifact, string? ministry) =>
        Send(new(OnlineCommandType.SetDecks, Decks: [Empty(artifact), Empty(ministry)]));

    private Task DrawDecksAsync() => Send(new(OnlineCommandType.SetDecks, Flag: true));

    private static string? Empty(string? id) => string.IsNullOrEmpty(id) ? null : id;

    // ---- Decks ----

    private readonly HashSet<string> _backs = new();      // hostile profiles shown from the back (instinct)

    private void Flip(string hostile) { if (!_backs.Remove(hostile)) _backs.Add(hostile); }

    // The player's cabal has Indra: her ability (3 last cards of the Artefact).
    private bool IndraMine => CanAct && View.Mine?.State?.Cogs.Any(c => c.CogId == CardDecks.Indra) == true;

    // Player 1 or 2 (the priority of an artefact card): their name, by the initiative.
    private string PlayerName(int player) => View.First is { } first && View.Seats.ElementAtOrDefault(player == 1 ? first : 1 - first) is { } s
        ? s.Name : L.Ui("online.offblock.player", player);

    private static string Src(string image) => Olomoc.Assets.Base + image;

    private RenderFragment Ministry(string id) => __builder =>
    {
        if (CardDecks.Ministry(id) is not { } card) return;
        <figure class="offblock-card ministry" title="@card.Name">
            <img src="@Src(CardDecks.Image(card.Id))" alt="@card.Name" loading="lazy" />
            <figcaption>@card.Name · @(card.Slot is { } slot ? L.Ui("online.offblock.slot", slot) : L.Ui("online.offblock.anySlot"))</figcaption>
        </figure>
    };

    // An artefact card: its image is a landscape card stored upright, shown turned.
    private RenderFragment Artifact(ArtifactCard card, bool large) => __builder =>
    {
        <figure class="offblock-card artifact @(large ? "large" : null)" title="@card.Name @card.Number">
            @if (card.Source is not null)
            {
                <div class="offblock-turn"><img src="@Src(CardDecks.Image(card.Id))" alt="@card.Name" loading="lazy" /></div>
            }
            else
            {
                <div class="offblock-noimage">@card.Name</div>
            }
            <figcaption>@card.Name · @(card.Number ?? "?")</figcaption>
        </figure>
    };
}
