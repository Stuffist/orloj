@page "/online/g/{Code}"
@implements IAsyncDisposable
@inject LocalizationService L
@inject CatalogService Catalog
@inject OnlineConnection Hub
@inject MySide Side
@inject MyGames Games
@inject GameStore Current
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Online game: joined with one's seat token (link received, kept on the device), or without a
   token as a spectator. Each change announced by the server makes the view be read again. The
   player's side is tracked locally (GameSession) and each change goes to the server with the
   revision it starts from; if refused (outdated state…), the server's view is taken back. *@

@if (!_ready)
{
    <p class="loading">@(L.Loaded ? L.Ui("app.loading") : "…")</p>
}
else if (_view is not { } v)
{
    <section class="panel">
        <p class="export-warning" role="alert">@L.Ui($"online.error.{_error ?? "network"}")</p>
        <a class="btn" href="builder/play">@L.Ui("online.home")</a>
    </section>
}
else
{
    <section class="panel online-head">
        <div>
            <h2>@L.Ui("online.game.title", v.Code) <ScenarioTag Scenario="v.Agenda" /></h2>
            <p class="tn-meta">
                @L.Ui($"online.step.{v.Step}")
                @if (v.Step is OnlineStep.Cycle)
                {
                    <span> · @L.Ui("online.cycle", Math.Min(v.Cycle, GameSession.Cycles), GameSession.Cycles)</span>
                }
                @if (v.First is { } first)
                {
                    <span> · @L.Ui("online.first", v.Seats[first].Name)</span>
                }
                @if (v.Me is null)
                {
                    <span class="online-badge">@L.Ui("online.spectator")</span>
                }
            </p>
            @if (v.Tournament is { } tr)
            {
                <p class="tn-meta">
                    <a href="pairings/t/@tr.Code">@L.Ui("online.tournament", tr.Code, tr.Round, tr.Table)</a>
                </p>
            }
            @if (v.Step is OnlineStep.Cycle or OnlineStep.Finished)
            {
                var hunt = SharedHunt(v);
                var mine = v.Me is not null && Side.Session is not null && v.Step == OnlineStep.Cycle;
                <div class="play-counters online-hunt">
                    <div class="counter hunt @(hunt >= GameSession.MaxHunt ? "lost" : null)" title="@L.Ui("online.hunt.title")">
                        <span class="counter-label">@L.Ui("play.hunt")</span>
                        <span class="counter-track">
                            @if (mine) { <button class="step" @onclick="() => AdjustHuntAsync(-1)" disabled="@(Side.Session!.State.Hunt == 0)" title="@L.Ui("online.hunt.minus")" aria-label="@L.Ui("play.hunt") −">−</button> }
                            <TokenTrack Token="hunt" Count="hunt" Max="GameSession.MaxHunt" />
                            @if (mine) { <button class="step" @onclick="() => AdjustHuntAsync(1)" disabled="@(hunt >= GameSession.MaxHunt)" aria-label="@L.Ui("play.hunt") +">+</button> }
                        </span>
                    </div>
                </div>
            }
        </div>
        <ScenarioBox View="v" Send="SendAsync" />
        <div class="online-head-tools">
            @if (Hub.Status != Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected)
            {
                <span class="export-warning">@L.Ui("online.reconnecting")</span>
            }
            <div class="tn-share" title="@L.Ui("online.watch.help")">
                <span class="online-label">@L.Ui("online.watch")</span>
                <code>@WatchLink</code>
                <button class="btn small" type="button" @onclick="() => CopyAsync(WatchLink)">@L.Ui("online.copy")</button>
            </div>
            @if (v.Me is not null && v.Step != OnlineStep.Lobby && v.Result is null)
            {
                <button class="btn small danger" type="button" title="@L.Ui("online.restart.title")" @onclick="RestartAsync">↺ @L.Ui("online.restart")</button>
            }
            @if (IsCurrent)
            {
                <button class="btn small @(v.Over ? "primary" : null)" type="button" title="@L.Ui("online.leave.title")" @onclick="LeaveAsync">@L.Ui("online.leave")</button>
            }
        </div>
    </section>

    <Problems Items="_problems" />
    <Problems Items="Side.Problems" />

    @switch (v.Step)
    {
        case OnlineStep.Lobby:
            <LobbyPanel View="v" Send="SendAsync" InviteLink="@InviteLink" Copy="CopyAsync" />
            break;
        case OnlineStep.Initiative or OnlineStep.Agenda:
            <SetupPanel View="v" Send="SendAsync" />
            @Table(v)
            @OffBlock(v)
            break;
        default:
            @if (v.Over)
            {
                <section class="panel online-over">
                    <h2>@L.Ui("online.over.title")</h2>
                    <p class="online-score">
                        @v.Seats[0].Name <strong>@v.Seats[0].State?.VictoryPoints</strong> – <strong>@v.Seats[1].State?.VictoryPoints</strong> @v.Seats[1].Name
                    </p>
                    @foreach (var seat in v.Seats.Where(s => s.State is { Bile: >= GameSession.MaxBile }))
                    {
                        <p class="export-warning">@L.Ui("online.over.lost", seat.Name)</p>
                    }
                    @if (v.Hunt >= GameSession.MaxHunt)
                    {
                        <p class="hint">@L.Ui("online.over.hunted")</p>
                    }
                    <ResultBox View="v" Send="SendAsync" />
                </section>
            }
            @Table(v)
            @OffBlock(v)
            @Camps(v)
            break;
    }

    <GameLog View="v" Open="@(v.Step != OnlineStep.Cycle)" />
}

@code {
    [Parameter] public string Code { get; set; } = "";

    private bool _ready;
    private string? _error;
    private OnlineView? _view;
    private IReadOnlyList<Problem>? _problems;
    private MyGame? _entry;

    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnLanguageChanged;
        Side.Changed += OnSideChanged;
        await L.EnsureLoadedAsync();
        await Catalog.EnsureLoadedAsync();
        await Games.EnsureLoadedAsync();

        // Token received in the link (#token): kept on the device, then removed from the address.
        var fragment = new Uri(Nav.Uri).Fragment.TrimStart('#');
        if (fragment.Length > 0)
        {
            await Games.RememberAsync(Code, token: fragment, title: L.Ui("online.game.title", Code.ToUpperInvariant()));
            Nav.NavigateTo($"online/g/{Code}", replace: true);
        }
        _entry = Games.Get(Code);

        Hub.Changed += OnServerChanged;
        Hub.StatusChanged += OnStatusChanged;
        var joined = await Hub.JoinAsync(Code, _entry?.Token);
        _error = joined.Error;
        if (joined.View is { } view)
        {
            Apply(view, force: true);
            if (_entry is not null) await Games.RememberAsync(Code);
            await NameSeatAsync();
            // Player of this game, without a game in progress on the device: it becomes the current
            // game (Play tab). A local game is never replaced without asking.
            await Current.EnsureLoadedAsync();
            if (view.Me is not null && !Current.HasGame) await Current.OpenOnlineAsync(Code);
        }
        _ready = true;
    }

    // The device's current game: "Leave the game" removes it from the Play tab (it stays on the
    // server, and in "My online games" to resume it).
    private bool IsCurrent => string.Equals(Current.OnlineCode, Code, StringComparison.OrdinalIgnoreCase);

    // "Hors Bloc" (scenario…): in the page, or detached into its own window (another screen).
    private bool _offBlockDetached;

    private async Task DetachOffBlockAsync()
    {
        if (await JS.InvokeAsync<bool>("olomoc.openWindow", $"online/g/{Code}/offblock?window=true", $"olomoc-offblock-{Code}", 900, 900))
            _offBlockDetached = true;
    }

    private RenderFragment OffBlock(OnlineView v) => __builder =>
    {
        if (_offBlockDetached)
        {
            <section class="panel tb-detached">
                <span>@L.Ui("online.offblock.detached")</span>
                <button class="btn small" type="button" @onclick="() => _offBlockDetached = false">@L.Ui("online.table.bringBack")</button>
            </section>
        }
        else
        {
            <OffBlockPanel View="v" Send="SendAsync">
                <HeadContent>
                    <button class="btn small" type="button" title="@L.Ui("online.offblock.detach.title")" @onclick="DetachOffBlockAsync">@L.Ui("equipment.detach")</button>
                </HeadContent>
            </OffBlockPanel>
        }
    };

    // Both sides under the table: in the page, or detached into their own window (another screen),
    // where the player's side stays editable. Window blocked by the browser: they stay in the page.
    private bool _campsDetached;

    private async Task DetachCampsAsync()
    {
        if (await JS.InvokeAsync<bool>("olomoc.openWindow", $"online/g/{Code}/camps?window=true", $"olomoc-camps-{Code}", 1000, 900))
            _campsDetached = true;
    }

    private RenderFragment Camps(OnlineView v) => __builder =>
    {
        if (_campsDetached)
        {
            <section class="panel tb-detached">
                <span>@L.Ui("online.camps.detached")</span>
                <button class="btn small" type="button" @onclick="() => _campsDetached = false">@L.Ui("online.table.bringBack")</button>
            </section>
        }
        else
        {
            <CampsPanel View="v" Send="SendAsync">
                <HeadContent>
                    <button class="btn small" type="button" title="@L.Ui("online.camps.detach.title")" @onclick="DetachCampsAsync">@L.Ui("equipment.detach")</button>
                </HeadContent>
            </CampsPanel>
        }
    };

    // Table: in the page, or detached into its own window (another screen), where it can be played too.
    // Window blocked by the browser: it stays in the page.
    private bool _tableDetached;

    private async Task DetachTableAsync()
    {
        if (await JS.InvokeAsync<bool>("olomoc.openWindow", $"online/g/{Code}/table?window=true", $"olomoc-table-{Code}", 1500, 950))
            _tableDetached = true;
    }

    private RenderFragment Table(OnlineView v) => __builder =>
    {
        if (_tableDetached)
        {
            <section class="panel tb-detached">
                <span>@L.Ui("online.table.detached")</span>
                <button class="btn small" type="button" @onclick="() => _tableDetached = false">@L.Ui("online.table.bringBack")</button>
            </section>
        }
        else
        {
            <TablePanel View="v" Send="SendAsync">
                <HeadContent>
                    <button class="btn small" type="button" title="@L.Ui("online.table.detach.title")" @onclick="DetachTableAsync">@L.Ui("equipment.detach")</button>
                </HeadContent>
            </TablePanel>
        }
    };

    // Back to the lobby (names and cabals kept), after a confirmation: the setup, the mat, the cards and the sheets are lost.
    private async Task RestartAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", L.Ui("online.restart.confirm"))) return;
        await SendAsync(new(OnlineCommandType.Restart));
    }

    private async Task LeaveAsync()
    {
        await Current.LeaveOnlineAsync();
        Nav.NavigateTo("builder/play");
    }

    // Seat still without a name (guest opening their link): account name, otherwise the device's or
    // a random one; can be changed in the lobby. Tournament table: name of the registration.
    private async Task NameSeatAsync()
    {
        if (_view is not { Step: OnlineStep.Lobby, Tournament: null, Mine.Name.Length: 0 }) return;
        var result = await Hub.SendAsync(new(OnlineCommandType.SetName, await Games.DefaultNameAsync()));
        if (result.Ok) await RefreshAsync();
    }

    private string WatchLink => $"{Nav.BaseUri}online/g/{_view?.Code ?? Code}";
    private string? InviteLink => _entry?.InviteToken is { } invite ? $"{WatchLink}#{invite}" : null;

    // Shared hunt: the server's; for a player, with their share up to date (change being sent).
    private int SharedHunt(OnlineView v) =>
        v.Me is { } me && Side.Session is { } mine
            ? Math.Min(GameSession.MaxHunt, mine.State.Hunt + (v.Seats[1 - me].State?.Hunt ?? 0))
            : v.Hunt;

    // Their share of the hunt (tokens added by hand: card effect, scenario…): like a change of their side.
    private Task AdjustHuntAsync(int delta) => Side.ChangeAsync(s => s.AdjustHunt(delta));

    private void Apply(OnlineView view, bool force = false)
    {
        _view = view;
        Side.Apply(view, force);           // the player's side, taken back if it changed elsewhere
    }

    private async Task RefreshAsync(bool force = false)
    {
        if (await Hub.GetViewAsync() is { } view) Apply(view, force);
    }

    private Task OnServerChanged() => InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    private void OnStatusChanged() => InvokeAsync(StateHasChanged);

    private async Task SendAsync(OnlineCommand command)
    {
        var result = await Hub.SendAsync(command);
        _problems = result.Problems;
        await RefreshAsync(force: !result.Ok);
    }

    private async Task CopyAsync(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); }
        catch (JSException) { /* clipboard unavailable: the link stays displayed */ }
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private void OnSideChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        L.Changed -= OnLanguageChanged;
        Side.Changed -= OnSideChanged;
        Hub.Changed -= OnServerChanged;
        Hub.StatusChanged -= OnStatusChanged;
        await Hub.LeaveAsync();
    }
}
