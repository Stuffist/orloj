@namespace Olomoc.Web.Layout
@inherits LayoutComponentBase
@implements IDisposable
@inject LocalizationService L
@inject NavigationManager Nav

@* En-tête de tout le site : titre et sous-titre de la section (constructeur, tournois, en ligne), langue,
   puis le menu (AppNav). Fenêtre à part ouverte par le constructeur (?window=true) : en-tête
   compact, sans menu. *@

<PageTitle>@(L.Loaded ? L.Ui(Title) : "Orloj")</PageTitle>

<div class="app-shell@(IsWindow ? " compact" : null)">
    <header class="app-header">
        <a class="mark" href="@(Section == "online" ? "builder/play" : Section + "/")" title="@(L.Loaded ? L.Ui(Home) : null)"></a>
        <div class="app-titles">
            @if (L.Loaded)
            {
                <h1>@L.Ui(Title)</h1>
                <p class="subtitle">@L.Ui(Subtitle)</p>
            }
            else
            {
                <h1>Orloj</h1>
            }
        </div>
        <HeaderTools />
    </header>
    @if (!IsWindow)
    {
        <AppNav />
    }
    <main>@Body</main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
        await L.EnsureLoadedAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => OnChanged();

    // Adresse sans la base : « builder/play », « pairings/t/ABCDEF »…
    private string[] Segments => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Split('/', StringSplitOptions.RemoveEmptyEntries);

    // Section : « builder », « pairings » ou « online » (constructeur par défaut).
    private string Section => Segments.FirstOrDefault() is "pairings" or "online" ? Segments[0] : "builder";

    // Page du constructeur : « play », « equipment »… ; vide pour l'accueil.
    private string Page => Segments.ElementAtOrDefault(1) ?? "";

    private string Home => Section switch
    {
        "pairings" => "pairings.home",
        "online" => "online.home",
        _ => "nav.builder",
    };

    // Parties en ligne : sous l'onglet Partie, avec le titre du site (sous-titre propre).
    private string Title => Section == "pairings" ? "pairings.title" : "app.title";

    private string Subtitle => Section switch
    {
        "pairings" => "pairings.subtitle",
        "online" => "online.subtitle",
        _ => Page switch
        {
            "play" => "play.subtitle",
            "equipment" => "equipment.subtitle",
            "account" or "privacy" => "account.subtitle",
            _ => "app.subtitle",
        },
    };

    private bool IsWindow => new Uri(Nav.Uri).Query.Contains("window=true", StringComparison.Ordinal);

    public void Dispose()
    {
        L.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
