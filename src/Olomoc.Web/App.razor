@namespace Olomoc.Web

@* A single app for the whole site: pages of the builder (/builder/…), the tournaments
   (/pairings/…) and the online games (/online/…); navigating from one to another needs no reload. *@
<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="@Pages">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Page introuvable. / Page not found.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private static readonly System.Reflection.Assembly[] Pages =
    [
        typeof(Olomoc.Builder.Pages.Home).Assembly,
        typeof(Olomoc.Pairings.Pages.Index).Assembly,
        typeof(Olomoc.Online.Pages.Home).Assembly,
    ];
}
