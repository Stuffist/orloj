<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The site in the browser: a single Blazor WebAssembly app, served at the root by
       Olomoc.Server. It brings together the builder (/builder/…), the tournaments (/pairings/…)
       and the online games (/online/…), page libraries: moving from one to another needs no reload. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Olomoc.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Olomoc.Shared\Olomoc.Shared.csproj" />
    <ProjectReference Include="..\Olomoc.Builder\Olomoc.Builder.csproj" />
    <ProjectReference Include="..\Olomoc.Pairings\Olomoc.Pairings.csproj" />
    <ProjectReference Include="..\Olomoc.Online\Olomoc.Online.csproj" />
  </ItemGroup>

</Project>
