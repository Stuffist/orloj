@* Play mode: one cog of the cabal. Stats, life line (wounds, healing, correction by tapping),
   Darkness, action tokens, stunned state, abilities with a cost or limited per game. Every change
   goes through the GameSession (rules + undo), then OnChanged (save, report in a notification).
   Windows and notifications are layered over the page: the card's buttons do not move. ReadOnly
   (opponent's side in an online game): same information, controls disabled. *@
@inject LocalizationService L
@inject CatalogService Catalog

<article class="play-cog @(S.OutOfAction ? "ooa" : null)">
<fieldset class="play-cog-lock" disabled="@ReadOnly">
    <header class="play-cog-head">
        <span class="rank-badge">@(new string('★', S.Rank))</span>
        <div class="play-cog-names">
            <span class="cog-name">@L.CogName(Cog)</span>
            <span class="cog-title">@string.Join(" + ", Carried.Select(e => L.EquipmentName(e).Text))</span>
        </div>
        <span class="status-badge @StatusClass">@L.Ui($"play.status.{StatusClass}")</span>
    </header>

    <StatLine Stats="Cog.Stats" Compact="true" />

    <div class="play-hp">
        <div class="life-line play">
            @for (var i = 0; i < S.LifeLine.Count; i++)
            {
                var index = i;
                var point = S.PointAt(i);
                var marked = S.IsChecked(i);
                <button class="pip @point.ToString().ToLower() @(marked ? "marked" : null) @(point != S.LifeLine[i] ? "fortified" : null)"
                        title="@L.Ui($"hp.{point}") · @L.Ui("play.hp.toggle")" aria-pressed="@marked"
                        @onclick="() => TogglePoint(index)"></button>
            }
        </div>
        <span class="hp-count">@S.Remaining<small>/@S.LifeLine.Count</small></span>
    </div>

    <div class="play-row">
        <button class="btn" @onclick="() => Open(Panel.Wound)" disabled="@S.OutOfAction">@L.Ui("play.wounds")</button>
        <button class="btn" @onclick="() => Open(Panel.Heal)" disabled="@(S.OutOfAction || S.Marked == 0)">@L.Ui("play.heal")</button>
    </div>

    <div class="play-tracks">
        <div class="track">
            <span class="track-label">@L.Ui("play.darkness")</span>
            <button class="step" @onclick="() => Change(() => Session.AdjustDarkness(Slot, -1))" disabled="@(S.Darkness == 0)" aria-label="@L.Ui("play.darkness") −">−</button>
            <TokenTrack Token="darkness" Count="S.Darkness" Max="GameSession.MaxDarkness" />
            <button class="step" @onclick="AddDarkness" aria-label="@L.Ui("play.darkness") +">+</button>
        </div>
        <div class="track">
            <span class="track-label">@L.Ui("play.actions")</span>
            <button class="step" @onclick="() => Change(() => Session.AdjustActions(Slot, -1))" disabled="@(S.Actions == 0)" aria-label="@L.Ui("play.actions") −">−</button>
            <TokenTrack Token="action" Count="S.Actions" Max="GameSession.ActionsPerCycle" />
            <button class="step" @onclick="() => Change(() => Session.AdjustActions(Slot, 1))" disabled="@(S.Actions >= GameSession.ActionsPerCycle)" aria-label="@L.Ui("play.actions") +">+</button>
        </div>
    </div>

    <div class="play-row toggles">
        <button class="toggle @(S.Stunned ? "on" : null)" aria-pressed="@S.Stunned" @onclick="() => Change(() => Session.SetStunned(Slot, !S.Stunned))">
            <img class="pict-img" src="@(Olomoc.Assets.Base)img/icons/stunned.png" alt="" /> @L.Ui("play.stunned")
        </button>
        <button class="toggle @(S.Fortified ? "on" : null)" aria-pressed="@S.Fortified" title="@L.Ui("play.fortified.title")"
                @onclick="() => Change(() => Session.SetFortified(Slot, !S.Fortified))">
            <span class="pip r"></span> @L.Ui("play.fortified")
        </button>
    </div>

    @if (Session.CanChooseExtraEquipment(Cog))
    {
        <div class="play-extra">
            <label for="extra-@Slot">@L.Ui("play.extra", L.AbilityName(Cog, 0))</label>
            <select id="extra-@Slot" value="@(S.ExtraEquipmentId ?? "")" @onchange="OnExtraChanged">
                <option value="">@L.Ui("play.extra.none")</option>
                @* @key: the selection follows its card when the list changes (cards carried elsewhere). *@
                @foreach (var e in ExtraOptions)
                {
                    <option @key="e.Id" value="@e.Id">@L.EquipmentName(e)</option>
                }
            </select>
        </div>
    }

    @if (Tracked.Count > 0)
    {
        <ul class="play-abilities">
            @foreach (var t in Tracked)
            {
                var block = Session.CanUse(Slot, t.Key, t.Ability);
                var limit = GameSession.GameLimit(t.Ability);
                <li>
                    <span class="ability-picts row">
                        @if (t.Ability.ActionCost > 0) { <Pictogram Token="action" Count="t.Ability.ActionCost" /> }
                        @if (t.Ability.DarknessCost > 0) { <Pictogram Token="darkness" Count="t.Ability.DarknessCost" /> }
                        @if (limit is { } n) { <Pictogram Token="freq-game" Count="n" /> }
                    </span>
                    <span class="play-ability-name">@t.Name</span>
                    @if (limit is not null)
                    {
                        <span class="uses-left @(block == AbilityBlock.Exhausted ? "none" : null)" title="@L.Ui("play.usesLeft")">
                            @Session.UsesLeft(Slot, t.Key, t.Ability)/@limit
                        </span>
                    }
                    <button class="btn small" disabled="@(block != AbilityBlock.None)"
                            title="@(block == AbilityBlock.None ? null : L.Ui($"play.block.{block}"))"
                            @onclick="() => Use(t)">@L.Ui("play.use")</button>
                </li>
            }
        </ul>
    }

    <details class="play-card-text">
        <summary>@L.Ui("play.cardText")</summary>
        <AbilityList Cog="Cog" />
        @foreach (var e in Carried)
        {
            <h4>@L.EquipmentName(e)</h4>
            <AbilityList Equipment="e" />
        }
    </details>
</fieldset>
</article>

@if (_panel != Panel.None)
{
    <Sheet Title="@($"{L.Ui(_panel == Panel.Wound ? "play.wounds.title" : "play.heal.title")} — {L.CogName(Cog)}")" OnClose="Close">
        <div class="amount">
            <button class="step" @onclick="() => _amount = Math.Max(1, _amount - 1)" disabled="@(_amount <= 1)" aria-label="−">−</button>
            <span class="amount-value">@_amount</span>
            <button class="step" @onclick="() => _amount++" disabled="@(_amount >= S.LifeLine.Count)" aria-label="+">+</button>
            <span class="amount-label">@L.Ui(_panel == Panel.Wound ? "play.wound.unit" : "play.heal.unit")</span>
        </div>
        @if (_panel == Panel.Wound)
        {
            <label class="check"><input type="checkbox" @bind="_attack" /> @L.Ui("play.wound.attack")</label>
            <label class="check @(_attack ? null : "disabled")">
                <input type="checkbox" @bind="_ignoreProtection" disabled="@(!_attack)" /> @L.Ui("play.wound.ignoreProtection")
            </label>
            <p class="play-preview">→ @Describe(Session.PreviewWound(Slot, _amount, _attack, _ignoreProtection))</p>
        }
        else
        {
            <p class="play-preview">→ @L.Ui("play.result.healed", Math.Min(_amount, S.Marked))</p>
        }
        <div class="sheet-actions">
            <button class="btn" @onclick="Close">@L.Ui("play.cancel")</button>
            <button class="btn primary" @onclick="Apply">@L.Ui("play.apply")</button>
        </div>
    </Sheet>
}

@code {
    [Parameter, EditorRequired] public GameSession Session { get; set; } = default!;
    [Parameter] public int Slot { get; set; }
    [Parameter, EditorRequired] public Cog Cog { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>After each change, with its optional report (cog name included).</summary>
    [Parameter] public EventCallback<string?> OnChanged { get; set; }

    private enum Panel { None, Wound, Heal }

    private Panel _panel;
    private int _amount = 1;
    private bool _attack = true;
    private bool _ignoreProtection;

    private CogState S => Session.State.Cogs[Slot];

    private Equipment? Main => S.EquipmentId is { } id ? Catalog.EquipmentById(id) : null;
    private Equipment? Extra => S.ExtraEquipmentId is { } id ? Catalog.EquipmentById(id) : null;

    // Carried cards: equipment/boon, then optional extra card.
    private List<Equipment> Carried => new[] { Main, Extra }.OfType<Equipment>().ToList();

    // No duplicate with the cabal's cards (the current extra card stays offered).
    private List<Equipment> ExtraOptions => Catalog.ExtraEquipmentOptions(Cog,
        Session.State.Cogs.SelectMany(c => new[] { c.EquipmentId, c == S ? null : c.ExtraEquipmentId }).OfType<string>());

    private string StatusClass => S.OutOfAction ? "outOfAction" : S.Status switch
    {
        DarknessStatus.Sane => "sane",
        DarknessStatus.Tainted => "tainted",
        _ => "corrupted",
    };

    private sealed record TrackedAbility(string Key, Ability Ability, Localized Name);

    // Abilities of the cog then of its cards that have a cost or a limit per game.
    private List<TrackedAbility> Tracked =>
        Cog.Abilities.Select((a, i) => new TrackedAbility(GameSession.AbilityKey(Cog.Id, i), a, L.AbilityName(Cog, i)))
           .Concat(Carried.SelectMany(e => e.Abilities.Select((a, i) => new TrackedAbility(GameSession.AbilityKey(e.Id, i), a, L.AbilityName(e, i)))))
           .Where(t => GameSession.IsTracked(t.Ability))
           .ToList();

    private void Open(Panel panel)
    {
        _panel = panel;
        _amount = 1;
        _attack = true;
        _ignoreProtection = false;
    }

    private void Close() => _panel = Panel.None;

    private Task Report(string? message) =>
        OnChanged.InvokeAsync(message is null ? null : $"{L.CogName(Cog)} : {message}");

    private Task Change(Action action)
    {
        action();
        return Report(null);
    }

    private Task Apply()
    {
        var panel = _panel;
        Close();
        if (panel == Panel.Wound)
            return Report(Describe(Session.Wound(Slot, _amount, _attack, _ignoreProtection)));
        return Report(L.Ui("play.result.healed", Session.Heal(Slot, _amount)));
    }

    // HP tapped: report only if it has an effect (Darkness, out of action…).
    private Task TogglePoint(int index)
    {
        var o = Session.TogglePoint(Slot, index);
        return Report(o is { TaintedMarked: 0, OutOfAction: false, HuntGained: false } or null ? null : Describe(o));
    }

    private Task AddDarkness()
    {
        var bile = Session.AdjustDarkness(Slot, 1);
        return Report(bile > 0 ? L.Ui("play.result.bile", bile) : null);
    }

    private Task OnExtraChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        var extra = string.IsNullOrEmpty(id) ? null : Catalog.EquipmentById(id);
        return Session.SetExtraEquipment(Slot, Cog, Main, extra) ? Report(null) : Task.CompletedTask;
    }

    private Task Use(TrackedAbility t)
    {
        var bile = Session.State.Bile;
        if (!Session.Use(Slot, t.Key, t.Ability)) return Task.CompletedTask;
        var parts = new List<string> { L.Ui("play.result.used", t.Name) };
        if (Session.State.Bile > bile) parts.Add(L.Ui("play.result.bile", Session.State.Bile - bile));
        return Report(string.Join(" · ", parts));
    }

    private string Describe(WoundOutcome o)
    {
        var parts = new List<string> { L.Ui("play.result.marked", o.Marked) };
        if (o.Protected) parts.Add(L.Ui("play.result.protection"));
        if (o.TaintedMarked > 0) parts.Add(L.Ui("play.result.tainted", o.TaintedMarked));
        if (o.Stopped) parts.Add(L.Ui("play.result.stopped"));
        if (o.BileGained > 0) parts.Add(L.Ui("play.result.bile", o.BileGained));
        if (o.OutOfAction) parts.Add(L.Ui("play.result.outOfAction"));
        if (o.HuntGained) parts.Add(L.Ui("play.result.hunt"));
        return string.Join(" · ", parts);
    }
}
