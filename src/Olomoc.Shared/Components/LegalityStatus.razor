@* Legality of a cabal before registration: expected faction, cards not found, the builder's rules
   (the server checks again at registration). *@
@inject LocalizationService L
@inject CatalogService Catalog

@if (Faction is { Length: > 0 } && Cabal.Faction?.Code != Faction)
{
    <p class="export-warning">@L.Ui("pairings.problem.cabalFaction", L.FactionName(Faction).Text)</p>
}
else if (Issues() is { Count: > 0 } issues)
{
    <ul class="tn-problems">
        @foreach (var issue in issues)
        {
            <li>@issue</li>
        }
    </ul>
}
else
{
    <p class="tn-legal">@L.Ui("legality.legal")</p>
}

@code {
    [Parameter, EditorRequired] public CabalExport Cabal { get; set; } = default!;
    /// <summary>The player's faction, if already chosen.</summary>
    [Parameter] public string? Faction { get; set; }

    // Cards not found, then legality problems in the cabal's faction.
    private List<string> Issues()
    {
        var resolved = Catalog.Resolve(Cabal);
        if (resolved.Missing.Count > 0) return new() { L.Ui("pairings.problem.cabalMissing", string.Join(", ", resolved.Missing)) };
        return Catalog.CheckLegality(resolved.Faction, resolved.Cogs, resolved.Equipment).Issues.Select(L.Describe).ToList();
    }
}
