@* Token reserve (Darkness, action, Bile): Count tokens placed on Max slots, with the rulebook's
   icon; empty slots are faded. *@

<span class="token-track" role="img" aria-label="@Count / @Max">
    @for (var i = 0; i < Max; i++)
    {
        <img class="token @(i < Count ? "on" : "off")" src="@(Olomoc.Assets.Base)img/icons/@(Token).png" alt="" />
    }
</span>

@code {
    [Parameter, EditorRequired] public string Token { get; set; } = "";
    [Parameter] public int Count { get; set; }
    [Parameter] public int Max { get; set; }
}
