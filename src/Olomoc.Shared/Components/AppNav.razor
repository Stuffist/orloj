@* Menu du site : constructeur, partie (point si une partie est en cours ; parties en ligne comprises), tournois, statistiques,
   éditeur (éditeurs et admins), compte. Ordinateur : onglets sous l'en-tête ; téléphone : barre
   fixée en bas de l'écran, sans l'éditeur (dans « Mon compte »). Liens internes à l'app : pas de
   rechargement. Icônes d'interface (pas les pictogrammes du livre de règles). *@
@inject LocalizationService L
@inject AccountService Accounts
@inject GameStore Games
@inject NavigationManager Nav
@implements IDisposable

@if (L.Loaded)
{
    var active = Active;
    var account = Accounts.Current;
    <nav class="app-tabs" aria-label="@L.Ui("nav.label")">
        @Tab("builder", "builder/", L.Ui("nav.builder"), L.Ui("nav.builder.short"), BuilderIcon, active)
        <a class="@TabClass(active == "play", null)" href="builder/play" aria-current="@(active == "play" ? "page" : null)">
            @PlayIcon
            <span class="tab-long">@L.Ui("nav.play")</span><span class="tab-short">@L.Ui("nav.play")</span>
            @if (Games.HasGame)
            {
                <span class="tab-dot" title="@L.Ui("nav.play.inProgress")"><span class="sr-only">@L.Ui("nav.play.inProgress")</span></span>
            }
        </a>
        @Tab("pairings", "pairings/", L.Ui("nav.pairings"), L.Ui("nav.pairings"), TournamentIcon, active)
        @Tab("stats", "pairings/stats", L.Ui("nav.stats"), L.Ui("nav.stats.short"), StatsIcon, active)
        @if (account is { CanEdit: true })
        {
            @Tab("editor", "builder/admin", L.Ui("nav.editor"), L.Ui("nav.editor"), EditorIcon, active, "editor push")
        }
        @* Sur téléphone, l'éditeur passe par « Mon compte » : l'onglet du compte s'y allume. *@
        @Tab("account", "builder/account", account?.UserName ?? L.Ui("account.signIn"), L.Ui("nav.account.short"), AccountIcon, active,
            (account is { CanEdit: true } ? "" : "push") + (active == "editor" ? " also-current" : ""))
    </nav>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnChanged;
        Accounts.Changed += OnChanged;
        Games.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
        _ = Accounts.EnsureLoadedAsync();
        _ = Games.EnsureLoadedAsync();
        await L.EnsureLoadedAsync();
    }

    // Onglet de la page affichée, d'après l'adresse.
    private string Active
    {
        get
        {
            var segments = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Split('/', StringSplitOptions.RemoveEmptyEntries);
            var page = segments.ElementAtOrDefault(1) ?? "";
            return segments.FirstOrDefault() switch
            {
                "pairings" => page == "stats" ? "stats" : "pairings",
                "online" => "play",                         // parties en ligne : sous « Partie »
                "builder" => page switch
                {
                    "play" => "play",
                    "account" or "privacy" => "account",
                    "admin" => "editor",
                    _ => "builder",
                },
                _ => "",
            };
        }
    }

    private static RenderFragment Tab(string name, string href, string label, string shortLabel, MarkupString icon, string active, string? extra = null) =>
        @<a class="@TabClass(name == active, extra)" href="@href" aria-current="@(name == active ? "page" : null)">
            @icon
            <span class="tab-long">@label</span><span class="tab-short">@shortLabel</span>
        </a>;

    private static string TabClass(bool current, string? extra) =>
        string.Join(' ', new[] { "app-tab", current ? "current" : null, extra?.Trim() }.Where(c => !string.IsNullOrEmpty(c)));

    private const string Svg = "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">";

    // Cartes empilées (cabale), dé (partie), coupe (tournois), barres (statistiques), crayon (éditeur), silhouette (compte).
    private static readonly MarkupString BuilderIcon = new(Svg + "<rect x=\"3.5\" y=\"6.5\" width=\"11\" height=\"14\" rx=\"2\"/><path d=\"M8 3.5h10a2 2 0 0 1 2 2V17\"/></svg>");
    private static readonly MarkupString PlayIcon = new(Svg + "<rect x=\"3.5\" y=\"3.5\" width=\"17\" height=\"17\" rx=\"3.5\"/><circle class=\"pip\" cx=\"8.5\" cy=\"8.5\" r=\"1.4\"/><circle class=\"pip\" cx=\"12\" cy=\"12\" r=\"1.4\"/><circle class=\"pip\" cx=\"15.5\" cy=\"15.5\" r=\"1.4\"/></svg>");
    private static readonly MarkupString TournamentIcon = new(Svg + "<path d=\"M7 4h10v5a5 5 0 0 1-10 0z\"/><path d=\"M17 5.5h3V7a3 3 0 0 1-3 3M7 5.5H4V7a3 3 0 0 0 3 3M12 14v4M8 20.5h8\"/></svg>");
    private static readonly MarkupString StatsIcon = new(Svg + "<path d=\"M3.5 20.5h17M6.5 20.5v-7M12 20.5v-13M17.5 20.5v-9\"/></svg>");
    private static readonly MarkupString EditorIcon = new(Svg + "<path d=\"M4 20h4L19 9l-4-4L4 16z\"/><path d=\"M13 7l4 4\"/></svg>");
    private static readonly MarkupString AccountIcon = new(Svg + "<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4.5 20.5a7.5 7.5 0 0 1 15 0\"/></svg>");

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => OnChanged();

    public void Dispose()
    {
        L.Changed -= OnChanged;
        Accounts.Changed -= OnChanged;
        Games.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
