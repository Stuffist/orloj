@* The four stats of a cog (rulebook p.15), with the rulebook's icons. Compact: icon + value
   (lists); otherwise icon, value and three-letter code. The code stays in the DOM in compact mode
   for screen readers. *@
@inject LocalizationService L

<div class="stat-line@(Compact ? " compact" : "")">
    @foreach (var (stat, value) in Items)
    {
        <span class="stat@(value == 0 ? " zero" : "")" title="@L.StatName(stat) : @value">
            <span class="icon stat-icon @LocalizationService.StatKey(stat)" aria-hidden="true"></span>
            <span class="stat-value">@value</span>
            <span class="stat-abbr@(Compact ? " sr-only" : "")">@L.StatAbbr(stat)</span>
        </span>
    }
</div>

@code {
    [Parameter, EditorRequired] public Stats Stats { get; set; } = default!;
    [Parameter] public bool Compact { get; set; }

    private IEnumerable<(StatKind Stat, int Value)> Items => new[]
    {
        (StatKind.Tech,   Stats.Tech),
        (StatKind.Melee,  Stats.Melee),
        (StatKind.Ranged, Stats.Ranged),
        (StatKind.Dodge,  Stats.Dodge),
    };
}
