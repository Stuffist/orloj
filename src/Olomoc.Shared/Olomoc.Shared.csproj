<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Commun au constructeur, aux appariements et au serveur : modèles, règles (légalité,
       mode partie, exports), composants d'affichage des cartes, et fichiers statiques
       (référentiel, langues, pictogrammes, styles), servis sous _content/Olomoc.Shared/. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Olomoc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.32" />
  </ItemGroup>

</Project>
