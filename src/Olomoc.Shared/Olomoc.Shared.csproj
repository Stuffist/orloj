<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Shared by the builder, the pairings and the server: models, rules (legality, play mode,
       exports), card display components, and static files (card catalog, languages,
       pictograms, styles), served under _content/Olomoc.Shared/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Olomoc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
  </ItemGroup>

</Project>
