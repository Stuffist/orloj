@namespace Olomoc.Builder.Shared
@implements IDisposable
@inject CatalogService Catalog
@inject LocalizationService L

@* Catalogue des équipements et dons : en bas du constructeur, et seul dans la fenêtre détachée
   (page /equipment). Tout le catalogue, ou seulement ce que la cabale en cours peut équiper
   (case à cocher). Référentiel et textes déjà chargés. *@

@{
    // Sans faction ni rouage, rien à quoi comparer : la case est désactivée.
    var equipable = Catalog.EquipableByCabal(CabalCogs, CabalEquipment, CabalFaction);
    var groups = EquipmentBrowser.Browse(Catalog, L, _group is "" ? null : _group, _search, _sort,
                                         _onlyEquipable ? equipable : null);
    var count = groups.Sum(g => g.Items.Count);
}

<div class="filters">
    <div class="field">
        <label for="equip-group">@L.Ui("equipment.group")</label>
        <div class="with-emblem">
            <Emblem Ministry="@EquipmentBrowser.GroupMinistry(_group)" Faction="@EquipmentBrowser.GroupFaction(_group)" />
            <select id="equip-group" class="emblem-select" value="@_group" @onchange="e => _group = e.Value?.ToString() ?? string.Empty">
                <option value="">@L.Ui("equipment.group.all")</option>
                <optgroup label="@L.Ui("equipment.ministries")">
                    @foreach (var m in Catalog.Catalog.Ministries)
                    {
                        <option value="@m.Code"><Emblem Ministry="@m.Code" />@L.MinistryName(m.Code)</option>
                    }
                </optgroup>
                <optgroup label="@L.Ui("equipment.factions")">
                    <option value="@EquipmentBrowser.Factions">@L.Ui("equipment.factions.all")</option>
                    @foreach (var f in Catalog.AllFactions.Where(f => Catalog.Catalog.Equipment.Any(e => e.Faction == f.Code)))
                    {
                        <option value="@(EquipmentBrowser.FactionPrefix + f.Code)"><Emblem Faction="@f.Code" />@L.FactionName(f.Code)</option>
                    }
                </optgroup>
            </select>
        </div>
    </div>
    <div class="field grow">
        <label for="equip-search">@L.Ui("filter.search")</label>
        <input id="equip-search" type="text" placeholder="@L.Ui("equipment.search.placeholder")" value="@_search"
               @oninput="e => _search = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="field equip-sort">
        <label>@L.Ui("equipment.sort")</label>
        <div class="export-modes" role="group" aria-label="@L.Ui("equipment.sort")">
            @foreach (var sort in Enum.GetValues<EquipmentSort>())
            {
                <button class="@(_sort == sort ? "active" : null)" aria-pressed="@(_sort == sort ? "true" : "false")"
                        @onclick="() => _sort = sort">@L.Ui($"equipment.sort.{sort}")</button>
            }
        </div>
    </div>
    <div class="field">
        <label>@L.Ui("equipment.cabal")</label>
        <label class="check@(equipable is null ? " disabled" : null)" title="@L.Ui(equipable is null ? "equipment.onlyEquipable.empty" : "equipment.onlyEquipable.title")">
            <input type="checkbox" checked="@(_onlyEquipable && equipable is not null)" disabled="@(equipable is null)"
                   @onchange="e => _onlyEquipable = e.Value is true" />
            @L.Ui("equipment.onlyEquipable")
        </label>
    </div>
</div>

<p class="equip-count" role="status">@L.Ui("equipment.count", count)</p>
@if (count == 0)
{
    <p class="empty">@L.Ui("equipment.none")</p>
}

@foreach (var group in groups)
{
    <div class="equip-group">
        @if (_sort == EquipmentSort.Ministry)
        {
            <h3><Emblem Ministry="@EquipmentBrowser.GroupMinistry(group.Key)" Faction="@EquipmentBrowser.GroupFaction(group.Key)" />@EquipmentBrowser.GroupTitle(group.Key, L)</h3>
        }
        <div class="equip-catalog">
            @foreach (var e in group.Items)
            {
                var name = L.EquipmentName(e);
                <article class="equip-entry">
                    <div class="equip-entry-head">
                        <div>
                            <div class="cog-name">@Text(name)</div>
                            <div class="cog-min emblem-name"><Emblem Ministry="@e.Ministry" Faction="@e.Faction" />@L.EquipmentAffiliation(e)</div>
                        </div>
                        <button class="btn small" @onclick="() => _shown = e" title="@L.Ui("equipment.showCard")">@L.Ui("equipment.card")</button>
                    </div>
                    @if (e.LifeLinePrefix.Count > 0)
                    {
                        <div class="life-line" title="@L.Ui("equipment.lifeLinePrefix")">
                            @foreach (var hp in e.LifeLinePrefix)
                            {
                                <span class="pip @hp.ToString().ToLower()" title="@L.Ui($"hp.{hp}")"></span>
                            }
                        </div>
                    }
                    <AbilityList Equipment="e" />
                </article>
            }
        </div>
    </div>
}

@if (_shown is { } shown)
{
    <Sheet Title="@L.EquipmentName(shown).Text" OnClose="() => _shown = null">
        <img class="card-full" src="@CardSheet.ImagePath(shown.Id)" alt="@L.EquipmentName(shown).Text" />
        <p class="cog-min emblem-name"><Emblem Ministry="@shown.Ministry" Faction="@shown.Faction" />@L.EquipmentAffiliation(shown)</p>
    </Sheet>
}

@code {
    private string _group = "";
    private string _search = "";
    private EquipmentSort _sort = EquipmentSort.Ministry;
    private Equipment? _shown;                     // carte affichée en grand
    private bool _onlyEquipable;                   // seulement ce que la cabale peut équiper

    // Cabale en cours (index 0 => rang 1) : celle du constructeur, ou celle qu'il publie pour la
    // fenêtre détachée. Vide : pas de filtre possible.
    [Parameter] public IReadOnlyList<Cog?> CabalCogs { get; set; } = new Cog?[3];
    [Parameter] public IReadOnlyList<Equipment?> CabalEquipment { get; set; } = new Equipment?[3];
    [Parameter] public string? CabalFaction { get; set; }

    // Le composant suit lui-même la langue (la page qui l'accueille ne se redessine pas forcément).
    protected override void OnInitialized() => L.Changed += OnLanguageChanged;
    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= OnLanguageChanged;


    // Texte de carte, stylé s'il se replie sur la langue de référence faute de traduction.
    private RenderFragment Text(Localized text) => @<span class="@(text.IsFallback ? "untranslated" : null)"
                                                          title="@(text.IsFallback ? L.Ui("common.untranslated") : null)">@text.Text</span>;
}
