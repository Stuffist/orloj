@namespace Olomoc.Builder.Layout
@inherits LayoutComponentBase
@implements IDisposable
@inject LocalizationService L
@inject NavigationManager Nav

<PageTitle>@(L.Loaded ? L.Ui("app.title") : "Olomòc")</PageTitle>

<div class="app-shell@(IsWindow ? " compact" : null)">
    <header class="app-header">
        <span class="mark"></span>
        <div class="app-titles">
            @if (L.Loaded)
            {
                <h1>@L.Ui("app.title")</h1>
                <p class="subtitle">@L.Ui(Page switch { "play" => "play.subtitle", "equipment" => "equipment.subtitle", _ => "app.subtitle" })</p>
            }
            else
            {
                <h1>Olomòc</h1>
            }
        </div>
        <HeaderTools Current="@(Page == "equipment" ? "equipment" : "builder")" />
    </header>
    <main>@Body</main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
        await L.EnsureLoadedAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => OnChanged();

    // Page affichée : premier segment de l'adresse (« play », « equipment »… ; vide pour l'accueil).
    private string Page => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#', '/')[0];

    // Fenêtre à part ouverte par le constructeur (?window=true) : en-tête compact, sans navigation.
    private bool IsWindow => new Uri(Nav.Uri).Query.Contains("window=true", StringComparison.Ordinal);

    public void Dispose()
    {
        L.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
