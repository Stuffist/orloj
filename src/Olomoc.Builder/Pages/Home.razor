@page "/"
@namespace Olomoc.Builder.Pages
@implements IDisposable
@inject CatalogService Catalog
@inject LocalizationService L
@inject CabalExporter Exporter
@inject IJSRuntime JS
@inject CabalDraft Draft
@inject GameStore Games
@inject NavigationManager Nav
@inject CabalLibrary Library
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

@if (!Catalog.Loaded || !L.Loaded)
{
    <p class="loading">@(L.Loaded ? L.Ui("app.loading") : "…")</p>
}
else
{
    @* Ouvert depuis l'inscription à un tournoi (« Composer… ») : que faire de la cabale composée. *@
    @if (Tournament is { Length: > 0 } tournament)
    {
        <p class="tournament-notice" role="note">
            <span>@L.Ui("library.forTournament", tournament)</span>
            <a href="/pairings/t/@Uri.EscapeDataString(tournament)">@L.Ui("library.forTournament.back")</a>
        </p>
    }

    <div class="builder-tools">
        <button class="btn" @onclick="() => _libraryOpen = true">
            @L.Ui("library.open")
            @if (Library.Cabals.Count > 0)
            {
                <span class="count">@Library.Cabals.Count</span>
            }
        </button>
        @* Mode partie : composition complète requise ; illégale, la partie suit la composition actuelle. *@
        <button class="btn @(_cogs.Any(c => c is null) ? null : "primary")" disabled="@_cogs.Any(c => c is null)" @onclick="StartGameAsync"
                title="@L.Ui(_cogs.Any(c => c is null) ? "play.launch.incomplete" : _legality.IsLegal ? "play.launch.intro" : "play.launch.notLegal")">
            @L.Ui("play.launch.button")
        </button>
        @if (Games.Session is { } game)
        {
            <a class="btn" href="play">@L.Ui("play.launch.resumeShort", Math.Min(game.State.Cycle, GameSession.Cycles))</a>
        }
        @if (_loadNotice is not null)
        {
            <p class="load-notice" role="status">
                <span>@_loadNotice</span>
                <button class="clear" @onclick="() => _loadNotice = null" title="@L.Ui("common.remove")">✕</button>
            </p>
        }
    </div>

    @* Sauvegarde et export en tête, avec l'état de la cabale (légale ou non, et pourquoi). *@
    <section class="export">
        <div class="export-head">
            <h2>@L.Ui("export.title")</h2>
            <span class="legality-badge @(_legality.IsLegal ? "ok" : "ko")" role="status">
                @(_legality.IsLegal ? null : "⚠ ")@L.Ui(_legality.IsLegal ? "legality.legal" : "legality.illegal")
            </span>
        </div>
        @if (_legality.Issues.Count > 0)
        {
            <ul class="legality-issues">
                @foreach (var issue in _legality.Issues)
                {
                    <li>@L.Describe(issue)</li>
                }
            </ul>
        }
        <div class="export-controls">
            <div class="field grow">
                <label for="cabal-name">@L.Ui("export.name")</label>
                <input id="cabal-name" type="text" maxlength="80" value="@_cabalName" @ref="_nameInput"
                       @oninput="e => { _cabalName = e.Value?.ToString() ?? string.Empty; _nameRequired = false; }" />
            </div>
            <button class="btn primary" disabled="@_cogs.All(c => c is null)" @onclick="SaveAsync" title="@L.Ui("library.save.title")">
                @L.Ui(IsSaved() ? "library.saved" : "library.save")
            </button>
        </div>

        @if (_nameRequired)
        {
            <p class="export-warning">@L.Ui("library.nameRequired")</p>
        }
        @if (_cogs.All(c => c is null))
        {
            <p class="empty">@L.Ui("export.empty")</p>
        }
        else
        {
            var content = ExportContent();
            <div class="export-actions">
                <div class="export-modes" role="group" aria-label="@L.Ui("export.format")">
                    <button class="@(_exportJson ? null : "active")" aria-pressed="@(!_exportJson)" @onclick="() => _exportJson = false">@L.Ui("export.text")</button>
                    <button class="@(_exportJson ? "active" : null)" aria-pressed="@_exportJson" @onclick="() => _exportJson = true">JSON</button>
                </div>
                <button class="btn" @onclick="() => CopyAsync(content)">
                    @L.Ui(_copied == content ? "export.copied" : "export.copy")
                </button>
                <a class="btn" href="@DataUri(content)" download="@CabalExporter.FileName(_cabalName, _exportJson ? "json" : "txt")">
                    @L.Ui("export.download")
                </a>
                <a class="btn" href="@CardsLink" target="_blank" rel="noopener" title="@L.Ui("export.cards.title")">
                    @L.Ui("export.cards")
                </a>
            </div>
            @* Texte de l'export replié : copier / télécharger n'en ont pas besoin, et il repousserait
               les rouages vers le bas. *@
            <details class="export-preview">
                <summary>@L.Ui("export.preview")</summary>
                <textarea class="export-output" readonly rows="@Math.Min(content.Split('\n').Length, 18)"
                          value="@content" aria-label="@L.Ui("export.title")"></textarea>
            </details>
        }
    </section>

    <section class="filters">
        <div class="field">
            <label>@L.Ui("filter.faction")</label>
            @* Factions où les rouages déjà choisis n'ont pas leur place : grisées. *@
            @{ var compatible = Catalog.CompatibleFactions(_cogs); }
            <div class="with-emblem">
                <Emblem Faction="@_faction" />
                <select class="emblem-select" value="@_faction" @onchange="OnFactionChanged">
                    <option value="">@L.Ui("filter.allFactions")</option>
                    @foreach (var f in Catalog.AllFactions)
                    {
                        var possible = compatible.Contains(f.Code);
                        <option value="@f.Code" disabled="@(!possible)" title="@(possible ? null : L.Ui("filter.faction.incompatible"))"><Emblem Faction="@f.Code" />@L.FactionName(f.Code)</option>
                    }
                </select>
            </div>
        </div>

        <div class="field">
            <label>@L.Ui("filter.ministry")</label>
            <div class="with-emblem">
                <Emblem Ministry="@_ministryFilter" />
                <select class="emblem-select" value="@_ministryFilter" @onchange="e => Set(ref _ministryFilter, e)">
                    <option value="">@L.Ui("filter.allMinistries")</option>
                    @foreach (var m in Catalog.Catalog.Ministries)
                    {
                        <option value="@m.Code"><Emblem Ministry="@m.Code" />@L.MinistryName(m.Code)</option>
                    }
                </select>
            </div>
        </div>

        <div class="field grow">
            <label>@L.Ui("filter.search")</label>
            <input type="text" placeholder="@L.Ui("search.placeholder")" value="@_search"
                   @oninput="OnSearch" />
            <div class="query-help">
                @foreach (var c in _query.Conditions)
                {
                    <span class="query-chip" title="@L.Ui("search.chipTitle")">
                        <span class="icon stat-icon @c.Icon" aria-hidden="true"></span>
                        @L.StatAbbr(c.Stat) @c.OpLabel @c.Value
                        <button class="chip-remove" @onclick="() => RemoveCondition(c)" title="@L.Ui("common.remove")">✕</button>
                    </span>
                }
                @if (_query.Conditions.Count == 0)
                {
                    <span class="hint">
                        @L.Ui("search.hintStats")
                        @foreach (var stat in Enum.GetValues<StatKind>())
                        {
                            <code>@L.StatAbbr(stat).ToLowerInvariant()</code>
                        }
                        @L.Ui("search.hintFollowedBy")
                        <code>&gt;</code> <code>&lt;</code> <code>&gt;=</code> <code>&lt;=</code> <code>=</code>
                        @L.Ui("search.hintTail")
                    </span>
                }
            </div>
        </div>
    </section>

    <section class="slots">
        @foreach (var rank in new[] { 3, 2, 1 })
        {
            var idx = RankIndex(rank);
            var cog = _cogs[idx];
            <div class="slot">
                <div class="slot-head">
                    <span class="rank-badge">@Stars(rank)</span>
                    <span class="rank-label">@L.Ui("slot.rank", rank)</span>
                    @if (cog is not null)
                    {
                        <button class="clear" @onclick="() => ClearCog(idx)" title="@L.Ui("common.remove")">✕</button>
                    }
                </div>

                @if (cog is null)
                {
                    <div class="picker">
                        @* Sans faction : seulement les rouages compatibles avec ceux déjà choisis. *@
                        @{ var options = Catalog.AvailableCogs(rank, NullIfEmpty(_faction), NullIfEmpty(_ministryFilter), _query, Catalog.CompatibleFactions(_cogs)); }
                        @if (options.Count == 0)
                        {
                            <p class="empty">@L.Ui("picker.empty")</p>
                        }
                        else
                        {
                            @foreach (var c in options)
                            {
                                var via = NullIfEmpty(_faction) is { } f ? Catalog.RecruitVia(c, f) : null;
                                @* Hors faction, et sa carte de recrutement couvre déjà un autre rouage : marqué 🔃,
                                   le choisir retire cet autre rouage (échange) ; grisé si aucun échange ne suffit. *@
                                var swap = Catalog.CogConflict(idx, c, _cogs, NullIfEmpty(_faction));
                                var blocked = swap is { Displaced.Count: 0 };
                                <button class="cog-option@(swap is not null && !blocked ? " swap" : null)" disabled="@blocked" @onclick="() => SelectCog(idx, c)">
                                    <span class="cog-option-head">
                                        <span class="cog-name">@Text(L.CogName(c))</span>
                                        @* Factions dont le rouage est membre (les recrutements par carte sont sur sa fiche). *@
                                        <span class="cog-option-factions">
                                            @foreach (var fit in Catalog.FactionsOf(c).Where(x => x.Member))
                                            {
                                                <Emblem Faction="@fit.Faction" Title="@L.FactionName(fit.Faction).Text" />
                                            }
                                        </span>
                                    </span>
                                    <span class="cog-title">@Text(L.CogTitle(c))</span>
                                    <span class="cog-min emblem-names">@foreach (var m in c.Ministries) { <span class="emblem-name"><Emblem Ministry="@m" />@L.MinistryName(m)</span> }</span>
                                    <StatLine Stats="c.Stats" Compact="true" />
                                    @if (blocked)
                                    {
                                        <span class="cog-via">@(via is not null ? L.Ui("picker.recruitUsed", L.EquipmentName(via)) : L.Ui("picker.incompatible"))</span>
                                    }
                                    else if (swap is not null)
                                    {
                                        var replaced = string.Join(", ", swap.Displaced.Select(d => L.CogName(_cogs[d]!).Text));
                                        <span class="cog-via">@(via is not null ? L.Ui("picker.swapVia", L.EquipmentName(via), replaced) : L.Ui("picker.swap", replaced))</span>
                                    }
                                    else if (via is not null)
                                    {
                                        <span class="cog-via">@L.Ui("picker.recruitVia", L.EquipmentName(via))</span>
                                    }
                                </button>
                            }
                        }
                    </div>
                }
                else
                {
                    var current = _equipment[idx];
                    <div class="cog-card">
                        <div>
                            <div class="cog-name">@Text(L.CogName(cog))</div>
                            <div class="cog-title">@Text(L.CogTitle(cog))</div>
                            <div class="cog-min emblem-names">@foreach (var m in cog.Ministries) { <span class="emblem-name"><Emblem Ministry="@m" />@L.MinistryName(m)</span> }</div>
                        </div>
                        @{ var fits = Catalog.FactionsOf(cog); }
                        <div class="cog-factions">
                            <span class="cog-factions-label">@L.Ui("cog.factions")</span>
                            <span class="emblem-names">
                                @foreach (var fit in fits.Where(x => x.Member))
                                {
                                    <span class="emblem-name"><Emblem Faction="@fit.Faction" />@L.FactionName(fit.Faction)</span>
                                }
                            </span>
                            @if (fits.Any(x => !x.Member))
                            {
                                <span class="cog-factions-label">@L.Ui("cog.factionsVia")</span>
                                <span class="emblem-names">
                                    @foreach (var fit in fits.Where(x => !x.Member))
                                    {
                                        <span class="emblem-name via"><Emblem Faction="@fit.Faction" />@L.Ui("cog.factionVia", L.FactionName(fit.Faction).Text, L.EquipmentName(fit.Via!).Text)</span>
                                    }
                                </span>
                            }
                        </div>
                        <StatLine Stats="cog.Stats" />
                        <div class="life-line">
                            @foreach (var hp in cog.LifeLine)
                            {
                                <span class="pip @hp.ToString().ToLower()" title="@L.Ui($"hp.{hp}")"></span>
                            }
                        </div>
                        <AbilityList Cog="cog" />

                        <div class="equipment-zone">
                            <label>@L.Ui("cog.equipment")</label>
                            @{
                                // Rangés par Ministère / faction, puis par nom : la liste et ‹ › suivent cet ordre.
                                var available = EquipmentBrowser.Ordered(Catalog.AvailableEquipment(idx, _cogs, _equipment, NullIfEmpty(_faction)), Catalog, L);
                                var position = current is null ? -1 : available.FindIndex(e => e.Id == current.Id);
                                // Déjà « pris » par le reste de la cabale (même carte, Ministère épuisé) : marqué 🔃,
                                // le choisir retire la carte en conflit à l'autre rouage (échange, en infobulle).
                                var conflicts = available.Select(e => e.Id == current?.Id ? null : Catalog.EquipmentConflict(idx, e, _cogs, _equipment)).ToArray();
                                var conflictOf = available.Select((e, k) => (e.Id, Conflict: conflicts[k])).ToDictionary(x => x.Id, x => x.Conflict);
                                var previous = Neighbor(conflicts, position, -1);
                                var next = Neighbor(conflicts, position, +1);
                            }
                            @* ‹ › choisit directement la carte voisine sans échange : son effet s'affiche aussitôt dessous. *@
                            <div class="equip-stepper">
                                <button class="step" disabled="@(previous < 0)" title="@L.Ui("equipment.previous")" aria-label="@L.Ui("equipment.previous")"
                                        @onclick="() => SelectEquipment(idx, available[previous])">‹</button>
                                <select value="@current?.Id" @onchange="e => SelectEquipment(idx, e)">
                                    <option value="">@L.Ui("common.choose")</option>
                                    @foreach (var group in EquipmentBrowser.Grouped(available))
                                    {
                                        <optgroup label="@GroupLabel(group.Key, idx)">
                                            @foreach (var eq in group.Items)
                                            {
                                                var conflict = conflictOf[eq.Id];
                                                <option value="@eq.Id" title="@(conflict is null ? null : SwapTitle(conflict))">@(conflict is null ? null : "🔃 ")@L.EquipmentName(eq) · @L.EquipmentAffiliation(eq)</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                <button class="step" disabled="@(next < 0)" title="@L.Ui("equipment.next")" aria-label="@L.Ui("equipment.next")"
                                        @onclick="() => SelectEquipment(idx, available[next])">›</button>
                            </div>
                            @if (available.Count > 0)
                            {
                                <span class="equip-position">@(position + 1) / @available.Count</span>
                            }
                            @if (_swapNote is { } note && note.Slot == idx)
                            {
                                <p class="swap-note">@note.Text</p>
                            }
                            @if (current is not null)
                            {
                                <AbilityList Equipment="current" />
                            }
                            @if (available.Count == 0)
                            {
                                <p class="empty">@L.Ui("cog.noEquipment")</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @* Catalogue de tous les équipements et dons, indépendant de la cabale ; détachable dans une
       petite fenêtre à poser à côté (il se replie alors ici). *@
    <section class="equip-section">
        <div class="equip-section-head">
            <h2>@L.Ui("equipment.section")</h2>
            <button class="btn small" aria-expanded="@(_equipShown ? "true" : "false")" @onclick="() => _equipShown = !_equipShown">
                @L.Ui(_equipShown ? "equipment.hide" : "equipment.show")
            </button>
            <button class="btn small" @onclick="DetachEquipmentAsync" title="@L.Ui("equipment.detach.title")">@L.Ui("equipment.detach")</button>
        </div>
        @if (_equipShown)
        {
            <EquipmentPanel />
        }
    </section>

    @if (_libraryOpen)
    {
        <Sheet Title="@L.Ui("library.title")" OnClose="() => _libraryOpen = false">
            @if (Library.Cabals.Count == 0)
            {
                <p class="empty">@L.Ui("library.empty")</p>
            }
            <ul class="saved-cabals">
                @foreach (var saved in Library.Cabals)
                {
                    var cabal = saved.Cabal;
                    <li class="saved-cabal">
                        <div class="saved-head">
                            <span class="cog-name">@cabal.Name</span>
                            <span class="saved-meta">@if (cabal.Faction is { } f) { <span class="emblem-name"><Emblem Faction="@f.Code" />@FactionLabel(f)</span>@(" · ") }@SavedDate(saved.SavedAt)</span>
                        </div>
                        <ul class="saved-slots">
                            @foreach (var slot in cabal.Cogs.OrderByDescending(x => x.Rank))
                            {
                                <li>
                                    <span class="stars">@Stars(slot.Rank)</span>
                                    @CogLabel(slot.Cog)@(slot.Equipment is { } e ? " · " + EquipmentLabel(e) : null)
                                </li>
                            }
                        </ul>
                        <div class="saved-actions">
                            <button class="btn small primary" @onclick="() => LoadAsync(cabal)">@L.Ui("library.load")</button>
                            <button class="btn small danger" @onclick="() => DeleteAsync(saved)">@L.Ui("library.delete")</button>
                        </div>
                    </li>
                }
            </ul>
            <div class="library-import">
                <label class="btn">
                    @L.Ui("library.import")
                    <InputFile accept=".json,application/json" OnChange="ImportAsync" />
                </label>
                <span class="hint">@L.Ui("library.import.hint")</span>
                @if (_importError)
                {
                    <p class="export-warning">@L.Ui("library.import.error")</p>
                }
            </div>
        </Sheet>
    }
}

@code {
    // Composition conservée par CabalDraft : on la retrouve en revenant du mode partie.
    private string _faction { get => Draft.Faction; set => Draft.Faction = value; }
    private string _ministryFilter = "";
    private string _search = "";
    private CogQuery _query = CogQuery.Empty;
    private IReadOnlyDictionary<string, StatKind> _keywords = new Dictionary<string, StatKind>();

    // index 0 => rang 1, index 1 => rang 2, index 2 => rang 3
    private Cog?[] _cogs => Draft.Cogs;
    private Equipment?[] _equipment => Draft.Equipment;
    private LegalityResult _legality = new(false, new[] { new LegalityIssue("start") });

    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnLanguageChanged;
        await L.EnsureLoadedAsync();
        await Catalog.EnsureLoadedAsync();
        await Games.EnsureLoadedAsync();
        await Library.EnsureLoadedAsync();
        _keywords = L.StatKeywords();
        // Faction choisie à l'inscription au tournoi, si rien n'est encore composé.
        if (FactionParam is { } f && _cogs.All(c => c is null) && Catalog.AllFactions.Any(x => x.Code == f)) _faction = f;
        Recompute();
    }

    // Ouverture depuis l'inscription à un tournoi : /builder/?tournament=CODE&faction=MAISEL
    [SupplyParameterFromQuery(Name = "tournament")] public string? Tournament { get; set; }
    [SupplyParameterFromQuery(Name = "faction")] public string? FactionParam { get; set; }

    // Les textes se résolvent au rendu : un changement de langue ne demande qu'un re-rendu.
    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnLanguageChanged;

    private static int RankIndex(int rank) => rank - 1;

    // ‹ › : indice de la carte voisine (step = -1 ou +1) qui se choisit sans échange ; -1 s'il
    // n'y en a pas. Faire défiler ne retire jamais la carte d'un autre rouage.
    private static int Neighbor(Swap?[] conflicts, int position, int step)
    {
        for (var k = position + step; k >= 0 && k < conflicts.Length; k += step)
            if (conflicts[k] is null) return k;
        return -1;
    }

    // Titre d'une catégorie de la liste d'équipement ; pour un Ministère, combien la cabale peut
    // encore en prendre (la carte de ce rouage mise à part, puisqu'on la remplacerait).
    private string GroupLabel(string key, int idx) =>
        EquipmentBrowser.GroupMinistry(key) is { } m
            ? $"{EquipmentBrowser.GroupTitle(key, L)} · {L.Ui("equipment.remaining", Catalog.MinistryRemaining(idx, m, _cogs, _equipment))}"
            : EquipmentBrowser.GroupTitle(key, L);

    // Infobulle d'une option 🔃 : ce que l'échange retirerait, et pourquoi.
    private string SwapTitle(Swap swap) =>
        swap.Displaced.Count == 0
            ? L.Ui("equipment.swap.none")
            : L.Ui(swap.Reason, SwapVictims(swap));

    // « Carte (Rouage) » de chaque emplacement qui perdrait sa carte.
    private string SwapVictims(Swap swap) =>
        string.Join(", ", swap.Displaced.Select(d => L.Ui("equipment.swapVictim", L.EquipmentName(_equipment[d]!).Text, L.CogName(_cogs[d]!).Text)));

    // Dernier échange fait par la liste d'un rouage : rappelé sous cette liste jusqu'au choix suivant.
    private (int Slot, string Text)? _swapNote;

    private void OnFactionChanged(ChangeEventArgs e)
    {
        _faction = e.Value?.ToString() ?? "";
        // Seules les factions compatibles sont proposées : les rouages restent ; les cartes de
        // l'ancienne faction, elles, peuvent ne plus être disponibles.
        PruneEquipment();
        Recompute();
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _query = CogQuery.Parse(_search, _keywords);
    }

    private void RemoveCondition(StatCondition c)
    {
        _search = CogQuery.Without(_search, c);
        _query = CogQuery.Parse(_search, _keywords);
    }

    private void Set(ref string field, ChangeEventArgs e)
    {
        field = e.Value?.ToString() ?? "";
        Recompute();
    }

    private void SelectCog(int idx, Cog c)
    {
        // Rouage marqué 🔃 : l'autre rouage dont il prend la carte de recrutement est retiré (échange).
        var notes = new List<string>();
        if (Catalog.CogConflict(idx, c, _cogs, NullIfEmpty(_faction)) is { Displaced.Count: > 0 } swap)
        {
            notes.Add(L.Ui("picker.swapped", string.Join(", ", swap.Displaced.Select(d => L.CogName(_cogs[d]!).Text))));
            foreach (var d in swap.Displaced)
            {
                _cogs[d] = null;
                _equipment[d] = null;
            }
        }
        _cogs[idx] = c;
        _equipment[idx] = null;             // les Ministères présents changent : on réévalue les équipements/dons
        // Sans faction choisie, une seule encore possible : on la prend.
        if (NullIfEmpty(_faction) is null && Catalog.CompatibleFactions(_cogs) is [var only]) _faction = only;
        PruneEquipment();
        // Hors faction et pas encore couvert : la carte qui le recrute, équipée d'office (et retirée
        // au rouage qui la portait sans en profiter, s'il y en a un).
        _swapNote = null;
        if (NullIfEmpty(_faction) is { } f && Catalog.RecruitCard(idx, _cogs, _equipment, f) is { } card)
        {
            SelectEquipment(idx, card);
            notes.Add(L.Ui("picker.autoEquipped", L.EquipmentName(card).Text));
            if (_swapNote is { } moved) notes.Add(moved.Text);
        }
        _swapNote = notes.Count > 0 ? (idx, string.Join(" ", notes)) : null;
        Recompute();
    }

    private void ClearCog(int idx)
    {
        _cogs[idx] = null;
        _equipment[idx] = null;
        _swapNote = null;
        PruneEquipment();
        Recompute();
    }

    private void SelectEquipment(int idx, ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        SelectEquipment(idx, string.IsNullOrEmpty(id) ? null : Catalog.EquipmentById(id));
    }

    private void SelectEquipment(int idx, Equipment? eq)
    {
        // Choix marqué 🔃 : la carte en conflit est retirée à l'autre rouage (échange).
        _swapNote = null;
        if (eq is not null && eq.Id != _equipment[idx]?.Id && Catalog.EquipmentConflict(idx, eq, _cogs, _equipment) is { Displaced.Count: > 0 } swap)
        {
            _swapNote = (idx, L.Ui("equipment.swapped", SwapVictims(swap)));
            foreach (var d in swap.Displaced) _equipment[d] = null;
        }
        _equipment[idx] = eq;
        PruneEquipment();                   // retirer un Passe-droit peut invalider les autres équipements/dons
        Recompute();
    }

    // Retire les équipements/dons devenus indisponibles après un changement de rouage ou
    // d'équipement/don ; répété jusqu'à stabilité, un retrait pouvant en entraîner un autre.
    private void PruneEquipment()
    {
        bool changed;
        do
        {
            changed = false;
            for (int i = 0; i < 3; i++)
            {
                if (_cogs[i] is null || _equipment[i] is null) continue;
                var ok = Catalog.AvailableEquipment(i, _cogs, _equipment, NullIfEmpty(_faction)).Any(x => x.Id == _equipment[i]!.Id);
                if (!ok) { _equipment[i] = null; changed = true; }
            }
        } while (changed);
    }

    private void Recompute() => _legality = Catalog.CheckLegality(NullIfEmpty(_faction), _cogs, _equipment);

    // ---- Export ----

    private string _cabalName { get => Draft.Name; set => Draft.Name = value; }
    private bool _exportJson;
    private string? _copied;            // dernier contenu copié : le bouton l'indique tant qu'il est à jour

    private string ExportContent() => _exportJson
        ? Exporter.ToJson(_cabalName, NullIfEmpty(_faction), _cogs, _equipment)
        : Exporter.ToText(_cabalName, _cogs, _equipment);

    // Planche des cartes (impression / PDF / PNG), dans un nouvel onglet : la cabale passe dans l'adresse.
    private string CardsLink => $"cards?c={Uri.EscapeDataString(CardSheet.Encode(_cogs, _equipment))}"
        + (string.IsNullOrWhiteSpace(_cabalName) ? "" : $"&name={Uri.EscapeDataString(_cabalName.Trim())}");

    private string DataUri(string content) =>
        (_exportJson ? "data:application/json;charset=utf-8," : "data:text/plain;charset=utf-8,") + Uri.EscapeDataString(content);

    private async Task CopyAsync(string content)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", content);
            _copied = content;
        }
        catch (JSException)
        {
            // Presse-papiers indisponible (contexte non sécurisé, refus) : le texte reste sélectionnable.
            _copied = null;
        }
    }

    // ---- Sauvegarde ----

    private const long MaxImportBytes = 64 * 1024;     // un export pèse moins d'1 Ko
    private bool _libraryOpen;
    private bool _nameRequired;                        // sauvegarde demandée sans nom
    private bool _importError;
    private string? _loadNotice;                       // cartes introuvables au chargement
    private ElementReference _nameInput;

    private CabalExport CurrentCabal() => Exporter.ToModel(_cabalName, NullIfEmpty(_faction), _cogs, _equipment);

    // La composition affichée est celle sauvegardée sous son nom.
    private bool IsSaved() =>
        Library.Find(_cabalName) is { } saved && CabalLibrary.SameCards(saved.Cabal, CurrentCabal());

    private async Task SaveAsync()
    {
        var cabal = CurrentCabal();
        if (cabal.Name is null)
        {
            _nameRequired = true;
            await _nameInput.FocusAsync();
            return;
        }
        if (Library.Find(cabal.Name) is { } old && !CabalLibrary.SameCards(old.Cabal, cabal)
            && !await JS.InvokeAsync<bool>("confirm", L.Ui("library.replace", old.Cabal.Name!))) return;
        await Library.SaveAsync(cabal, DateTimeOffset.Now);
    }

    private async Task LoadAsync(CabalExport cabal)
    {
        // Composition en cours non sauvegardée : on demande avant de l'écraser.
        if (_cogs.Any(c => c is not null) && !IsSaved()
            && !await JS.InvokeAsync<bool>("confirm", L.Ui("library.loadReplace"))) return;
        var resolved = Catalog.Resolve(cabal);
        _faction = resolved.Faction ?? "";
        _cabalName = cabal.Name ?? "";
        for (int i = 0; i < 3; i++) { _cogs[i] = resolved.Cogs[i]; _equipment[i] = resolved.Equipment[i]; }
        _loadNotice = resolved.Missing.Count == 0 ? null : L.Ui("library.missing", string.Join(", ", resolved.Missing));
        _libraryOpen = false;
        _nameRequired = false;
        Recompute();
    }

    private async Task DeleteAsync(SavedCabal saved)
    {
        if (await JS.InvokeAsync<bool>("confirm", L.Ui("library.delete.confirm", saved.Cabal.Name!)))
            await Library.DeleteAsync(saved);
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        string? json = null;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxImportBytes));
            json = await reader.ReadToEndAsync();
        }
        catch (IOException) { /* fichier trop gros ou illisible */ }
        var cabal = CabalExporter.FromJson(json);
        _importError = cabal is null;
        if (cabal is not null) await LoadAsync(cabal);
    }

    // Noms dans la langue courante si la carte existe encore, sinon tels qu'enregistrés.
    private string CogLabel(IdName cog) => Catalog.CogById(cog.Id) is { } c ? L.CogName(c).Text : cog.Name;
    private string EquipmentLabel(IdName e) => Catalog.EquipmentById(e.Id) is { } x ? L.EquipmentName(x).Text : e.Name;
    private string FactionLabel(CodeName f) => Catalog.AllFactions.Any(x => x.Code == f.Code) ? L.FactionName(f.Code).Text : f.Name;

    private string SavedDate(DateTimeOffset date)
    {
        try { return date.ToLocalTime().ToString("g", CultureInfo.GetCultureInfo(L.Current)); }
        catch (CultureNotFoundException) { return date.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture); }
    }

    // ---- Catalogue des équipements ----

    private bool _equipShown = true;

    // Fenêtre à part (réutilisée si déjà ouverte) : le catalogue se replie ici. Fenêtre bloquée
    // par le navigateur : il reste affiché dans la page.
    private async Task DetachEquipmentAsync()
    {
        if (await JS.InvokeAsync<bool>("olomoc.openWindow", "equipment?window=true", "olomoc-equipment"))
            _equipShown = false;
    }

    // ---- Mode partie ----

    private async Task StartGameAsync()
    {
        if (Games.Session is not null && !await JS.InvokeAsync<bool>("confirm", L.Ui("play.launch.replace"))) return;
        await Games.StartAsync(GameSession.NewGame(_cabalName, NullIfEmpty(_faction), _cogs, _equipment));
        Nav.NavigateTo("play");
    }

    private static string? NullIfEmpty(string s) => string.IsNullOrWhiteSpace(s) ? null : s;
    private static string Stars(int rank) => new string('★', rank);

    // Texte de carte, stylé s'il se replie sur la langue de référence faute de traduction.
    private RenderFragment Text(Localized text) => @<span class="@(text.IsFallback ? "untranslated" : null)"
                                                          title="@(text.IsFallback ? L.Ui("common.untranslated") : null)">@text.Text</span>;
}
