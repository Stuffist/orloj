@page "/builder/privacy"
@namespace Olomoc.Builder.Pages
@implements IDisposable
@inject LocalizationService L

@* Personal data (GDPR): what the site keeps, why, for how long. *@

<section class="panel account-panel privacy">
    @if (L.Loaded)
    {
        <h2>@L.Ui("privacy.title")</h2>
        @foreach (var key in Paragraphs)
        {
            <p>@L.Ui(key)</p>
        }
        <p><a class="btn" href="builder/account">@L.Ui("account.title")</a></p>
    }
</section>

@code {
    private static readonly string[] Paragraphs =
        ["privacy.device", "privacy.account", "privacy.email", "privacy.tournaments", "privacy.delete"];

    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnChanged;
        await L.EnsureLoadedAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnChanged;
}
