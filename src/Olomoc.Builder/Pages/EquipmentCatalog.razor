@page "/equipment"
@namespace Olomoc.Builder.Pages
@implements IDisposable
@inject CatalogService Catalog
@inject LocalizationService L

@* Catalogue des équipements et dons seul : fenêtre détachée depuis le constructeur
   (?window=true, en-tête compact), à garder à côté pendant le choix des rouages. *@

@if (!Catalog.Loaded || !L.Loaded)
{
    <p class="loading">@(L.Loaded ? L.Ui("app.loading") : "…")</p>
}
else
{
    <EquipmentPanel />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnLanguageChanged;
        await L.EnsureLoadedAsync();
        await Catalog.EnsureLoadedAsync();
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnLanguageChanged;
}
