@page "/play"
@namespace Olomoc.Builder.Pages
@implements IDisposable
@inject CatalogService Catalog
@inject LocalizationService L
@inject GameStore Games
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (!_ready)
{
    <p class="loading">@(L.Loaded ? L.Ui("app.loading") : "…")</p>
}
else if (Games.Session is not { } game)
{
    <section class="play-empty">
        <p class="empty">@L.Ui("play.none")</p>
        <a class="btn" href="">@L.Ui("play.toBuilder")</a>
    </section>
}
else
{
    var s = game.State;
    <section class="play-bar">
        <div class="play-ident">
            <a class="play-back" href="" title="@L.Ui("play.toBuilder")">←</a>
            <div class="play-names">
                <span class="play-name">@(s.Name ?? L.Ui("play.unnamed"))</span>
                @if (s.Faction is { } f)
                {
                    <span class="play-faction">@L.FactionName(f)</span>
                }
            </div>
        </div>

        <div class="play-counters">
            <div class="counter">
                <span class="counter-label">@L.Ui("play.cycle")</span>
                <span class="counter-value">@Math.Min(s.Cycle, GameSession.Cycles)<small>/@GameSession.Cycles</small></span>
            </div>
            <div class="counter bile @(game.IsLost ? "lost" : null)">
                <span class="counter-label">@L.Ui("play.bile")</span>
                <span class="counter-track">
                    <button class="step" @onclick="() => Act(() => game.AdjustBile(-1))" disabled="@(s.Bile == 0)" aria-label="@L.Ui("play.bile") −">−</button>
                    <TokenTrack Token="darkness" Count="s.Bile" Max="GameSession.MaxBile" />
                    <button class="step" @onclick="() => Act(() => game.AdjustBile(1))" disabled="@(s.Bile >= GameSession.MaxBile)" aria-label="@L.Ui("play.bile") +">+</button>
                </span>
            </div>
            <div class="counter hunt @(game.IsHunted ? "lost" : null)" title="@L.Ui("play.hunt.title")">
                <span class="counter-label">@L.Ui("play.hunt")</span>
                <span class="counter-track">
                    <button class="step" @onclick="() => Act(() => game.AdjustHunt(-1))" disabled="@(s.Hunt == 0)" aria-label="@L.Ui("play.hunt") −">−</button>
                    <TokenTrack Token="hunt" Count="s.Hunt" Max="GameSession.MaxHunt" />
                    <button class="step" @onclick="() => Act(() => game.AdjustHunt(1))" disabled="@(s.Hunt >= GameSession.MaxHunt)" aria-label="@L.Ui("play.hunt") +">+</button>
                </span>
            </div>
            <div class="counter vp" title="@L.Ui("play.vp.title")">
                <span class="counter-label">@L.Ui("play.vp")</span>
                <span class="counter-track">
                    <button class="step" @onclick="() => Act(() => game.AdjustVictoryPoints(-1))" disabled="@(s.VictoryPoints == 0)" aria-label="@L.Ui("play.vp") −">−</button>
                    <span class="counter-value vp-value">@s.VictoryPoints</span>
                    <button class="step" @onclick="() => Act(() => game.AdjustVictoryPoints(1))" aria-label="@L.Ui("play.vp") +">+</button>
                </span>
            </div>
        </div>

        <div class="play-commands">
            <button class="btn" @onclick="Undo" disabled="@(!game.CanUndo)" title="@L.Ui("play.undo.title")">↶ @L.Ui("play.undo")</button>
            @* Bouton de fin de cycle et messages de fin superposés dans une même case, à la taille du plus
               grand : passer de l'un à l'autre ne décale rien. Seul l'élément courant est visible. *@
            <div class="play-end">
                <button class="btn primary @OffUnless(!game.IsOver)" @onclick="EndCycle" title="@L.Ui("play.endCycle.title")"
                        disabled="@game.IsOver" aria-hidden="@game.IsOver">
                    @L.Ui(s.Cycle >= GameSession.Cycles ? "play.endGame" : "play.endCycle", s.Cycle)
                </button>
                <button class="btn primary off" disabled tabindex="-1" aria-hidden="true">@L.Ui("play.endGame", GameSession.Cycles)</button>
                @foreach (var key in OverKeys)
                {
                    var current = game.IsOver && key == OverKey(game);
                    <span class="play-over @(key == "play.lost" ? "lost" : null) @OffUnless(current)" title="@L.Ui(key)"
                          aria-hidden="@(!current)">@L.Ui(key + ".short")</span>
                }
            </div>
        </div>
    </section>

    <section class="play-cogs">
        @for (var i = 0; i < s.Cogs.Count; i++)
        {
            var slot = i;
            var cs = s.Cogs[slot];
            if (Catalog.CogById(cs.CogId) is not { } cog) continue;
            <PlayCogCard Session="game" Slot="slot" Cog="cog" OnChanged="ChangedAsync" />
        }
    </section>

    <section class="play-footer">
        <button class="btn danger" @onclick="AbandonAsync">@L.Ui("play.abandon")</button>
    </section>

    @if (_toast is not null)
    {
        <div class="toast" role="status" aria-live="polite" @key="_toastId" @onclick="() => _toast = null">
            <span>@_toast</span>
            @if (game.CanUndo)
            {
                <button class="btn small" @onclick="Undo" @onclick:stopPropagation="true">↶ @L.Ui("play.undo")</button>
            }
        </div>
    }
}

@code {
    private bool _ready;
    // Notification : compte rendu de la dernière action, effacé après quelques secondes ou au toucher.
    private const int ToastMilliseconds = 5000;
    private string? _toast;
    private int _toastId;

    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnLanguageChanged;
        await L.EnsureLoadedAsync();
        await Catalog.EnsureLoadedAsync();
        await Games.EnsureLoadedAsync();
        // Partie sauvegardée avec des cartes disparues du référentiel : inutilisable.
        if (Games.Session is { } g && g.State.Cogs.Any(c => Catalog.CogById(c.CogId) is null))
            await Games.ClearAsync();
        _wasOver = Games.Session?.IsOver ?? false;
        _ready = true;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnLanguageChanged;

    private bool _wasOver;                             // pour annoncer la fin de partie une seule fois

    private async Task ChangedAsync(string? message)
    {
        await Games.SaveAsync();
        var game = Games.Session!;
        if (game.IsOver && !_wasOver)
            message = (message is null ? "" : message + " ") + L.Ui(OverKey(game));
        _wasOver = game.IsOver;
        Toast(message);
    }

    // Fiel à 3 (défaite) avant traque à 3, avant fin du cycle 4 (LDR p.17, p.36).
    private static string OverKey(GameSession g) =>
        g.IsLost ? "play.lost" : g.IsHunted ? "play.hunted" : "play.finished";

    private static readonly string[] OverKeys = { "play.lost", "play.hunted", "play.finished" };

    private static string? OffUnless(bool visible) => visible ? null : "off";

    private Task Act(Action action)
    {
        action();
        return ChangedAsync(null);
    }

    private void Toast(string? message)
    {
        var id = ++_toastId;
        _toast = message;
        if (message is null) return;
        _ = Task.Delay(ToastMilliseconds).ContinueWith(_ => InvokeAsync(() =>
        {
            if (_toastId != id) return;
            _toast = null;
            StateHasChanged();
        }));
    }

    private async Task Undo()
    {
        Games.Session!.Undo();
        _wasOver = Games.Session.IsOver;
        await Games.SaveAsync();
        Toast(null);
    }

    private async Task EndCycle()
    {
        var game = Games.Session!;
        var cycle = game.State.Cycle;
        var bile = game.EndCycle();
        await ChangedAsync(L.Ui("play.cycleEnded", cycle, bile));
    }

    private async Task AbandonAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", L.Ui("play.abandon.confirm"))) return;
        await Games.ClearAsync();
        Nav.NavigateTo("");
    }
}
