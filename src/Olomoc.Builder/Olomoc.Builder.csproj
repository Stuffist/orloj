<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Constructeur de cabales, mode partie, compte et éditeur du référentiel : pages sous
       /builder/…, réunies avec les tournois dans l'app Olomoc.Web. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Olomoc.Builder</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Olomoc.Shared\Olomoc.Shared.csproj" />
    <!-- Page Partie : cadre « Jouer en ligne » (créer un salon, parties suivies). -->
    <ProjectReference Include="..\Olomoc.Online\Olomoc.Online.csproj" />
  </ItemGroup>

</Project>
