<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Cabal builder, play mode, account, card catalog editor and admin panel: pages under
       /builder/…, brought together with the tournaments in the Olomoc.Web app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Olomoc.Builder</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Olomoc.Shared\Olomoc.Shared.csproj" />
    <!-- Play page: "Play online" box (create a lobby, followed games). -->
    <ProjectReference Include="..\Olomoc.Online\Olomoc.Online.csproj" />
  </ItemGroup>

</Project>
