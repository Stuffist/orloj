<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.JSInterop" Version="8.0.8" />
  </ItemGroup>

  <!-- La logique de l'app (modèles et services, sans Blazor) est compilée ici telle quelle :
       pas de référence au projet WebAssembly. Les données sont lues dans ../../wwwroot. -->
  <ItemGroup>
    <Compile Include="..\..\Models\**\*.cs" Link="App\Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Services\**\*.cs" Link="App\Services\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
